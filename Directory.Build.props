<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>

  <!-- TIPC001: DLL search path analyzer — applies to all projects except the analyzer itself -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers\ThisIsMyPC.Analyzers\ThisIsMyPC.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
