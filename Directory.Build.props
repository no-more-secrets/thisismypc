<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This product ships only as win-x64. Keep that runtime graph in every lock file. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Commit the resolved dependency graph and refuse drift in every Release restore. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(Configuration)' == 'Release'">true</RestoreLockedMode>
    <!-- Recommended, not all: the full set floods every build with CA1062/CA1031/CA2007 noise. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Publisher identity in exe version resources. Company is the short form used on the MSI publisher line; Copyright names the legal entity. -->
    <Company>NMS</Company>
    <Authors>NMS</Authors>
    <Product>ThisIsMyPC</Product>
    <Copyright>Copyright (c) 2026 No More Secrets, LLC. GPLv2.</Copyright>
    <!-- Version resource: English (United States) instead of Language Neutral,
         and a product version without the +commit suffix the SDK appends. -->
    <NeutralLanguage>en-US</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- TIPC001: DLL search path analyzer — applies to all projects except the analyzer itself -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers\ThisIsMyPC.Analyzers\ThisIsMyPC.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
