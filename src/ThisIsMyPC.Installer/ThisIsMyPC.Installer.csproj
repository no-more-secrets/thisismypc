<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The download is one file with a plain name; the assembly name is that name. -->
    <AssemblyName>ThisIsMyPC-Installer</AssemblyName>
    <RootNamespace>ThisIsMyPC.Installer</RootNamespace>
    <AssemblyTitle>ThisIsMyPC Installer</AssemblyTitle>
    <!-- The version resource copies the IL module name into OriginalFilename.
         Compile the IL as .exe (no apphost; NativeAOT emits the real exe) so
         the file properties read ThisIsMyPC-Installer.exe, not .dll. -->
    <UseAppHost>false</UseAppHost>
    <TargetExt>.exe</TargetExt>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\ThisIsMyPC.App\Assets\ThisIsMyPC.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- LibraryImport (the pre-Avalonia message box in NativeBootstrap) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1515: Avalonia XAML requires public types for views/viewmodels -->
    <NoWarn>CA1515</NoWarn>
    <!-- The release script always publishes the installer NativeAOT (one small
         native exe around the MSI); dev builds stay CoreCLR unless asked. -->
    <PublishAot Condition="'$(AotPublish)' == 'true'">true</PublishAot>
    <ControlFlowGuard Condition="'$(AotPublish)' == 'true'">Guard</ControlFlowGuard>
  </PropertyGroup>

  <ItemGroup>
    <!-- Palette and type are the App's own files, linked, so the installer
         cannot drift from the app it installs. -->
    <AvaloniaResource Include="..\ThisIsMyPC.App\Styles\Theme.axaml" Link="Styles\Theme.axaml" />
    <AvaloniaResource Include="..\ThisIsMyPC.App\Assets\ThisIsMyPC.ico" Link="Assets\ThisIsMyPC.ico" />
    <AvaloniaResource Include="..\ThisIsMyPC.App\Assets\Fonts\IBMPlexSans-Regular.ttf" Link="Assets\Fonts\IBMPlexSans-Regular.ttf" />
    <AvaloniaResource Include="..\ThisIsMyPC.App\Assets\Fonts\IBMPlexSans-SemiBold.ttf" Link="Assets\Fonts\IBMPlexSans-SemiBold.ttf" />
    <AvaloniaResource Include="..\ThisIsMyPC.App\Assets\Fonts\IBMPlexSans-Bold.ttf" Link="Assets\Fonts\IBMPlexSans-Bold.ttf" />
    <AvaloniaResource Include="..\ThisIsMyPC.App\Assets\Fonts\IBMPlexMono-Regular.ttf" Link="Assets\Fonts\IBMPlexMono-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The license page shows the repo LICENSE verbatim. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
  </ItemGroup>

  <!-- Release publish only: the two native libraries NativeAOT cannot fold
       into the launcher ride inside it as resources. NativeBootstrap unpacks
       and loads them. The MSI is appended after publish, not embedded here.
       Dev builds keep the DLLs beside the exe. -->
  <!-- BeforeTargets on AssignTargetPaths, the first consumer of EmbeddedResource:
       a later hook (PrepareResourceNames) runs after that target's own
       dependencies have already split the resource list. -->
  <Target Name="EmbedNativeLibraries" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolvePackageAssets"
          Condition="'$(BundleNativeLibraries)' == 'true'">
    <ItemGroup>
      <_InstallerNativeLibrary Include="@(NativeCopyLocalItems)"
          Condition="'%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp'" />
      <EmbeddedResource Include="@(_InstallerNativeLibrary)" LogicalName="native/%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="@(_InstallerNativeLibrary->Count()) != 2"
           Text="Expected libSkiaSharp.dll and libHarfBuzzSharp.dll among the native package assets; found @(_InstallerNativeLibrary->Count())." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Avalonia adds optional build telemetry transitively. Keep the package
         assetless so its task and collector are never imported or executed. -->
    <PackageReference Include="Avalonia.BuildServices" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThisIsMyPC.Core\ThisIsMyPC.Core.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Interop.Win32\ThisIsMyPC.Interop.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThisIsMyPC.App.UiTests" />
    <InternalsVisibleTo Include="ThisIsMyPC.Installer.Tests" />
  </ItemGroup>
</Project>
