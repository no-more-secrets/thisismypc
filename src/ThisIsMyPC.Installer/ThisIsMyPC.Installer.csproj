<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The download is one file with a plain name; the assembly name is that name. -->
    <AssemblyName>ThisIsMyPC-Installer</AssemblyName>
    <RootNamespace>ThisIsMyPC.Installer</RootNamespace>
    <AssemblyTitle>ThisIsMyPC Installer</AssemblyTitle>
    <!-- The version resource copies the IL module name into OriginalFilename.
         Compile the IL as .exe (no apphost; NativeAOT emits the real exe) so
         the file properties read ThisIsMyPC-Installer.exe, not .dll. -->
    <UseAppHost>false</UseAppHost>
    <TargetExt>.exe</TargetExt>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\ThisIsMyPC.App\Assets\ThisIsMyPC.ico</ApplicationIcon>
    <!-- Win32 callbacks and source-generated interop use unmanaged pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The release script always publishes the installer NativeAOT. -->
    <PublishAot Condition="'$(AotPublish)' == 'true'">true</PublishAot>
    <ControlFlowGuard Condition="'$(AotPublish)' == 'true'">Guard</ControlFlowGuard>
    <DefineConstants Condition="'$(DynamicCodeGuard)' == 'true'">$(DefineConstants);ACG_ENABLED</DefineConstants>
    <OptimizationPreference Condition="'$(AotPublish)' == 'true'">Size</OptimizationPreference>
    <InvariantGlobalization Condition="'$(AotPublish)' == 'true'">true</InvariantGlobalization>
    <EventSourceSupport Condition="'$(AotPublish)' == 'true'">false</EventSourceSupport>
  </PropertyGroup>

  <Target Name="ValidateDynamicCodeGuardBuild" BeforeTargets="PrepareForBuild"
          Condition="'$(DynamicCodeGuard)' == 'true' and '$(AotPublish)' != 'true'">
    <Error Text="DynamicCodeGuard requires AotPublish=true." />
  </Target>

  <!-- Core exposes the shared settings types, but the installer never opens the SQLite database. -->
  <Target Name="RemoveUnusedInstallerNativeAssets" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'e_sqlite3.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The license page shows the repo LICENSE verbatim. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThisIsMyPC.Core\ThisIsMyPC.Core.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Interop.Win32\ThisIsMyPC.Interop.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThisIsMyPC.App.UiTests" />
    <InternalsVisibleTo Include="ThisIsMyPC.Installer.Tests" />
  </ItemGroup>
</Project>
