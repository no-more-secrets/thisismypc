<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThisIsMyPC.Installer.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ThisIsMyPC-Install/Styles/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="BodyFont">avares://ThisIsMyPC-Install/Assets/Fonts#IBM Plex Sans</FontFamily>
            <FontFamily x:Key="MonoFont">avares://ThisIsMyPC-Install/Assets/Fonts#IBM Plex Mono</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
