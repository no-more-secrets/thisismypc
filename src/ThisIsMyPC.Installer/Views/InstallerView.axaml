<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.Installer.ViewModels"
             x:Class="ThisIsMyPC.Installer.Views.InstallerView"
             x:DataType="vm:InstallerViewModel"
             FontFamily="{StaticResource BodyFont}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <!-- Welcome page: larger, plainer text than the other pages. -->
        <Style Selector="TextBlock.welcome">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.lead">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.danger">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Tab strip: the app's look (Controls.axaml zeroes the stock
             padding; Theme.axaml colors the selected pipe). -->
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TabItem TextBlock.tab">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <!-- Every page card fills the content area exactly, whatever the page holds. -->
        <Style Selector="Border.page">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <!-- Filled buttons carry a rim in their own family (AccentOutline,
             DangerOutline), the ring Theme.axaml gives accent-filled controls.
             Hover and press restate the rim on the presenter, or Fluent swaps
             in its grey hover border while only the fill changes. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerOutlineBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerOutlineBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Button.footer">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="32,16,32,20">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="0" Margin="0,0,0,8">
            <TextBlock Classes="title" Text="ThisIsMyPC" />
            <TextBlock Classes="caption" Text="{Binding AppVersion, StringFormat='Installer Version {0}'}" />
        </StackPanel>

        <!-- Tab strip plus pages. Tabs a person can click follow the same
             rules as the buttons; Install and Remove are reached by the
             buttons and only show where you are. -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding TabIndex, Mode=TwoWay}"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">

            <TabItem IsEnabled="{Binding CanOpenWelcome}">
                <TabItem.Header>
                    <TextBlock Classes="tab" Text="Welcome" />
                </TabItem.Header>
                <Border Classes="page">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <TextBlock Grid.Row="0" Classes="welcome" Text="Welcome to the installer for ThisIsMyPC." />
                        <TextBlock Grid.Row="1" Classes="lead" Margin="0,14,0,0"
                                   Text="This program will be installed for everybody who uses this PC. This app has administrator permissions." />
                        <Border Grid.Row="2" Margin="0,20,0,0" IsVisible="{Binding IsInstalled}" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <TextBlock Grid.Column="0" Classes="body" VerticalAlignment="Center" Text="{Binding InstalledSummary}" />
                                <Button Grid.Column="1" Classes="footer" VerticalAlignment="Center" Content="Uninstall"
                                        Command="{Binding UninstallCommand}" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="4" Classes="lead" HorizontalAlignment="Right" IsVisible="{Binding !InstallBlockedByNewer}"
                                   Text="Click &quot;Next&quot; to read the license." />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem IsEnabled="{Binding CanOpenLicense}">
                <TabItem.Header>
                    <TextBlock Classes="tab" Text="License" />
                </TabItem.Header>
                <Border Classes="page">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Classes="body" Margin="0,0,0,12"
                                   Text="ThisIsMyPC is free software under the GNU General Public License, version 2. You may use it, share it, and change it under these terms." />
                        <!-- The GPL text centres its own headings with spaces for a
                             ~70-column line, so the block, not the lines, is centred
                             in the box; a TextBox would pin it to the left edge. -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                <SelectableTextBlock Text="{Binding LicenseText, Mode=OneWay}" HorizontalAlignment="Center"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="14"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                            </ScrollViewer>
                        </Border>
                        <CheckBox Grid.Row="2" Margin="0,12,0,0" IsChecked="{Binding LicenseAccepted}"
                                  Content="I accept the terms of the GNU General Public License, version 2" />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem IsEnabled="{Binding CanOpenOptions}">
                <TabItem.Header>
                    <TextBlock Classes="tab" Text="Options" />
                </TabItem.Header>
                <Border Classes="page">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="label" Text="Install folder" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding InstallFolder}" IsEnabled="{Binding CanChooseFolder}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse..." Command="{Binding BrowseCommand}"
                                    IsEnabled="{Binding CanChooseFolder}" />
                        </Grid>
                        <TextBlock Classes="caption" IsVisible="{Binding !CanChooseFolder}" Text="Updates go into the folder the app is already in." />
                        <TextBlock Classes="danger" IsVisible="{Binding HasFolderError}" Text="{Binding FolderError}" />
                        <TextBlock Classes="warning" IsVisible="{Binding HasFolderWarning}" Text="{Binding FolderWarning}" />

                        <TextBlock Classes="label" Margin="0,14,0,0" Text="Shortcuts" />
                        <CheckBox IsChecked="{Binding StartMenuShortcut}" Content="Add ThisIsMyPC to the Start menu" />
                        <CheckBox IsChecked="{Binding DesktopShortcut}" Content="Add a shortcut on the Desktop" />

                        <TextBlock Classes="label" Margin="0,14,0,0" Text="Behavior" />
                        <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start with Windows, in the tray" />
                        <CheckBox IsChecked="{Binding CheckForUpdates}" Content="Check for updates automatically" />
                        <TextBlock Classes="caption" Margin="28,-6,0,0" Text="Both can be changed later in Settings inside the app." />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem IsEnabled="{Binding IsInInstallTab}">
                <TabItem.Header>
                    <TextBlock Classes="tab" Text="Install" />
                </TabItem.Header>
                <Border Classes="page">
                    <Panel>
                        <StackPanel IsVisible="{Binding IsInstalling}" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Classes="body" HorizontalAlignment="Center" Text="{Binding StatusText}" />
                            <ProgressBar IsIndeterminate="True" Height="6" Width="360"
                                         Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Classes="caption" HorizontalAlignment="Center" Text="This takes under a minute." />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsDone}" Spacing="14">
                            <StackPanel IsVisible="{Binding DoneInstalled}" Spacing="14">
                                <TextBlock Classes="body" Text="ThisIsMyPC is installed. You will find it in the Start menu. It asks for permission every time it starts, because everything it does needs administrator rights." />
                                <TextBlock Classes="warning" IsVisible="{Binding RebootRequired}"
                                           Text="Windows asked for a restart to finish. Restart when convenient." />
                                <CheckBox IsChecked="{Binding LaunchWhenDone}" Content="Open ThisIsMyPC when I click Finish" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding Failed}" Spacing="14">
                                <TextBlock Classes="danger" Text="{Binding ErrorText}" />
                                <TextBlock Classes="caption" IsVisible="{Binding HasLogPath}" TextWrapping="Wrap"
                                           Text="{Binding LogPath, StringFormat='Details were saved to {0}'}" />
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </Border>
            </TabItem>

            <TabItem IsEnabled="{Binding IsInRemoveTab}" IsVisible="{Binding ShowRemoveTab}">
                <TabItem.Header>
                    <TextBlock Classes="tab" Text="Remove" />
                </TabItem.Header>
                <Border Classes="page">
                    <Panel>
                        <StackPanel IsVisible="{Binding IsConfirmUninstall}" Spacing="14">
                            <TextBlock Classes="body" Text="Remove ThisIsMyPC from this PC? The app, its shortcuts, and its entry in Installed apps go away." />
                            <TextBlock Classes="body" Text="Your settings and change history stay in the ProgramData folder, so a later install picks them up. Changes you applied to Windows stay as they are; undo them in the app first if you want them reverted." />
                            <TextBlock Classes="caption" Text="Click Remove to continue, or Back to keep it." />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsUninstalling}" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Classes="body" HorizontalAlignment="Center" Text="{Binding StatusText}" />
                            <ProgressBar IsIndeterminate="True" Height="6" Width="360"
                                         Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsDone}" Spacing="14">
                            <TextBlock Classes="body" IsVisible="{Binding !Failed}" Text="ThisIsMyPC was removed. Your settings and change history are still in the ProgramData folder in case you install it again." />
                            <TextBlock Classes="danger" IsVisible="{Binding Failed}" Text="{Binding ErrorText}" />
                        </StackPanel>
                    </Panel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Footer: Back and Next as a pair, a gap, Cancel on the far right. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,20,0,0">
            <Button Grid.Column="1" Classes="footer" Margin="0,0,10,0" Content="&lt; Back " Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}" />
            <Button Grid.Column="2" Classes="footer primary" Content="{Binding PrimaryButtonText}"
                    Command="{Binding PrimaryCommand}" IsDefault="True" />
            <Button Grid.Column="3" Classes="footer danger" Margin="32,0,0,0" Content="Cancel" Command="{Binding CancelCommand}"
                    IsVisible="{Binding CanCancel}" />
        </Grid>
    </Grid>
</UserControl>
