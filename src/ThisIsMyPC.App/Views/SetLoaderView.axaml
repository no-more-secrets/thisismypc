<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:icons="using:ThisIsMyPC.App.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.SetLoaderView"
             x:DataType="vm:SetLoaderViewModel">

    <UserControl.Styles>
        <!-- A preset card is a button whose only paint is the inner card
             body: the stock button hover and press washes stay off the
             square presenter, or they would peek past the rounded card. -->
        <Style Selector="Button.set-card">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Button.set-card /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.set-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.set-card:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- The card body wears the shared clickable states: Surface at
             rest, the control hover wash and strong outline under the
             pointer, the pressed tint on click, and the same active tint
             and accent ring the sidebar and dropdown rows use when chosen.
             A chosen card keeps its tint under the pointer. -->
        <Style Selector="Border.set-card-body">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Button.set-card:pointerover Border.set-card-body">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}" />
        </Style>
        <Style Selector="Button.set-card:pressed Border.set-card-body">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
        </Style>
        <Style Selector="Border.set-card-body.selected">
            <Setter Property="Background" Value="{DynamicResource SidebarItemActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
        </Style>
        <Style Selector="Button.set-card:pointerover Border.set-card-body.selected">
            <Setter Property="Background" Value="{DynamicResource SidebarItemActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
        </Style>
        <Style Selector="Button.set-card:pressed Border.set-card-body.selected">
            <Setter Property="Background" Value="{DynamicResource SidebarItemActiveBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SetPreviewGroupViewModel">
            <TextBlock Text="{Binding GroupName}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,6" />
        </DataTemplate>
        <DataTemplate DataType="vm:SetEntryPreviewViewModel">
            <Border Classes="preset-change" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1"
                    Padding="0,8" ToolTip.Tip="{Binding DetailsTooltip}">
                <Grid ColumnDefinitions="Auto,*">
                    <CheckBox IsChecked="{Binding IsIncluded}" IsEnabled="{Binding CanToggle}"
                              Margin="0,0,8,0" VerticalAlignment="Top"
                              AutomationProperties.Name="{Binding SettingName, StringFormat='Include {0}'}"
                              ToolTip.Tip="Include this change when staging" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <Button Classes="card-link" Command="{Binding OpenSettingCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                ToolTip.Tip="{Binding Entry.ModuleId, StringFormat='Open in {0}'}">
                            <TextBlock Text="{Binding SettingName}" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding !IsSkipped}">
                            <TextBlock Text="{Binding ValuesSummary}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Applied" FontSize="11" Margin="12,0,0,0"
                                       Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsApplied}" />
                            <TextBlock Grid.Column="2" Text="Staged" FontSize="11" Margin="12,0,0,0"
                                       Foreground="{DynamicResource InfoBrush}" IsVisible="{Binding IsAlreadyStaged}" />
                        </Grid>
                        <TextBlock Text="{Binding SkipReason}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsSkipped}" />
                        <TextBlock Text="{Binding ConflictText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding HasConflict}" />
                        <TextBlock Text="{Binding SkuNotice}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource InfoBrush}" IsVisible="{Binding HasSkuNotice}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Resources>
        <DataTemplate x:Key="SetCardTemplate" x:DataType="vm:SetItemViewModel">
            <Button Classes="set-card"
                    Command="{Binding $parent[UserControl].((vm:SetLoaderViewModel)DataContext).SelectSetCommand}"
                    CommandParameter="{Binding}">
                <Border Classes="set-card-body" Classes.selected="{Binding IsSelected}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding MetaLine}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding Author, StringFormat='by {0}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="PresetContent" x:DataType="vm:SetLoaderViewModel">
            <Grid ColumnDefinitions="260,16,*" Margin="0,0,16,0">
                <Border x:Name="PresetBrowser" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <Panel>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CurrentSets}" ItemTemplate="{StaticResource SetCardTemplate}"
                                          Margin="0,0,16,0" />
                        </ScrollViewer>
                        <TextBlock Text="No presets in this category" IsVisible="{Binding HasNoCategorySets}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Panel>
                </Border>
                <Border x:Name="PresetDetails" Grid.Column="2" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <Panel>
                        <TextBlock Text="Select a preset to preview its changes" IsVisible="{Binding HasNoSelection}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding !HasNoSelection}">
                            <TextBlock Text="{Binding SelectedSet.Name}" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,16,10"
                                       ToolTip.Tip="{Binding SelectedSet.Description}" />
                            <TextBox Grid.Row="1" x:Name="PresetSearch" Text="{Binding SearchText, Mode=TwoWay}"
                                     Watermark="Search changes" Margin="0,0,16,8" />
                            <Panel Grid.Row="2">
                                <ListBox x:Name="PresetChanges" ItemsSource="{Binding VisibleRows}" Background="Transparent"
                                         BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,16,0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                                <TextBlock Text="No matching changes" IsVisible="{Binding HasNoSearchResults}"
                                           Margin="0,12,16,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Panel>
                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,16,0">
                                <TextBlock Text="{Binding StageMessage}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" />
                                <Button Grid.Column="1" Classes="apply-bar-apply" Content="{Binding StageButtonText}"
                                        Command="{Binding StageIncludedCommand}" IsEnabled="{Binding HasIncludedEntries}" />
                            </Grid>
                        </Grid>
                    </Panel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl Theme="{StaticResource EdgeTabControlTheme}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="Tweaks">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PresetContent}" />
        </TabItem>
        <TabItem Header="Packs">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PresetContent}" />
        </TabItem>
    </TabControl>
</UserControl>
