<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.SetLoaderView"
             x:DataType="vm:SetLoaderViewModel">

    <UserControl.Styles>
        <Style Selector="Button.set-card">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.set-card-body">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.set-card-body.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="SetCardTemplate" x:DataType="vm:SetItemViewModel">
            <Button Classes="set-card"
                    Command="{Binding $parent[UserControl].((vm:SetLoaderViewModel)DataContext).SelectSetCommand}"
                    CommandParameter="{Binding}">
                <Border Classes="set-card-body" Classes.selected="{Binding IsSelected}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding MetaLine}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding Author, StringFormat='by {0}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="320,24,*">

        <!-- Set browser -->
        <ScrollViewer Grid.Column="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="No presets found. Built-in presets ship with the application; your own go in %APPDATA%\ThisIsMyPC\sets."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           IsVisible="{Binding HasNoSets}" />

                <StackPanel IsVisible="{Binding HasTweakSets}" Spacing="4" Margin="0,0,0,12">
                    <TextBlock Text="TWEAK SETS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding TweakSets}"
                                  ItemTemplate="{StaticResource SetCardTemplate}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding HasOptimizationPacks}" Spacing="4">
                    <TextBlock Text="OPTIMIZATION PACKS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding OptimizationPacks}"
                                  ItemTemplate="{StaticResource SetCardTemplate}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Preview -->
        <Panel Grid.Column="2">
            <StackPanel IsVisible="{Binding HasNoSelection}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="Select a preset to preview its changes"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="Every change is shown with its current system value before anything is staged"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>

            <DockPanel IsVisible="{Binding !HasNoSelection}">

                <!-- Stage footer -->
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource RaisedBrush}"
                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,10"
                        CornerRadius="8"
                        Margin="0,12,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Classes="apply-bar-apply"
                                Content="{Binding StageButtonText}"
                                Command="{Binding StageIncludedCommand}"
                                IsEnabled="{Binding HasIncludedEntries}" />
                        <TextBlock Text="{Binding StageMessage}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SuccessBrush}" />
                    </DockPanel>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PreviewGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SetPreviewGroupViewModel">
                            <StackPanel Spacing="6" Margin="0,0,0,16">
                                <TextBlock Text="{Binding GroupName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           IsVisible="{Binding HasHeader}" />
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SetEntryPreviewViewModel">
                                            <Border Background="{DynamicResource RaisedBrush}"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,0,0,6"
                                                    ToolTip.Tip="{Binding RawValuesTooltip}">
                                                <DockPanel>
                                                    <!-- Include checkbox -->
                                                    <CheckBox DockPanel.Dock="Left"
                                                              IsChecked="{Binding IsIncluded}"
                                                              VerticalAlignment="Top"
                                                              Margin="0,0,10,0"
                                                              IsVisible="{Binding CanToggle}"
                                                              ToolTip.Tip="Include this change when staging" />

                                                    <!-- Current -> proposed -->
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Center"
                                                                Margin="16,0,0,0"
                                                                IsVisible="{Binding !IsSkipped}">
                                                        <TextBlock Text="{Binding CurrentDisplay}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="&#x2192;"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        <TextBlock Text="{Binding ProposedDisplay}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="already applied"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                   IsVisible="{Binding IsApplied}" />
                                                        <TextBlock Text="already staged"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource InfoBrush}"
                                                                   IsVisible="{Binding IsAlreadyStaged}" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding SettingName}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding SkipReason}"
                                                                   FontSize="12"
                                                                   FontStyle="Italic"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource WarningBrush}"
                                                                   IsVisible="{Binding IsSkipped}" />
                                                        <TextBlock Text="{Binding ConflictText}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource WarningBrush}"
                                                                   IsVisible="{Binding HasConflict}" />
                                                        <TextBlock Text="{Binding SkuNotice}"
                                                                   FontSize="12"
                                                                   FontStyle="Italic"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource InfoBrush}"
                                                                   IsVisible="{Binding HasSkuNotice}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Panel>
    </Grid>
</UserControl>
