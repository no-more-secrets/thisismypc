<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:views="using:ThisIsMyPC.App.Views"
             xmlns:icons="using:ThisIsMyPC.App.Icons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ThisIsMyPC.App.Views.HardwareTabView"
             x:DataType="vm:HardwareTabViewModel">

    <!-- One page shape for every companion-backed Hardware tab: a status
         card (badge, explanation, the one companion button), the controls
         area when the decision allows it, and a closed Details expander with
         the evidence. Untabbed page: the scroller keeps the 16px lane. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <Style Selector="Border.status-badge">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.status-badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.status-badge.available">
            <Setter Property="Background" Value="{DynamicResource SuccessMutedBrush}" />
        </Style>
        <Style Selector="Border.status-badge.available TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.status-badge.unavailable">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        </Style>
        <Style Selector="Border.status-badge.unavailable TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Border.status-badge.unknown">
            <Setter Property="Background" Value="{DynamicResource InfoMutedBrush}" />
        </Style>
        <Style Selector="Border.status-badge.unknown TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
        </Style>
        <Style Selector="Border.status-badge.pending">
            <Setter Property="Background" Value="{DynamicResource WarningMutedBrush}" />
        </Style>
        <Style Selector="Border.status-badge.pending TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.status-badge.conflict">
            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
        </Style>
        <Style Selector="Border.status-badge.conflict TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.detail-line">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.row-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.row-value">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- Lighting: one card per device, in the Display page's register:
             rows of label, bare control, plain value; no boxes inside the card. -->
        <DataTemplate DataType="{x:Type vm:LightingControlsViewModel}">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Status}"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <!-- Greyed out, not hidden, while the decision forbids writes (the Advanced override). -->
                <ItemsControl ItemsSource="{Binding Devices}" IsEnabled="{Binding WritesAllowed}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LightingDeviceViewModel}">
            <Border Classes="card" CornerRadius="8" Padding="20,16" MinWidth="560">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                            <icons:FluentIcon Width="24" Height="24" VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Symbol="Lightbulb" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding ToggleSettingsCommand}"
                              AutomationProperties.Name="{Binding SettingsLabel}" ToolTip.Tip="Device settings"
                              VerticalAlignment="Top" Padding="6">
                          <icons:FluentIcon Symbol="Settings" Width="20" Height="20" />
                      </Button>
                    </Grid>

                    <StackPanel IsVisible="{Binding SettingsOpen}" Spacing="8" IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="Device settings" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasSaveSetting}">
                            <ToggleSwitch IsChecked="{Binding SaveToDevice}" AutomationProperties.Name="Save to device"
                                          OnContent="{x:Null}" OffContent="{x:Null}" Margin="0,-4" />
                            <TextBlock Text="Save to device" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PersistenceDescription}" TextWrapping="Wrap" Classes="detail-line" />
                        <TextBlock Text="{Binding DeviceLocation}" TextWrapping="Wrap" Classes="detail-line"
                                   IsVisible="{Binding DeviceLocation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding DeviceVersion}" TextWrapping="Wrap" Classes="detail-line"
                                   IsVisible="{Binding DeviceVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">

                    <Grid ColumnDefinitions="128,*" MinHeight="32">
                        <TextBlock Classes="row-label" Text="Mode" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Modes}"
                                  SelectedItem="{Binding SelectedMode}"
                                  DisplayMemberBinding="{Binding Name}" />
                    </Grid>

                    <Grid ColumnDefinitions="128,*,Auto" MinHeight="32" IsVisible="{Binding HasBrightness}">
                        <TextBlock Classes="row-label" Text="Brightness" />
                        <Slider Grid.Column="1" Minimum="{Binding BrightnessMin}" Maximum="{Binding BrightnessMax}"
                                Value="{Binding Brightness}" VerticalAlignment="Center"
                                TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="2" Classes="row-value" Text="{Binding Brightness, StringFormat={}{0:0}}" />
                    </Grid>

                    <Grid ColumnDefinitions="128,*,Auto" MinHeight="32" IsVisible="{Binding HasSpeed}">
                        <TextBlock Classes="row-label" Text="Speed" />
                        <Slider Grid.Column="1" Minimum="{Binding SpeedMin}" Maximum="{Binding SpeedMax}"
                                Value="{Binding Speed}" VerticalAlignment="Center"
                                TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="2" Classes="row-value" Text="{Binding Speed, StringFormat={}{0:0}}" />
                    </Grid>

                    <Grid ColumnDefinitions="128,*" MinHeight="32" IsVisible="{Binding HasDirection}">
                        <TextBlock Classes="row-label" Text="Direction" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Directions}"
                                  SelectedItem="{Binding SelectedDirection}"
                                  DisplayMemberBinding="{Binding Label}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasRandomColor}">
                        <ToggleSwitch IsChecked="{Binding RandomColors}" OnContent="{x:Null}" OffContent="{x:Null}" Margin="0,-4" />
                        <TextBlock Text="Use random colors" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Colors}" IsVisible="{Binding HasColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="12,5" />
                        <TextBlock Text="{Binding ApplyStatus}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsVisible="{Binding ApplyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding LastError}" Classes="status-error"
                               FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding HasLastError}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The swatch opens the spectrum and palette; hex input remains available. -->
        <DataTemplate DataType="{x:Type vm:ColorSlotViewModel}">
            <Grid ColumnDefinitions="128,Auto,84,*" ColumnSpacing="8" MinHeight="32">
                <TextBlock Classes="row-label" Text="{Binding Label}" TextWrapping="Wrap" />
                <ColorPicker Grid.Column="1" Color="{Binding SwatchColor, Mode=TwoWay}"
                             IsAlphaEnabled="False" IsAlphaVisible="False"
                             IsAccentColorsVisible="False" IsColorComponentsVisible="False"
                             AutomationProperties.Name="{Binding Label}" ToolTip.Tip="Choose a color"
                             VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Classes="plain-value" Text="{Binding Hex}"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         VerticalAlignment="Center" Width="84" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch" Spacing="10" Margin="0,4,16,24">

            <!-- Status card -->
            <Border Classes="card" CornerRadius="8" Padding="20,16" MinWidth="560">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Classes="status-badge"
                                Classes.available="{Binding IsAvailable}"
                                Classes.unavailable="{Binding IsUnavailable}"
                                Classes.unknown="{Binding IsUnknown}"
                                Classes.pending="{Binding IsPendingVerification}"
                                Classes.conflict="{Binding IsConflict}"
                                Margin="12,0,0,0">
                            <TextBlock Text="{Binding StatusLabel}" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding MachineLine}"
                                       FontWeight="SemiBold" FontSize="15"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding CheckedAt}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="Checking again..."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           IsVisible="{Binding IsRefreshing}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding Explanation}"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <ItemsControl ItemsSource="{Binding ConflictNotes}" IsVisible="{Binding HasConflictNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" Classes="status-warning"
                                           FontSize="12" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="4" IsVisible="{Binding HasAction}">
                        <Button Content="{Binding ActionLabel}"
                                Classes="accent"
                                Command="{Binding RunActionCommand}"
                                HorizontalAlignment="Left"
                                Padding="14,6" />
                        <TextBlock Text="{Binding ActionHint}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   IsVisible="{Binding HasActionHint}" />
                        <TextBlock Text="{Binding ActionMessage}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Classes.status-error="{Binding ActionFailed}"
                                   Classes.status-success="{Binding !ActionFailed}"
                                   IsVisible="{Binding ActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Controls area: only when the decision (or the override) shows it -->
            <StackPanel Spacing="10" IsVisible="{Binding ControlsVisible}">
                <TextBlock Text="Shown by the Advanced setting. Nothing here can write to hardware on this PC."
                           Classes="status-warning"
                           FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding IsOverrideShowingControls}" />
                <Border Classes="card" CornerRadius="8" Padding="20,16" MinWidth="560"
                        IsVisible="{Binding ShowsPlaceholder}">
                    <TextBlock Text="{Binding ControlsPlaceholder}"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <ContentControl Content="{Binding Lighting}" />
            </StackPanel>

            <ContentControl Content="{Binding Cooling}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:CoolingProfilesViewModel}">
                        <views:CoolingProfilesView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Details: closed by default -->
            <Expander IsExpanded="False" HorizontalAlignment="Stretch" MinWidth="560">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Details"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="what was checked and what it found"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="10" Margin="8,8,8,4">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Evidence" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Evidence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Classes="detail-line" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Detection notes" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding DetectionNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Classes="detail-line"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
