<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:network="using:ThisIsMyPC.Core.Network"
             x:Class="ThisIsMyPC.App.Views.NetworkView" x:DataType="vm:NetworkViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="Border.network-card"><Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12,8" /></Style>
        <Style Selector="Border.network-card.staged"><Setter Property="Background" Value="{DynamicResource SuccessMutedBrush}" /></Style>
        <Style Selector="Border.network-card Expander /template/ ToggleButton"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="Border.network-card Expander /template/ Border#ExpanderContent"><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="Border.network-card Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground, Border.network-card Expander /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.network-list"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" /></Style>
        <Style Selector="ListBox.network-list > ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,16,6" /><Setter Property="Focusable" Value="False" /></Style>
        <Style Selector="ListBox.network-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.network-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.network-list > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.network-list > ListBoxItem:selected"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:NetworkSettingRow">
            <Border Classes="network-card" Classes.staged="{Binding IsStaged}" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Classes="hint" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" AutomationProperties.Name="Enable firewall profile" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding Hint}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="network:FirewallRuleState">
            <Expander Header="{Binding Name}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="4" Margin="0,6">
                    <TextBlock Text="{Binding Application}" /><TextBlock Text="{Binding Service}" />
                    <WrapPanel><TextBlock Text="{Binding Direction}" Margin="0,0,12,0" /><TextBlock Text="{Binding Action}" Margin="0,0,12,0" /><TextBlock Text="{Binding Protocol}" /></WrapPanel>
                    <TextBlock Text="{Binding Enabled, StringFormat='Enabled: {0}'}" />
                    <TextBlock Text="{Binding Profiles, StringFormat='Networks: {0}'}" />
                    <TextBlock Text="{Binding LocalPorts, StringFormat='Local ports: {0}'}" /><TextBlock Text="{Binding RemotePorts, StringFormat='Remote ports: {0}'}" />
                    <TextBlock Text="{Binding LocalAddresses, StringFormat='Local addresses: {0}'}" /><TextBlock Text="{Binding RemoteAddresses, StringFormat='Remote addresses: {0}'}" />
                </StackPanel>
            </Expander>
        </DataTemplate>
    </UserControl.DataTemplates>
    <TabControl Theme="{StaticResource EdgeTabControlTheme}" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Connections">
            <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,16,8">
                    <TextBox Classes="filter" Watermark="Search all adapters" Text="{Binding AdapterSearch}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AdapterScopes}" SelectedIndex="{Binding AdapterScope}" MinWidth="150" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding AdapterError}" IsVisible="{Binding HasAdapterError}" Margin="0,0,16,8" />
                <TextBlock Grid.Row="2" Text="{Binding AdapterCount}" Classes="hint" Margin="0,0,16,8" />
                <ListBox Grid.Row="3" Classes="network-list" ItemsSource="{Binding VisibleAdapters}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:NetworkAdapterRow">
                        <Border Classes="network-card" Classes.staged="{Binding Connection.IsStaged}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Expander HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                    <Expander.Header><StackPanel Spacing="2"><TextBlock Text="{Binding State.Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Classes="hint" /></StackPanel></Expander.Header>
                                    <StackPanel><TextBlock Text="{Binding Details}" Margin="0,6" /><TextBlock Text="{Binding State.Error}" IsVisible="{Binding HasError}" Classes="hint" /></StackPanel>
                                </Expander>
                                <ToggleSwitch Grid.Column="1" AutomationProperties.Name="Enable adapter" IsChecked="{Binding Connection.Enabled, Mode=TwoWay}" IsEnabled="{Binding Connection.CanEdit}" ToolTip.Tip="{Binding Connection.Hint}" VerticalAlignment="Top" Margin="0,14,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Text="No matching adapters." IsVisible="{Binding NoAdapters}" IsHitTestVisible="False" />
            </Grid>
        </TabItem>
        <TabItem Header="DNS">
            <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,16,8">
                    <TextBox Classes="filter" Watermark="Search all adapters" Text="{Binding AdapterSearch}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AdapterScopes}" SelectedIndex="{Binding AdapterScope}" MinWidth="150" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding AdapterError}" IsVisible="{Binding HasAdapterError}" Margin="0,0,16,8" />
                <TextBlock Grid.Row="2" Text="{Binding AdapterCount}" Classes="hint" Margin="0,0,16,8" />
                <ListBox Grid.Row="3" Classes="network-list" ItemsSource="{Binding VisibleAdapters}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:NetworkAdapterRow">
                        <Border Classes="network-card" Classes.staged="{Binding Dns.IsStaged}">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding State.Name}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Dns.Current}" MaxWidth="260" /></Grid>
                                <TextBlock Text="{Binding EffectiveDns}" Classes="hint" />
                                <Expander Header="Edit DNS" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                    <StackPanel Spacing="6" Margin="0,6">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding Dns.DnsText}" Watermark="Automatic" IsEnabled="{Binding Dns.CanEdit}" MaxLength="2048" Classes.invalid="{Binding Dns.IsInvalid}" ToolTip.Tip="{Binding Dns.ValidationError}" />
                                            <Button Grid.Column="1" Content="Stage DNS" Command="{Binding Dns.SaveDnsCommand}" IsEnabled="{Binding Dns.CanEdit}" />
                                            <Button Grid.Column="2" Content="Revert" Command="{Binding Dns.DiscardCommand}" IsVisible="{Binding Dns.IsStaged}" IsEnabled="{Binding Dns.CanEdit}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Dns.Hint}" Classes="hint" />
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="{Binding State.Error}" IsVisible="{Binding HasError}" Classes="hint" />
                            </StackPanel>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Text="No matching adapters." IsVisible="{Binding NoAdapters}" IsHitTestVisible="False" />
            </Grid>
        </TabItem>
        <TabItem Header="Firewall">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,24">
                <TextBlock Text="{Binding FirewallError}" IsVisible="{Binding HasFirewallError}" Margin="0,0,16,8" />
                <Expander Grid.Row="1" Header="Firewall profiles" HorizontalAlignment="Stretch" Margin="0,0,16,8">
                    <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Profiles}" Margin="0,8,16,0" /></ScrollViewer>
                </Expander>
                <TextBox Grid.Row="2" Classes="filter" Watermark="Search all rules, applications, ports, and services" Text="{Binding RuleSearch}" Margin="0,0,16,8" />
                <TabControl Grid.Row="3" ItemsSource="{Binding RuleCategories}" SelectedIndex="{Binding RuleCategory}" IsVisible="{Binding IsBrowsingRules}" Margin="0,0,16,8">
                    <TabControl.ContentTemplate><DataTemplate><Panel /></DataTemplate></TabControl.ContentTemplate>
                </TabControl>
                <TextBlock Grid.Row="4" Text="{Binding RuleCount}" Classes="hint" Margin="0,0,16,8" />
                <ListBox Grid.Row="5" Classes="network-list" ItemsSource="{Binding RuleGroups}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:NetworkRuleGroup">
                        <Expander Header="{Binding Heading}" IsExpanded="{Binding Expanded, Mode=OneWay}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Identity}">
                            <StackPanel Spacing="4" Margin="0,6">
                                <TextBlock Text="{Binding Identity}" Classes="hint" />
                                <ListBox Classes="network-list" ItemsSource="{Binding Rules}" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="5" Text="No matching firewall rules." IsVisible="{Binding NoRules}" IsHitTestVisible="False" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
