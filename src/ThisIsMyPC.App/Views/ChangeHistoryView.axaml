<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.ChangeHistoryView"
             x:DataType="vm:ChangeHistoryViewModel">

    <Border Background="{StaticResource RaisedBrush}"
            BorderBrush="{StaticResource SidebarBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Width="450"
            MaxHeight="600"
            Padding="0">

        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top"
                    Padding="16,12"
                    BorderBrush="{StaticResource SidebarBorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding EntryCountText}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <Button Classes="apply-bar-discard"
                                Content="Cancel"
                                FontSize="11"
                                Padding="8,3"
                                Command="{Binding CancelClearCommand}"
                                IsVisible="{Binding IsConfirmingClear}" />
                        <Button Classes="apply-bar-discard"
                                FontSize="11"
                                Padding="8,3"
                                Command="{Binding ClearHistoryCommand}"
                                IsVisible="{Binding !!TotalGroupCount}">
                            <Button.Content>
                                <Panel>
                                    <TextBlock Text="Clear" IsVisible="{Binding !IsConfirmingClear}" />
                                    <TextBlock Text="Confirm Clear" IsVisible="{Binding IsConfirmingClear}"
                                               Foreground="{StaticResource DangerBrush}" />
                                </Panel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Change History"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Error message -->
            <Border DockPanel.Dock="Bottom"
                    Padding="16,8"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}" />
            </Border>

            <!-- Create Set from Selection (8.5) -->
            <Border DockPanel.Dock="Bottom"
                    Padding="16,10"
                    BorderBrush="{StaticResource SidebarBorderBrush}"
                    BorderThickness="0,1,0,0"
                    IsVisible="{Binding !!TotalGroupCount}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding SaveSetForm.SuccessMessage}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               IsVisible="{Binding SaveSetForm.SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Spacing="6" IsVisible="{Binding SaveSetForm.IsOpen}">
                        <TextBox Text="{Binding SaveSetForm.SetName}"
                                 Watermark="Set name"
                                 FontSize="12" />
                        <TextBox Text="{Binding SaveSetForm.SetDescription}"
                                 Watermark="What does this set do?"
                                 FontSize="12" />
                        <CheckBox IsChecked="{Binding SaveSetForm.IsOptimizationPack}"
                                  Content="Optimization pack (comprehensive bundle)"
                                  FontSize="12" />
                        <TextBlock Text="{Binding SaveSetForm.ErrorMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource DangerBrush}"
                                   IsVisible="{Binding SaveSetForm.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Left"
                                    Classes="apply-bar-discard"
                                    Content="Cancel"
                                    Command="{Binding SaveSetForm.CancelCommand}" />
                            <Button DockPanel.Dock="Right"
                                    Classes="apply-bar-apply"
                                    Content="Save Set"
                                    HorizontalAlignment="Right"
                                    Command="{Binding SaveSetForm.SaveCommand}" />
                        </DockPanel>
                    </StackPanel>

                    <Button Classes="apply-bar-discard"
                            Content="Create Set from Selection"
                            HorizontalAlignment="Right"
                            Command="{Binding SaveSetForm.OpenCommand}"
                            IsVisible="{Binding !SaveSetForm.IsOpen}"
                            IsEnabled="{Binding HasSelection}" />
                </StackPanel>
            </Border>

            <!-- Content -->
            <Panel>
                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !TotalGroupCount}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Margin="16">
                    <TextBlock Text="No changes recorded yet"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Changes applied through ThisIsMyPC will appear here."
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>

                <!-- Grouped history list -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding !!TotalGroupCount}">
                    <ItemsControl ItemsSource="{Binding HistoryGroups}" Margin="8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChangeHistoryGroupViewModel">
                                <StackPanel Margin="0,4">
                                    <!-- Date group header -->
                                    <TextBlock Text="{Binding DateHeader}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="4,8,0,4"
                                               LetterSpacing="0.5" />

                                    <!-- Batches in this date group -->
                                    <ItemsControl ItemsSource="{Binding Batches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HistoryBatchViewModel">
                                                <Border Margin="0,2"
                                                        Padding="12,8"
                                                        CornerRadius="4"
                                                        Opacity="{Binding IsReverted, Converter={x:Static vm:RevertedOpacityConverter.Instance}}"
                                                        Classes.pending-enable="{Binding IsEnableOrCreate}"
                                                        Classes.pending-disable="{Binding IsDisableOrDelete}"
                                                        Classes.pending-modify="{Binding IsModifyCategory}">
                                                    <DockPanel>
                                                        <!-- Selection for Create Set from Selection (8.5) -->
                                                        <CheckBox DockPanel.Dock="Left"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0"
                                                                  Padding="0"
                                                                  ToolTip.Tip="Include in a custom set" />

                                                        <!-- Restore/Redo button on batch row -->
                                                        <StackPanel DockPanel.Dock="Right"
                                                                    VerticalAlignment="Center"
                                                                    Margin="8,0,0,0">
                                                            <Button Classes="apply-bar-discard"
                                                                    Content="Restore"
                                                                    FontSize="11"
                                                                    Padding="8,4"
                                                                    IsVisible="{Binding !IsReverted}"
                                                                    Command="{Binding $parent[UserControl].((vm:ChangeHistoryViewModel)DataContext).RestoreCommand}"
                                                                    CommandParameter="{Binding PrimaryEntry}" />
                                                            <Button Classes="apply-bar-discard"
                                                                    Content="Redo"
                                                                    FontSize="11"
                                                                    Padding="8,4"
                                                                    IsVisible="{Binding IsReverted}"
                                                                    Command="{Binding $parent[UserControl].((vm:ChangeHistoryViewModel)DataContext).RedoCommand}"
                                                                    CommandParameter="{Binding PrimaryEntry}" />
                                                        </StackPanel>

                                                    <StackPanel Spacing="2">
                                                        <!-- Batch summary row -->
                                                        <DockPanel>
                                                            <!-- Time -->
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding AppliedAtDisplay}"
                                                                       FontSize="11"
                                                                       Margin="8,0,0,0"
                                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="Restored"
                                                                       FontSize="11"
                                                                       Margin="6,0,0,0"
                                                                       Foreground="{StaticResource WarningBrush}"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsReverted}" />

                                                            <!-- Display name — fills remaining space, ellipsis on overflow -->
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding DisplayName}" />
                                                        </DockPanel>

                                                        <!-- Before -> After + detail toggle -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding BeforeDisplay}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                            <TextBlock Text="&#x2192;"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource TextTertiaryBrush}" />
                                                            <TextBlock Text="{Binding AfterDisplay}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <!-- Clickable registry detail count -->
                                                            <ToggleButton IsVisible="{Binding HasMultipleDetails}"
                                                                          IsChecked="{Binding IsExpanded}"
                                                                          Padding="4,0"
                                                                          VerticalAlignment="Center"
                                                                          Background="Transparent"
                                                                          BorderThickness="0"
                                                                          Cursor="Hand">
                                                                <TextBlock Text="{Binding DetailCountText}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                            </ToggleButton>
                                                        </StackPanel>

                                                        <!-- Expandable detail section -->
                                                        <ItemsControl ItemsSource="{Binding Details}"
                                                                      IsVisible="{Binding IsExpanded}"
                                                                      Margin="0,6,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ChangeHistoryEntryViewModel">
                                                                    <Border Margin="0,1"
                                                                            Padding="8,4"
                                                                            CornerRadius="2"
                                                                            Background="#08FFFFFF">
                                                                        <DockPanel>
                                                                            <!-- Restore/Redo button per entry -->
                                                                            <StackPanel DockPanel.Dock="Right"
                                                                                        VerticalAlignment="Center"
                                                                                        Margin="6,0,0,0">
                                                                                <Button Classes="apply-bar-discard"
                                                                                        Content="Restore"
                                                                                        FontSize="10"
                                                                                        Padding="6,2"
                                                                                        IsVisible="{Binding !IsReverted}"
                                                                                        Command="{Binding $parent[UserControl].((vm:ChangeHistoryViewModel)DataContext).RestoreCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                                <Button Classes="apply-bar-discard"
                                                                                        Content="Redo"
                                                                                        FontSize="10"
                                                                                        Padding="6,2"
                                                                                        IsVisible="{Binding IsReverted}"
                                                                                        Command="{Binding $parent[UserControl].((vm:ChangeHistoryViewModel)DataContext).RedoCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            </StackPanel>

                                                                            <StackPanel Spacing="1">
                                                                                <TextBlock Text="{Binding SystemLocation}"
                                                                                           FontFamily="{StaticResource MonoFont}"
                                                                                           FontSize="11"
                                                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                    <TextBlock Text="{Binding BeforeDisplay}"
                                                                                               FontSize="11"
                                                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                                                    <TextBlock Text="&#x2192;"
                                                                                               FontSize="11"
                                                                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                                                                    <TextBlock Text="{Binding AfterDisplay}"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
