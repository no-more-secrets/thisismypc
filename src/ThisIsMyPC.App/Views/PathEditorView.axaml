<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="ThisIsMyPC.App.Views.PathEditorView"
             x:DataType="vm:PathEditorViewModel">

    <Grid>
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding CharacterCountText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}" />

            <ItemsControl x:Name="EntriesList"
                          ItemsSource="{Binding Entries}"
                          DragDrop.AllowDrop="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PathEntryViewModel">
                        <Border Padding="0" Margin="0,1" CornerRadius="4"
                                Background="{DynamicResource SurfaceBrush}"
                                DragDrop.AllowDrop="True">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Drag handle with index -->
                                <Border Grid.Column="0"
                                        PointerPressed="OnGripPointerPressed"
                                        Background="{DynamicResource OverlayBrush}"
                                        Cursor="SizeAll"
                                        Padding="6,0,10,0"
                                        CornerRadius="4,0,0,4"
                                        VerticalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#x283F;"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Index}"
                                                   Width="22" FontSize="12"
                                                   TextAlignment="Right"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Path text -->
                                <TextBox Grid.Column="1"
                                         Text="{Binding Path}"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Padding="6,4"
                                         Margin="2,0" />

                                <!-- Remove button -->
                                <Button Grid.Column="2"
                                        Command="{Binding $parent[ItemsControl].((vm:PathEditorViewModel)DataContext).RemoveEntryCommand}"
                                        CommandParameter="{Binding}"
                                        Background="{DynamicResource OverlayBrush}"
                                        CornerRadius="0,4,4,0"
                                        Padding="10,0"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        HorizontalContentAlignment="Center">
                                    <TextBlock Text="&#x2715;"
                                               Foreground="{DynamicResource DangerBrush}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Margin="0,-1,0,0" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Add Entry"
                    Command="{Binding AddEntryCommand}"
                    Padding="10,5" FontSize="12"
                    Margin="0,4,0,0" />
        </StackPanel>

        <!-- Drag ghost overlay -->
        <Canvas x:Name="DragOverlay" IsHitTestVisible="False" />
    </Grid>
</UserControl>
