<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="ThisIsMyPC.App.Views.PathEditorView"
             x:DataType="vm:PathEditorViewModel">

    <StackPanel Spacing="4">
        <TextBlock Text="{Binding CharacterCountText}"
                   FontSize="11"
                   Foreground="{StaticResource TextTertiaryBrush}" />

        <ItemsControl x:Name="EntriesList"
                      ItemsSource="{Binding Entries}"
                      DragDrop.AllowDrop="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PathEntryViewModel">
                    <Border Padding="4,2" Margin="0,1" CornerRadius="4"
                            Background="{StaticResource CardBrush}"
                            DragDrop.AllowDrop="True">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Drag handle with index -->
                            <Border Grid.Column="0"
                                    PointerPressed="OnGripPointerPressed"
                                    Background="Transparent"
                                    Cursor="SizeAll"
                                    Padding="4,0,8,0"
                                    VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#x283F;"
                                               FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Index}"
                                               Width="18" FontSize="11"
                                               TextAlignment="Right"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Path text -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding Path}"
                                     FontSize="12"
                                     Padding="6,3"
                                     Margin="0,0,4,0" />

                            <!-- Remove button -->
                            <Button Grid.Column="2"
                                    Content="X"
                                    Command="{Binding $parent[ItemsControl].((vm:PathEditorViewModel)DataContext).RemoveEntryCommand}"
                                    CommandParameter="{Binding}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Padding="6,2" FontSize="11" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Content="Add Entry"
                    Command="{Binding AddEntryCommand}"
                    Padding="10,5" FontSize="12" />
            <Button Content="Save PATH"
                    Command="{Binding SavePathCommand}"
                    Padding="10,5" FontSize="12"
                    FontWeight="SemiBold" />
        </StackPanel>
    </StackPanel>
</UserControl>
