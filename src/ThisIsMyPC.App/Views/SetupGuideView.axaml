<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:icons="using:ThisIsMyPC.App.Icons"
             x:Class="ThisIsMyPC.App.Views.SetupGuideView"
             x:DataType="vm:SetupGuideViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/SelectionCards.axaml" />
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto" Margin="0,4,0,0">
        <Grid ColumnDefinitions="240,16,*">
            <ScrollViewer x:Name="LessonScroll" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Lessons}" Margin="0,0,16,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SetupLessonViewModel">
                            <Button Classes="set-card"
                                    Command="{Binding $parent[UserControl].((vm:SetupGuideViewModel)DataContext).SelectLessonCommand}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                                <Border Classes="set-card-body" Classes.selected="{Binding IsSelected}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <icons:FluentIcon Symbol="{Binding IconSymbol}" Width="18" Height="18" Margin="0,0,10,0"
                                                          VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="DetailScroll" Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="0,0,16,24">
                    <TextBlock Text="{Binding DeviceStatus}" IsVisible="{Binding HasDeviceStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Current.Title}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Current.Availability}" IsVisible="{Binding Current.HasAvailability}"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding Current.Body}" FontSize="14" LineHeight="23" />
                    <CheckBox IsVisible="{Binding Current.HasRecommendations}" IsEnabled="{Binding IsDesktop}"
                              IsChecked="{Binding Current.IncludeRecommendations}">
                        <TextBlock Text="Include in pack" />
                    </CheckBox>
                    <Button Content="Open module" Command="{Binding OpenModuleCommand}" IsVisible="{Binding CanOpenModule}"
                            HorizontalAlignment="Left" ToolTip.Tip="Return from Home to continue the guide" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,12,16,0">
            <Button Content="Back" Command="{Binding PreviousCommand}" IsEnabled="{Binding HasPrevious}" />
            <Button Grid.Column="1" Content="Leave guide" Command="{Binding CloseCommand}" Margin="8,0,0,0" ToolTip.Tip="Return from Home to continue this guide" />
            <TextBlock Grid.Column="2" Text="{Binding Progress}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Button Grid.Column="3" Content="Next" Command="{Binding NextCommand}" IsVisible="{Binding HasNext}" />
            <Button Grid.Column="4" Content="Review pack" Classes="apply-bar-apply" Command="{Binding ReviewPackCommand}"
                    IsVisible="{Binding IsLast}" IsEnabled="{Binding IsDesktop}" />
        </Grid>
    </Grid>
</UserControl>
