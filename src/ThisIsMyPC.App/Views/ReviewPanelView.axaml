<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:views="using:ThisIsMyPC.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="500"
             x:Class="ThisIsMyPC.App.Views.ReviewPanelView"
             x:DataType="vm:ReviewPanelViewModel">

    <Border Background="{StaticResource RaisedBrush}"
            BorderBrush="{StaticResource SidebarBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Width="450"
            MaxHeight="500"
            Padding="0">

        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top"
                    Padding="16,12"
                    BorderBrush="{StaticResource SidebarBorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding HeaderCountText}"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Review Pending Changes"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: status message + action buttons -->
            <Border DockPanel.Dock="Bottom"
                    Padding="16,10"
                    BorderBrush="{StaticResource SidebarBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Spacing="8">
                    <!-- Error/status feedback -->
                    <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StatusMessage}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StatusBrush}"
                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Save as Set (8.5): shared confirmation + inline metadata form -->
                    <views:SaveSetFormView DataContext="{Binding SaveSetForm}" />

                    <Button Classes="apply-bar-discard"
                            Content="Save as Set"
                            HorizontalAlignment="Right"
                            Command="{Binding SaveSetForm.OpenCommand}"
                            IsVisible="{Binding !SaveSetForm.IsOpen}"
                            IsEnabled="{Binding !!ReviewGroups.Count}" />

                    <DockPanel>
                        <Button DockPanel.Dock="Left"
                                Classes="apply-bar-discard"
                                Content="Discard All"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DiscardAllCommand}"
                                IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanModifyPending}" />
                        <Button DockPanel.Dock="Right"
                                Classes="apply-bar-apply"
                                Content="Apply All"
                                HorizontalAlignment="Right"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ApplyAllCommand}"
                                IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanModifyPending}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Change list or empty state -->
            <Panel MinHeight="80">
                <!-- Empty state -->
                <StackPanel IsVisible="{Binding IsEmpty}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="No pending changes"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Make changes in a module to see them here"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>

                <!-- Grouped change items + one-way actions -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding !IsEmpty}">
                  <StackPanel>
                    <ItemsControl ItemsSource="{Binding ReviewGroups}" Margin="8,8"
                                  IsVisible="{Binding !!ReviewGroups.Count}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewGroupViewModel">
                                <Border Margin="0,2"
                                        Padding="12,8"
                                        CornerRadius="4"
                                        Classes.pending-enable="{Binding IsEnableOrCreate}"
                                        Classes.pending-disable="{Binding IsDisableOrDelete}"
                                        Classes.pending-modify="{Binding IsModifyCategory}">
                                    <StackPanel Spacing="2">
                                        <!-- Group display name -->
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />

                                        <!-- Before -> After -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding BeforeDisplay}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="&#x2192;"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding AfterDisplay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <!-- Clickable registry detail count -->
                                            <ToggleButton IsVisible="{Binding HasMultipleDetails}"
                                                          IsChecked="{Binding IsExpanded}"
                                                          Classes="review-detail-toggle"
                                                          Padding="4,0"
                                                          VerticalAlignment="Center"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Cursor="Hand">
                                                <TextBlock Text="{Binding DetailCount, StringFormat='({0} registry operations)'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                            </ToggleButton>
                                        </StackPanel>

                                        <!-- Expandable detail section -->
                                        <ItemsControl ItemsSource="{Binding Details}"
                                                      IsVisible="{Binding IsExpanded}"
                                                      Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ReviewItemViewModel">
                                                    <Border Margin="0,1"
                                                            Padding="8,4"
                                                            CornerRadius="2"
                                                            Background="#08FFFFFF">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding SystemLocation}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextTertiaryBrush}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding BeforeDisplay}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <TextBlock Text="&#x2192;"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                                <TextBlock Text="{Binding AfterDisplay}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- One-way actions (installs/uninstalls). Not undoable from history. -->
                    <StackPanel IsVisible="{Binding HasActions}" Margin="8,0,8,8">
                        <TextBlock Text="One-way actions"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="4,6,0,2"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="These run on Apply. They cannot be undone from history and are not included in saved sets."
                                   FontSize="11"
                                   Margin="4,0,0,4"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                        <ItemsControl ItemsSource="{Binding ReviewActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReviewActionViewModel">
                                    <Border Margin="0,2"
                                            Padding="12,8"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource SidebarBorderBrush}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Classes="apply-bar-discard"
                                                    Content="Remove"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsApplying}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ReviewPanelViewModel)DataContext).UnstageActionCommand}"
                                                    CommandParameter="{Binding ActionId}" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding UndoHint}"
                                                           IsVisible="{Binding HasUndoHint}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
