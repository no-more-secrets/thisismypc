<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ThisIsMyPC.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <!-- Read-only dashboard (10.5): system identity, quick actions, recent activity -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="24,16,24,24" Spacing="16">

            <!-- System Identity -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Identity.MachineName}"
                               FontWeight="SemiBold" FontSize="18"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,4,Auto,4,Auto,4,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Identity.WindowsEdition}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Identity.WindowsVersion}" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Identity.Cpu}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="GPU" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Identity.Gpu}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="RAM" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Identity.Ram}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Quick Actions"
                               FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding QuickActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickActionViewModel">
                                <Button Classes="apply-bar-discard"
                                        Command="{Binding OpenCommand}"
                                        Margin="0,0,8,8"
                                        Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  Data="{Binding IconGeometry}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent Activity -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Recent Activity"
                               FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="No changes applied yet — changes you apply will show up here."
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               IsVisible="{Binding !HasRecentActivity}" />
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentActivityItemViewModel">
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding AppliedAtDisplay}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="8,0,0,0" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="Restored"
                                               FontSize="12"
                                               Foreground="{StaticResource WarningBrush}"
                                               Margin="8,0,0,0"
                                               IsVisible="{Binding IsReverted}" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
