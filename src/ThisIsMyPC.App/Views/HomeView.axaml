<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ThisIsMyPC.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <!-- Read-only dashboard (10.5): system identity, quick actions, recent activity -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="24,16,24,24" Spacing="16">

            <!-- 5-2: first-launch capability summary (dismissible, once) -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20,16"
                    IsVisible="{Binding FirstLaunchBanner.IsVisible, FallbackValue=False}">
                <StackPanel Spacing="10" DataContext="{Binding FirstLaunchBanner}"
                            x:DataType="vm:FirstLaunchBannerViewModel">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Dismiss"
                                Command="{Binding DismissCommand}" Padding="12,4" />
                        <StackPanel>
                            <TextBlock Text="Welcome - here's what this system supports"
                                       FontWeight="SemiBold" FontSize="16"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="This summary shows once. It stays available under Settings."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding ModuleRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FirstLaunchRowViewModel">
                                <DockPanel Margin="0,2,0,2">
                                    <Button DockPanel.Dock="Right" Content="Open"
                                            Command="{Binding NavigateCommand}"
                                            IsVisible="{Binding CanNavigate}"
                                            Padding="10,2" FontSize="12" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource SuccessBrush}"
                                                     IsVisible="{Binding IsAvailable}" />
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource WarningBrush}"
                                                     IsVisible="{Binding !IsAvailable}" />
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="14,0,8,0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Hardware ecosystems"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding CapabilityRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FirstLaunchRowViewModel">
                                <StackPanel Margin="0,2,0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{DynamicResource SuccessBrush}"
                                                 IsVisible="{Binding IsAvailable}" />
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{DynamicResource WarningBrush}"
                                                 IsVisible="{Binding !IsAvailable}" />
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="14,0,8,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 28-3: drift report from the Owner Mode service -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20,16"
                    IsVisible="{Binding DriftSection, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8" DataContext="{Binding DriftSection}"
                            x:DataType="vm:DriftSectionViewModel">
                    <TextBlock Text="{Binding Header}"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Likely a Windows update or policy refresh. Reapplying stages the fix for your review - nothing changes until you apply."
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DriftRowViewModel">
                                <DockPanel Margin="0,3,0,3">
                                    <Button DockPanel.Dock="Right" Content="Reapply"
                                            Command="{Binding ReapplyCommand}"
                                            Padding="10,2" FontSize="12" />
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Reapply All" Command="{Binding ReapplyAllCommand}"
                                Padding="10,4" FontSize="12" />
                        <Button Content="Dismiss" Command="{Binding DismissCommand}"
                                Padding="10,4" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 9-3: unreviewed monitoring detections -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20,16"
                    IsVisible="{Binding MonitoringSection, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8" DataContext="{Binding MonitoringSection}"
                            x:DataType="vm:MonitoringSectionViewModel">
                    <TextBlock Text="{Binding Header}"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Programs added these to your boot sequence since the last review."
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetectionRowViewModel">
                                <DockPanel Margin="0,3,0,3">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Disable" Command="{Binding DisableCommand}"
                                                Padding="10,2" FontSize="12" />
                                        <Button Content="Dismiss" Command="{Binding DismissCommand}"
                                                Padding="10,2" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- System Identity -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Identity.MachineName}"
                               FontWeight="SemiBold" FontSize="18"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,4,Auto,4,Auto,4,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Identity.WindowsEdition}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Identity.WindowsVersion}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Identity.Cpu}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="GPU" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Identity.Gpu}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="RAM" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Identity.Ram}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Quick Actions"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding QuickActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickActionViewModel">
                                <Button Classes="apply-bar-discard"
                                        Command="{Binding OpenCommand}"
                                        Margin="0,0,8,8"
                                        Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  Data="{Binding IconGeometry}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent Activity -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Recent Activity"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="No changes applied yet — changes you apply will show up here."
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               IsVisible="{Binding !HasRecentActivity}" />
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentActivityItemViewModel">
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding AppliedAtDisplay}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="8,0,0,0" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="Restored"
                                               FontSize="12"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Margin="8,0,0,0"
                                               IsVisible="{Binding IsReverted}" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
