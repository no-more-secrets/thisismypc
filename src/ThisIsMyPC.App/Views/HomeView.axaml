<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ThisIsMyPC.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <!-- Read-only dashboard (10.5): system identity, quick actions, recent activity -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch" Margin="0,4,16,24" Spacing="16">

            <!-- 5-2: first-launch capability summary (dismissible, once) -->
            <Border Classes="card" CornerRadius="8" Padding="20,16"
                    IsVisible="{Binding FirstLaunchBanner.IsVisible, FallbackValue=False}">
                <StackPanel Spacing="10" DataContext="{Binding FirstLaunchBanner}"
                            x:DataType="vm:FirstLaunchBannerViewModel">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Dismiss"
                                Command="{Binding DismissCommand}" Padding="12,4" />
                        <StackPanel>
                            <TextBlock Text="Welcome - here's what this system supports"
                                       FontWeight="SemiBold" FontSize="16"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="This summary shows once. It stays available under Settings."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding ModuleRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FirstLaunchRowViewModel">
                                <DockPanel Margin="0,2,0,2">
                                    <Button DockPanel.Dock="Right" Content="Open"
                                            Command="{Binding NavigateCommand}"
                                            IsVisible="{Binding CanNavigate}"
                                            Padding="10,2" FontSize="12" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource SuccessBrush}"
                                                     IsVisible="{Binding IsAvailable}" />
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource WarningBrush}"
                                                     IsVisible="{Binding !IsAvailable}" />
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="14,0,8,0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Hardware ecosystems"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding CapabilityRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FirstLaunchRowViewModel">
                                <StackPanel Margin="0,2,0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{DynamicResource SuccessBrush}"
                                                 IsVisible="{Binding IsAvailable}" />
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{DynamicResource WarningBrush}"
                                                 IsVisible="{Binding !IsAvailable}" />
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="14,0,8,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 28-3: drift report from the Owner Mode service -->
            <Border Classes="card" CornerRadius="8" Padding="20,16"
                    IsVisible="{Binding DriftSection, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8" DataContext="{Binding DriftSection}"
                            x:DataType="vm:DriftSectionViewModel">
                    <TextBlock Text="{Binding Header}"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Likely a Windows update or policy refresh. Reapplying stages the fix for your review - nothing changes until you apply."
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DriftRowViewModel">
                                <DockPanel Margin="0,3,0,3">
                                    <Button DockPanel.Dock="Right" Content="Reapply"
                                            Command="{Binding ReapplyCommand}"
                                            Padding="10,2" FontSize="12" />
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Reapply All" Command="{Binding ReapplyAllCommand}"
                                Padding="10,4" FontSize="12" />
                        <Button Content="Dismiss" Command="{Binding DismissCommand}"
                                Padding="10,4" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 9-3: unreviewed monitoring detections -->
            <Border Classes="card" CornerRadius="8" Padding="20,16"
                    IsVisible="{Binding MonitoringSection, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8" DataContext="{Binding MonitoringSection}"
                            x:DataType="vm:MonitoringSectionViewModel">
                    <TextBlock Text="{Binding Header}"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Programs added these to your boot sequence since the last review."
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetectionRowViewModel">
                                <DockPanel Margin="0,3,0,3">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Disable" Command="{Binding DisableCommand}"
                                                Padding="10,2" FontSize="12" />
                                        <Button Content="Dismiss" Command="{Binding DismissCommand}"
                                                Padding="10,2" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- System overview -->
            <Grid ColumnDefinitions="*,16,*">
                <Border Grid.Column="0" Classes="card" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Device" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding Identity.MachineName}" FontWeight="SemiBold" FontSize="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                            <TextBlock Text="Manufacturer" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Identity.Manufacturer}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Text="Model" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Identity.Model}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="4" Text="Processor" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Identity.Cpu}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="6" Text="Installed RAM" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Identity.Ram}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="8" Text="System type" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Identity.SystemType}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Windows specifications" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,8,Auto,8,Auto">
                            <TextBlock Text="Edition" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Identity.WindowsEdition}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Text="Version" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Identity.WindowsVersion}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="4" Text="Graphics" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Identity.Gpu}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Activity -->
            <Border Classes="card" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Recent Activity"
                               FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="No changes applied yet. They will show up here."
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               IsVisible="{Binding !HasRecentActivity}" />
                    <ItemsControl ItemsSource="{Binding RecentActivityGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentActivityGroupViewModel">
                                <StackPanel Spacing="8" Margin="0,2,0,8">
                                    <TextBlock Text="{Binding DateHeader}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecentActivityItemViewModel">
                                                <Border Classes="card" Padding="14,10" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,5,Auto,6,Auto">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding AppliedAtDisplay}" Margin="12,0,0,0"
                                                                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="badge"><TextBlock Text="{Binding ModuleDisplay}" /></Border>
                                                            <TextBlock Text="{Binding OperationCountDisplay}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusDisplay}" Margin="12,0,0,0"
                                                                   FontSize="12" Foreground="{DynamicResource SuccessBrush}" />
                                                        <ItemsControl Grid.Row="4" Grid.ColumnSpan="2" ItemsSource="{Binding Details}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:RecentActivityDetailViewModel">
                                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding ChangeDisplay}" Margin="16,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
