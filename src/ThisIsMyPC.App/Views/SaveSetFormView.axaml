<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             x:Class="ThisIsMyPC.App.Views.SaveSetFormView"
             x:DataType="vm:SaveSetFormViewModel">

    <!-- Shared custom-set metadata form (8.5), embedded by the review panel
         ("Save as Set") and the history panel ("Create Set from Selection").
         The trigger button stays in the host view - its label and enablement
         are host-specific. The outcome is a toast or the status line, never
         text in the form. -->
    <StackPanel Spacing="8">
        <StackPanel Spacing="6" IsVisible="{Binding IsOpen}">
            <TextBox Text="{Binding SetName}"
                     Watermark="Preset name"
                     FontSize="12" />
            <TextBox Text="{Binding SetDescription}"
                     Watermark="What does this preset do?"
                     FontSize="12" />
            <CheckBox IsChecked="{Binding IsOptimizationPack}"
                      Content="Optimization pack (comprehensive bundle)"
                      FontSize="12" />
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Classes="apply-bar-discard"
                        Content="Cancel"
                        Command="{Binding CancelCommand}" />
                <Button DockPanel.Dock="Right"
                        Classes="apply-bar-apply"
                        Content="Save Preset"
                        HorizontalAlignment="Right"
                        Command="{Binding SaveCommand}" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
