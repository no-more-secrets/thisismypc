<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.StartupView"
             x:DataType="vm:StartupViewModel">

    <UserControl.Styles>
        <!-- Row lists are ListBoxes for virtualization (hundreds of rows per
             category); selection is meaningless here, so its chrome is off. -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,0,0,24" />
            <Setter Property="SelectionMode" Value="Toggle" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.filter">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:AutorunSearchHeader">
            <TextBlock Text="{Binding Text}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,10,0,4"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </DataTemplate>

        <DataTemplate x:DataType="vm:AutorunItemViewModel">
            <Border Padding="12,8" Margin="0,2" CornerRadius="4"
                    Classes="card">
                <Grid ColumnDefinitions="2*,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DescriptionText}"
                                   IsVisible="{Binding HasDescription}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Text="{Binding PublisherText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Pending"
                                   IsVisible="{Binding HasPendingChange}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NoteText}"
                                   IsVisible="{Binding HasPlainNote}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NoteText}"
                                   IsVisible="{Binding IsReRegistered}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="3" Grid.Row="0"
                                  IsChecked="{Binding IsEnabled}"
                                  IsEnabled="{Binding CanToggle}"
                                  OffContent=""
                                  OnContent=""
                                  MinWidth="0"
                                  VerticalAlignment="Center" />

                    <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1" Margin="0,4,0,0"
                               Text="{Binding ImagePathText}"
                               IsVisible="{Binding HasImagePath}"
                               FontSize="11"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="2" Margin="0,2,0,0"
                               Text="{Binding LocationText}"
                               FontSize="11"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- Autoruns' layout: one tab per category, the filter row above the
         strip. Typing swaps the strip for one list across every category.
         Fixed chrome keeps the 16px right margin so it shares the content
         edge; the strip wraps because thirteen headers do not fit one row. -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
        <TextBlock Grid.Row="0"
                   Text="{Binding AutorunsScanError, StringFormat='Part of the scan failed: {0}'}"
                   IsVisible="{Binding AutorunsScanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource WarningBrush}"
                   FontSize="12"
                   Margin="0,0,16,6" />
        <DockPanel Grid.Row="1" Margin="0,0,16,0">
            <CheckBox DockPanel.Dock="Right"
                      IsChecked="{Binding HideMicrosoftAutoruns}"
                      Content="Hide Microsoft entries"
                      FontSize="13"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center" />
            <TextBox Classes="filter"
                     Text="{Binding AutorunFilterText}"
                     Watermark="Search every category by name, description, publisher, file, or location" />
        </DockPanel>

        <TabControl Grid.Row="2" ItemsSource="{Binding Tabs}" Margin="0,8,0,0"
                    IsVisible="{Binding !IsSearching}">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AutorunTabViewModel">
                    <TextBlock Text="{Binding Header}" FontSize="14" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:AutorunTabViewModel">
                    <Panel Margin="0,8,0,0">
                        <ListBox Classes="rows" ItemsSource="{Binding Items}" />
                        <TextBlock Text="Nothing in this category"
                                   FontSize="12" FontStyle="Italic"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Top"
                                   IsVisible="{Binding !HasItems}" />
                    </Panel>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,12,0,0" IsVisible="{Binding IsSearching}">
            <TextBlock Grid.Row="0" Text="{Binding SearchSummary}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ListBox Grid.Row="1" Classes="rows" ItemsSource="{Binding SearchResults}" />
        </Grid>
    </Grid>
</UserControl>
