<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.StartupView"
             x:DataType="vm:StartupViewModel">

    <UserControl.Styles>
        <!-- Row lists are ListBoxes for virtualization (hundreds of rows per
             category); selection is meaningless here, so its chrome is off. -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,0,0,24" />
            <Setter Property="SelectionMode" Value="Toggle" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.filter">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:AutorunSearchHeader">
            <TextBlock Text="{Binding Text}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,10,0,4"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </DataTemplate>

        <!-- Location header: the key or folder and when it was last written; shown only with Show locations. -->
        <DataTemplate x:DataType="vm:AutorunLocationHeader">
            <Border Background="{DynamicResource SurfaceBrush}"
                    IsVisible="{Binding $parent[UserControl].((vm:StartupViewModel)DataContext).ShowLocations}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="4,4,0,0" Padding="8,4" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding TimestampText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Location}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:DataType="vm:AutorunItemViewModel">
            <Border Classes="row"
                    Classes.missing="{Binding IsMissing}"
                    Classes.unverified="{Binding IsUnverified}"
                    Classes.pending-enable="{Binding IsPendingEnable}"
                    Classes.pending-disable="{Binding IsPendingDisable}">
              <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="row-bar" />
                <StackPanel Grid.Column="1" Spacing="1" Margin="5,2,8,2">
                    <!-- One line: check, icon, name and description, publisher, notes, date -->
                    <Grid ColumnDefinitions="Auto,Auto,2*,1.3*,Auto,Auto">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsEnabled}"
                                  IsEnabled="{Binding CanToggle}"
                                  ToolTip.Tip="{Binding StateText}"
                                  Margin="0,0,8,0" />
                        <Image Grid.Column="1" Source="{Binding Icon}"
                               Width="16" Height="16" Margin="0,0,8,0"
                               IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                               VerticalAlignment="Center" />
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="300"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DescriptionText}"
                                       IsVisible="{Binding HasDescription}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding PublisherText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding NoteText}"
                                       IsVisible="{Binding HasPlainNote}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding NoteText}"
                                       IsVisible="{Binding IsReRegistered}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="Pending"
                                       IsVisible="{Binding HasPendingChange}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="5"
                                   Text="{Binding TimestampText}"
                                   IsVisible="{Binding HasTimestamp}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Detail lines, only when asked for on the toolbar -->
                    <TextBlock Text="{Binding ImagePathText}"
                               FontSize="11"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="28,0,0,0">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="$parent[UserControl].((vm:StartupViewModel)DataContext).ShowPaths" />
                                <Binding Path="HasImagePath" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <TextBlock Text="{Binding LocationText}"
                               IsVisible="{Binding $parent[UserControl].((vm:StartupViewModel)DataContext).ShowLocations}"
                               FontSize="11"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="28,0,0,0" />
                </StackPanel>
              </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- Autoruns' layout: one tab per category, the filter row above the
         strip. Typing swaps the strip for one list across every category.
         Fixed chrome keeps the 16px right margin so it shares the content
         edge; the strip wraps because thirteen headers do not fit one row. -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="0,4,0,0">
        <TextBlock Grid.Row="0"
                   Text="{Binding AutorunsScanError, StringFormat='Part of the scan failed: {0}'}"
                   IsVisible="{Binding AutorunsScanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource WarningBrush}"
                   FontSize="12"
                   Margin="0,0,16,6" />
        <!-- Search, and a 2x2 grid of show boxes beside it: what a row
             reveals (paths, locations) over which rows show (Windows,
             Microsoft; both hidden until ticked). -->
        <DockPanel Grid.Row="1" Margin="0,0,16,0">
            <Grid DockPanel.Dock="Right"
                  ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto"
                  ColumnSpacing="16" RowSpacing="4"
                  Margin="16,0,0,0" VerticalAlignment="Center">
                <CheckBox Grid.Row="0" Grid.Column="0" Content="Paths" IsChecked="{Binding ShowPaths}" />
                <CheckBox Grid.Row="0" Grid.Column="1" Content="Locations" IsChecked="{Binding ShowLocations}" />
                <CheckBox Grid.Row="1" Grid.Column="0" Content="Windows" IsChecked="{Binding ShowWindowsEntries}" />
                <CheckBox Grid.Row="1" Grid.Column="1" Content="Microsoft" IsChecked="{Binding ShowMicrosoftEntries}" />
            </Grid>
            <TextBox Classes="filter"
                     Text="{Binding AutorunFilterText}"
                     Watermark="Search by name, description, publisher, file, or location" />
        </DockPanel>

        <TabControl Grid.Row="2" ItemsSource="{Binding Tabs}" Margin="0,8,0,0"
                    IsVisible="{Binding !IsSearching}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AutorunTabViewModel">
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:AutorunTabViewModel">
                    <Panel Margin="0,4,0,0">
                        <ListBox Classes="rows" ItemsSource="{Binding Items}" />
                        <TextBlock Text="Nothing in this category"
                                   FontSize="12" FontStyle="Italic"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Top"
                                   IsVisible="{Binding !HasItems}" />
                    </Panel>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,12,0,0" IsVisible="{Binding IsSearching}">
            <TextBlock Grid.Row="0" Text="{Binding SearchSummary}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ListBox Grid.Row="1" Classes="rows" ItemsSource="{Binding SearchResults}" />
        </Grid>
    </Grid>
</UserControl>
