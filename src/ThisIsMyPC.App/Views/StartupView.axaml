<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.StartupView"
             x:DataType="vm:StartupViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="AutorunRowTemplate" x:DataType="vm:AutorunItemViewModel">
            <Border Padding="12,8" Margin="0,2" CornerRadius="4"
                    Classes="card">
                <Grid ColumnDefinitions="2*,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DescriptionText}"
                                   IsVisible="{Binding HasDescription}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Text="{Binding PublisherText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Pending"
                                   IsVisible="{Binding HasPendingChange}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NoteText}"
                                   IsVisible="{Binding HasNote}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="3" Grid.Row="0"
                                  IsChecked="{Binding IsEnabled}"
                                  IsEnabled="{Binding CanToggle}"
                                  OffContent=""
                                  OnContent=""
                                  MinWidth="0"
                                  VerticalAlignment="Center" />

                    <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1" Margin="0,4,0,0"
                               Text="{Binding ImagePathText}"
                               IsVisible="{Binding HasImagePath}"
                               FontSize="11"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="2" Margin="0,2,0,0"
                               Text="{Binding LocationText}"
                               FontSize="11"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AutorunGroupTemplate" x:DataType="vm:AutorunGroupViewModel">
            <StackPanel Spacing="6" Margin="0,0,0,14">
                <TextBlock Text="{Binding Header}"
                           IsVisible="{Binding ShowHeader}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource AutorunRowTemplate}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Autoruns' layout: one tab per category plus Everything, the filter
         row shared above the strip. Fixed chrome above the tabs keeps the
         16px right margin so it shares the content edge; the strip itself
         wraps because fourteen headers do not fit one row. -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
        <TextBlock Grid.Row="0"
                   Text="{Binding AutorunsScanError, StringFormat='Part of the scan failed: {0}'}"
                   IsVisible="{Binding AutorunsScanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource WarningBrush}"
                   FontSize="12"
                   Margin="0,0,16,6" />
        <DockPanel Grid.Row="1" Margin="0,0,16,0">
            <CheckBox DockPanel.Dock="Right"
                      IsChecked="{Binding HideMicrosoftAutoruns}"
                      Content="Hide Microsoft entries"
                      FontSize="12"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center" />
            <TextBox Text="{Binding AutorunFilterText}"
                     Watermark="Filter by name, description, publisher, file, or location"
                     FontSize="12" />
        </DockPanel>

        <TabControl Grid.Row="2" ItemsSource="{Binding Tabs}" Margin="0,8,0,0">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AutorunTabViewModel">
                    <TextBlock Text="{Binding Header}" FontSize="14" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:AutorunTabViewModel">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6" Margin="0,8,16,24">
                            <ItemsControl ItemsSource="{Binding Groups}"
                                          ItemTemplate="{StaticResource AutorunGroupTemplate}" />
                            <TextBlock Text="Nothing here matches the current filter"
                                       FontSize="12" FontStyle="Italic"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       IsVisible="{Binding !HasItems}" />
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
