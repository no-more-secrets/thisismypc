<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.StartupView"
             x:DataType="vm:StartupViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="StartupEntryRowTemplate" x:DataType="vm:StartupEntryItemViewModel">
            <Border Padding="12,8" Margin="0,2" CornerRadius="4"
                    Background="{StaticResource SurfaceBrush}">
                <Grid ColumnDefinitions="2*,*,Auto,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DescriptionText}"
                                   IsVisible="{Binding HasDescription}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Text="{Binding PublisherText}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Pending"
                                   IsVisible="{Binding HasPendingChange}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="3" Grid.Row="0"
                                  IsChecked="{Binding IsEnabled}"
                                  IsEnabled="{Binding CanToggle}"
                                  OffContent=""
                                  OnContent=""
                                  MinWidth="0"
                                  VerticalAlignment="Center" />

                    <!-- Simplified view: executable location + source label -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1"
                                Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                                IsVisible="{Binding !IsRegistryViewMode}">
                        <TextBlock Text="{Binding SourceLabel}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding FileLocationText}"
                                   FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Registry view: exact source path -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1"
                                Spacing="2" Margin="0,4,0,0"
                                IsVisible="{Binding IsRegistryViewMode}">
                        <TextBlock Text="{Binding RegistryLocationText}"
                                   FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FileLocationText}"
                                   FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ScheduledTaskRowTemplate" x:DataType="vm:ScheduledTaskItemViewModel">
            <Border Padding="12,8" Margin="0,2" CornerRadius="4"
                    Background="{StaticResource SurfaceBrush}">
                <Grid ColumnDefinitions="2*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Border IsVisible="{Binding IsCompanionTask}"
                                    Background="{StaticResource WarningBrush}"
                                    CornerRadius="3" Padding="5,1"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding CompanionDescription}">
                                <TextBlock Text="Enforcement companion"
                                           FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="Pending"
                                       IsVisible="{Binding HasPendingChange}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding DescriptionText}"
                                   IsVisible="{Binding HasDescription}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding PublisherText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding TriggersText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding LastRunText, StringFormat='Last run: {0}'}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding LastResultText}"
                                       FontSize="11"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Path}"
                                   FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ComboBox Grid.Column="1" Grid.Row="0"
                              ItemsSource="{Binding ClassificationOptions}"
                              SelectedItem="{Binding SelectedClassification}"
                              FontSize="12"
                              MinWidth="170"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2" Grid.Row="0"
                               Text="{Binding StateText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />

                    <ToggleSwitch Grid.Column="3" Grid.Row="0"
                                  IsChecked="{Binding IsEnabled}"
                                  OffContent=""
                                  OnContent=""
                                  MinWidth="0"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ServiceRowTemplate" x:DataType="vm:ServiceItemViewModel">
            <Border Padding="12,8" Margin="0,2" CornerRadius="4"
                    Background="{StaticResource SurfaceBrush}">
                <Grid ColumnDefinitions="2*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServiceName}"
                                       FontSize="11"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Pending"
                                       IsVisible="{Binding HasPendingChange}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PerUserLabel}"
                                   IsVisible="{Binding IsPerUserInstance}"
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding DescriptionText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Text="{Binding StateText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,12,0"
                               MinWidth="70"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Column="2" Grid.Row="0"
                              ItemsSource="{Binding StartTypeOptions}"
                              SelectedItem="{Binding SelectedStartTypeOption}"
                              IsEnabled="{Binding CanChangeStartType}"
                              FontSize="12"
                              MinWidth="150"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="3" Grid.Row="0" Orientation="Horizontal" Spacing="4"
                                IsEnabled="{Binding !IsBusy}"
                                VerticalAlignment="Center">
                        <Button Content="Start" Command="{Binding StartCommand}" Padding="8,4" FontSize="12" />
                        <Button Content="Stop" Command="{Binding StopCommand}" Padding="8,4" FontSize="12" />
                        <Button Content="Restart" Command="{Binding RestartCommand}" Padding="8,4" FontSize="12" />
                    </StackPanel>

                    <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="2"
                               Text="{Binding ActionError}"
                               IsVisible="{Binding ActionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="11"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="0,8,20,16">

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBlock Text="Registry Info"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding IsRegistryViewMode}"
                              OffContent=""
                              OnContent=""
                              VerticalAlignment="Center" />
            </StackPanel>

            <!-- Registry entries -->
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding RegistryHeader}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Programs launched from registry Run keys at sign-in"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding RegistryEntries}"
                              ItemTemplate="{StaticResource StartupEntryRowTemplate}" />
                <TextBlock Text="No registry startup entries found"
                           FontSize="12" FontStyle="Italic"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           IsVisible="{Binding !HasRegistryEntries}" />
            </StackPanel>

            <!-- Startup folder entries -->
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding FolderHeader}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Shortcuts and programs in the user and common Startup folders"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding FolderEntries}"
                              ItemTemplate="{StaticResource StartupEntryRowTemplate}" />
                <TextBlock Text="No startup folder entries found"
                           FontSize="12" FontStyle="Italic"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           IsVisible="{Binding !HasFolderEntries}" />
            </StackPanel>

            <!-- Scheduled task entries -->
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding TaskHeader}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Tasks that run at sign-in or startup (full task auditing arrives with the Scheduled Tasks section)"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding TaskEntries}"
                              ItemTemplate="{StaticResource StartupEntryRowTemplate}" />
                <TextBlock Text="No startup-related scheduled tasks found"
                           FontSize="12" FontStyle="Italic"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           IsVisible="{Binding !HasTaskEntries}" />
            </StackPanel>

            <!-- All scheduled tasks -->
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding ScheduledTasksSectionHeader}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Every scheduled task on the system, auto-classified — override the classification or disable tasks (staged)"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding ScheduledTasksScanError, StringFormat='Task scan failed: {0}'}"
                           IsVisible="{Binding ScheduledTasksScanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding TaskFilterText}"
                             Watermark="Filter tasks by name, path, or publisher…"
                             FontSize="12"
                             MinWidth="300" />
                    <ComboBox ItemsSource="{Binding ClassificationFilterOptions}"
                              SelectedItem="{Binding TaskClassificationFilter}"
                              FontSize="12"
                              MinWidth="170"
                              VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ScheduledTaskItems}"
                              ItemTemplate="{StaticResource ScheduledTaskRowTemplate}" />
                <TextBlock Text="No tasks match the current filter"
                           FontSize="12" FontStyle="Italic"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           IsVisible="{Binding !HasVisibleTasks}" />
            </StackPanel>

            <!-- Services -->
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding ServicesHeader}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Windows services — change startup type (staged), or start/stop/restart immediately"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding ServicesScanError, StringFormat='Service scan failed: {0}'}"
                           IsVisible="{Binding ServicesScanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="12" />
                <TextBox Text="{Binding ServiceFilterText}"
                         Watermark="Filter services by name or description…"
                         FontSize="12"
                         MaxWidth="400"
                         HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,4,0,0">
                    <TextBlock Text="Sort:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="Name" Command="{Binding SortServicesCommand}" CommandParameter="Name"
                            Padding="8,2" FontSize="12" />
                    <Button Content="Status" Command="{Binding SortServicesCommand}" CommandParameter="Status"
                            Padding="8,2" FontSize="12" />
                    <Button Content="Startup Type" Command="{Binding SortServicesCommand}" CommandParameter="StartType"
                            Padding="8,2" FontSize="12" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Services}"
                              ItemTemplate="{StaticResource ServiceRowTemplate}" />
                <TextBlock Text="No services match the current filter"
                           FontSize="12" FontStyle="Italic"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           IsVisible="{Binding !HasVisibleServices}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
