<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThisIsMyPC.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ThisIsMyPC.App.Views"
        xmlns:controls="using:ThisIsMyPC.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ThisIsMyPC.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ThisIsMyPC"
        MinWidth="900" MinHeight="600"
        Width="1200" Height="800"
        Background="{DynamicResource BaseBrush}"
        FontFamily="{DynamicResource BodyFont}">

    <Panel>
    <Grid ColumnDefinitions="Auto,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="0,0,1,0"
                Width="{Binding IsSidebarCollapsed, Converter={x:Static vm:SidebarWidthConverter.Instance}}">

            <DockPanel>
                <!-- Sidebar toggle -->
                <Button DockPanel.Dock="Top"
                        Classes="sidebar-toggle"
                        Command="{Binding ToggleSidebarCommand}"
                        ToolTip.Tip="Toggle sidebar">
                    <PathIcon Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z"
                              Width="16" Height="16"
                              Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>

                <!-- Home (not a module; ungrouped, pinned above the module groups) -->
                <Button DockPanel.Dock="Top"
                        Classes="sidebar-item"
                        Classes.active="{Binding IsHomeActive}"
                        Command="{Binding OpenHomeCommand}"
                        Margin="0,8,0,0"
                        ToolTip.Tip="System overview and recent activity">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Width="18" Height="18"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" />
                        <TextBlock Text="Home"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   IsVisible="{Binding !IsSidebarCollapsed}" />
                    </StackPanel>
                </Button>

                <!-- Presets (not a module; pinned directly under Home, above the module groups) -->
                <Button DockPanel.Dock="Top"
                        Classes="sidebar-item"
                        Classes.active="{Binding IsSetLoaderActive}"
                        Command="{Binding OpenSetLoaderCommand}"
                        ToolTip.Tip="Browse and preview tweak presets">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Width="18" Height="18"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Data="M12,16L19.36,10.27L21,9L12,2L3,9L4.63,10.27M12,18.54L4.62,12.81L3,14.07L12,21.07L21,14.07L19.37,12.8L12,18.54Z" />
                        <TextBlock Text="Presets"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   IsVisible="{Binding !IsSidebarCollapsed}" />
                    </StackPanel>
                </Button>

                <!-- Settings alone at the bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,8">
                    <!-- Dev-facing style reference; Debug builds only -->
                    <Button Classes="sidebar-item"
                            Classes.active="{Binding IsGalleryActive}"
                            Command="{Binding OpenGalleryCommand}"
                            IsVisible="{x:Static vm:MainWindowViewModel.IsGalleryVisible}"
                            ToolTip.Tip="Standardized styles and tokens (dev)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- Palette swatch icon -->
                            <PathIcon Width="18" Height="18"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C12.83 22 13.5 21.33 13.5 20.5C13.5 20.11 13.35 19.76 13.11 19.49C12.88 19.23 12.73 18.88 12.73 18.5C12.73 17.67 13.4 17 14.23 17H16C19.31 17 22 14.31 22 11C22 6.03 17.52 2 12 2ZM6.5 12C5.67 12 5 11.33 5 10.5C5 9.67 5.67 9 6.5 9C7.33 9 8 9.67 8 10.5C8 11.33 7.33 12 6.5 12ZM9.5 8C8.67 8 8 7.33 8 6.5C8 5.67 8.67 5 9.5 5C10.33 5 11 5.67 11 6.5C11 7.33 10.33 8 9.5 8ZM14.5 8C13.67 8 13 7.33 13 6.5C13 5.67 13.67 5 14.5 5C15.33 5 16 5.67 16 6.5C16 7.33 15.33 8 14.5 8ZM17.5 12C16.67 12 16 11.33 16 10.5C16 9.67 16.67 9 17.5 9C18.33 9 19 9.67 19 10.5C19 11.33 18.33 12 17.5 12Z" />
                            <TextBlock Text="UI Gallery"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="sidebar-item"
                            Classes.active="{Binding IsSettingsActive}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Application preferences">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- Material: Settings gear icon -->
                            <PathIcon Width="18" Height="18"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
                            <TextBlock Text="Settings"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 5-3: cross-module search -->
                <StackPanel DockPanel.Dock="Top" Margin="8,8,8,0"
                            IsVisible="{Binding !IsSidebarCollapsed}">
                    <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                             Watermark="Search settings..."
                             FontSize="13" />
                    <Border Background="{DynamicResource OverlayBrush}"
                            CornerRadius="6" Padding="6" Margin="0,4,0,0"
                            IsVisible="{Binding HasSearchResults}">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchResultViewModel">
                                    <Button Classes="sidebar-item"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSearchResultCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsAvailable}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{Binding Description}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ModuleLine}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Module groups -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SidebarGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarGroupViewModel">
                                <StackPanel>
                                    <!-- Group header -->
                                    <TextBlock Text="{Binding GroupName}"
                                               Classes="sidebar-group-header"
                                               IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}" />

                                    <!-- Module items -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                                <Button Classes="sidebar-item"
                                                        Classes.active="{Binding IsActive}"
                                                        Classes.unavailable="{Binding !IsAvailable}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToModuleCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsAvailable}"
                                                        ToolTip.Tip="{Binding TooltipText}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <PathIcon Width="18" Height="18"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                                  Data="{Binding IconGeometry}" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <DockPanel Grid.Column="1" Margin="24,16">
            <!-- Module header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                <TextBlock Text="{Binding ContentTitle}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding ContentDescription}"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Restart notification bar -->
            <Border DockPanel.Dock="Bottom"
                    Margin="0,16,0,0"
                    Padding="16,10"
                    CornerRadius="8"
                    Background="{DynamicResource RaisedBrush}"
                    Classes.notification-restart="{Binding IsRestartActionAvailable}"
                    Classes.notification-refresh="{Binding !IsRestartActionAvailable}"
                    BorderThickness="1"
                    IsVisible="{Binding IsRestartNotificationVisible}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button Classes="apply-bar-apply"
                                Content="Restart Explorer Now"
                                Command="{Binding RestartExplorerCommand}"
                                IsEnabled="{Binding !IsRestartingExplorer}"
                                IsVisible="{Binding IsRestartActionAvailable}" />
                        <Button Classes="apply-bar-discard"
                                Content="Dismiss"
                                Command="{Binding DismissRestartNotificationCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding RestartNotificationMessage}"
                               VerticalAlignment="Center"
                               Classes.notification-restart="{Binding IsRestartActionAvailable}"
                               Classes.notification-refresh="{Binding !IsRestartActionAvailable}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Apply bar with review panel popup -->
            <Panel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Border x:Name="ApplyBar"
                        Background="{DynamicResource RaisedBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        Padding="16,10"
                        CornerRadius="8">
                    <DockPanel>
                        <!-- Right side: buttons -->
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Classes="apply-bar-discard"
                                    Content="Discard"
                                    Command="{Binding DiscardAllCommand}"
                                    IsEnabled="{Binding CanModifyPending}" />
                            <Button Classes="apply-bar-apply"
                                    Command="{Binding OpenReviewPanelCommand}"
                                    IsEnabled="{Binding CanModifyPending}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Apply" VerticalAlignment="Center" />
                                    <!-- A 20px pill centred on the label; the digit sits
                                         1px above true centre because its glyph has no
                                         descender and would read low otherwise -->
                                    <Border Background="{DynamicResource OverlayBrush}"
                                            BorderBrush="{DynamicResource AccentOutlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Height="20" MinWidth="20"
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasPendingChanges}">
                                        <TextBlock Text="{Binding TotalPendingCount}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,1"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Left side: history button + pending count text -->
                        <StackPanel DockPanel.Dock="Left"
                                    Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Classes="apply-bar-discard"
                                    Command="{Binding OpenHistoryPanelCommand}"
                                    Padding="10,6"
                                    ToolTip.Tip="View all past changes applied through ThisIsMyPC; revert or redo any change">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- Fluent UI: Clock icon -->
                                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"
                                              Width="14" Height="14"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="History"
                                               VerticalAlignment="Center"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button Classes="apply-bar-discard"
                                    Command="{Binding CreateRestorePointCommand}"
                                    IsEnabled="{Binding CanCreateRestorePoint}"
                                    Padding="10,6"
                                    ToolTip.Tip="Create a Windows System Restore point now; a safety net to roll the whole system back to">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- Material: Restore (counterclockwise clock) icon -->
                                    <PathIcon Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"
                                              Width="14" Height="14"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="Restore point"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button Classes="apply-bar-count"
                                    Command="{Binding OpenReviewPanelCommand}">
                                <TextBlock Text="{Binding PendingCountText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13" />
                            </Button>

                            <!-- 7-3: unobtrusive update badge; visible only when a newer release is known -->
                            <Button Classes="apply-bar-discard"
                                    IsVisible="{Binding IsUpdateBadgeVisible}"
                                    Command="{Binding OpenReleasesPageCommand}"
                                    Padding="10,6"
                                    ToolTip.Tip="A newer version is available - click to open the releases page">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UpdateBadgeText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Status message (fills remaining space, truncates with ellipsis) -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="12,0,12,0"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes.status-success="{Binding IsStatusSuccess}"
                                   Classes.status-warning="{Binding IsStatusWarning}"
                                   Classes.status-error="{Binding IsStatusError}" />
                    </DockPanel>
                </Border>

                <!-- Review panel popup -->
                <Popup IsOpen="{Binding IsReviewPanelOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding #ApplyBar}"
                       Placement="Top"
                       HorizontalOffset="-16"
                       VerticalOffset="-8"
                       IsLightDismissEnabled="True"
                       WindowManagerAddShadowHint="False">
                    <views:ReviewPanelView DataContext="{Binding ReviewPanel}" />
                </Popup>

                <!-- History panel popup -->
                <Popup IsOpen="{Binding IsHistoryPanelOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding #ApplyBar}"
                       Placement="Top"
                       HorizontalOffset="-16"
                       VerticalOffset="-8"
                       IsLightDismissEnabled="True"
                       WindowManagerAddShadowHint="False">
                    <views:ChangeHistoryView DataContext="{Binding ChangeHistory}" />
                </Popup>
            </Panel>

            <!-- Module content area. Right padding is 6, not 24: shared
                 geometry puts the scrollbar lane (10px) plus the views' 8px
                 content margin inside the remaining 18, so bg-to-content is
                 24 on both sides on every tab. -->
            <Border Background="{DynamicResource RaisedBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,12,6,24">
                <Panel>
                    <ContentControl Content="{Binding CurrentContent}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="{x:Type vm:ShellViewModel}">
                                <views:ShellView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ContextMenuViewModel}">
                                <views:ContextMenuView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:EnvironmentViewModel}">
                                <views:EnvironmentView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:AnnoyancesViewModel}">
                                <views:AnnoyancesView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
                                <views:PrivacyView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:WindowsUpdateViewModel}">
                                <views:WindowsUpdateView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <views:SettingsView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:GalleryViewModel}">
                                <views:GalleryView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
                                <views:DisplayView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:StartupViewModel}">
                                <views:StartupView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SetLoaderViewModel}">
                                <views:SetLoaderView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                                <views:HomeView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:PowerViewModel}">
                                <views:PowerView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SoftwareViewModel}">
                                <views:SoftwareView />
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                    <!-- Scan-in-progress overlay -->
                    <StackPanel IsVisible="{Binding IsModuleLoading}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <ProgressBar IsIndeterminate="True" Width="180" />
                        <TextBlock Text="{Binding LoadingText}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <!-- Placeholder when a module has no view and nothing is scanning -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="CurrentContent" Converter="{x:Static ObjectConverters.IsNull}" />
                                <Binding Path="!IsModuleLoading" />
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <TextBlock Text="{Binding ContentTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Module content coming in future stories"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Panel>
            </Border>
        </DockPanel>
    </Grid>

    <!-- Toast overlay: transient notifications, top-right over the content area -->
    <controls:ToastHostControl DataContext="{Binding ToastStack}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,16,24,0" />
    </Panel>
</Window>
