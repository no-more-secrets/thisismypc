<Window xmlns="https://github.com/avaloniaui"
        xmlns:icons="using:ThisIsMyPC.App.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThisIsMyPC.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ThisIsMyPC.App.Views"
        xmlns:controls="using:ThisIsMyPC.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ThisIsMyPC.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ThisIsMyPC"
        Icon="/Assets/ThisIsMyPC.ico"
        MinWidth="900" MinHeight="600"
        Width="1200" Height="800"
        Background="{DynamicResource BaseBrush}"
        FontFamily="{DynamicResource BodyFont}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="64">

    <Window.Styles>
        <Style Selector="Border.module-content">
            <Setter Property="Padding" Value="24,12,6,24" />
        </Style>
        <Style Selector="Border.module-content.edge-tabs">
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>

    <!-- Custom frame: the client area covers the system title bar, so the
         first 64px row is our own TitleBarControl (drag, double-click
         maximize, caption buttons). OffScreenMargin keeps content on screen
         when Windows parks the maximized frame edges off the monitor. -->
    <!-- Shell shape: the bar and the sidebar are one L-shaped block in the
         sidebar colour; the page area is an inset panel with a rounded
         inner corner, so the bar reads as chrome and the page as the surface. -->
    <LayoutTransformControl x:Name="AppScaleHost" Margin="{Binding $parent[Window].OffScreenMargin}">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </LayoutTransformControl.LayoutTransform>
    <Grid x:Name="AppSurface" RowDefinitions="Auto,*"
          Background="{DynamicResource SidebarBackgroundBrush}">
    <controls:TitleBarControl Grid.Row="0" Subtitle="{Binding VersionText}">
        <controls:TitleBarControl.CenterContent>
            <!-- 5-3: cross-module search. Results drop down in the overlay
                 below (SearchResultsPanel), aligned on the same centre line. -->
            <TextBox x:Name="SearchBox"
                     Classes="bar-search"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     Watermark="Search settings..."
                     Width="440">
                <TextBox.InnerLeftContent>
                    <icons:FluentIcon Symbol="Search"
                              Width="20" Height="20"
                              Margin="12,0,0,0"
                              Foreground="{DynamicResource TextSecondaryBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </controls:TitleBarControl.CenterContent>
        <controls:TitleBarControl.TrailingContent>
            <!-- Shortcuts: Settings, bug report, GitHub, About -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="bar-icon"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings"
                        AutomationProperties.Name="Settings">
                    <icons:FluentIcon Width="20" Height="20"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Symbol="Settings" />
                </Button>
                <Button Classes="bar-icon"
                        Command="{Binding OpenBugReportCommand}"
                        ToolTip.Tip="Report a bug"
                        AutomationProperties.Name="Report a bug">
                    <icons:FluentIcon Width="20" Height="20"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Symbol="Bug" />
                </Button>
                <Button Classes="bar-icon"
                        Command="{Binding OpenRepositoryCommand}"
                        ToolTip.Tip="GitHub"
                        AutomationProperties.Name="GitHub">
                    <PathIcon Width="16" Height="16"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                </Button>
                <Button x:Name="AboutButton"
                        Classes="bar-icon"
                        Command="{Binding ToggleAboutCommand}"
                        ToolTip.Tip="About"
                        AutomationProperties.Name="About">
                    <icons:FluentIcon Width="20" Height="20"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Symbol="Info" />
                </Button>
            </StackPanel>
        </controls:TitleBarControl.TrailingContent>
    </controls:TitleBarControl>

    <Panel Grid.Row="1">
    <Grid ColumnDefinitions="Auto,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Classes="sidebar" Classes.collapsed="{Binding IsSidebarCollapsed}"
                Background="{DynamicResource SidebarBackgroundBrush}"
                Width="{Binding IsSidebarCollapsed, Converter={x:Static vm:SidebarWidthConverter.Instance}}">

            <DockPanel>
                <!-- Home (not a module; ungrouped, pinned above the module groups) -->
                <Button DockPanel.Dock="Top"
                        Classes="sidebar-item"
                        Classes.active="{Binding IsHomeActive}"
                        Command="{Binding OpenHomeCommand}"
                        Margin="6,8,6,1"
                        ToolTip.Tip="System overview and recent activity">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:FluentIcon Width="22" Height="22"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Symbol="Home" IsFilled="{Binding IsHomeActive}" />
                        <TextBlock Text="Home"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   IsVisible="{Binding !IsSidebarCollapsed}" />
                    </StackPanel>
                </Button>

                <!-- Presets (not a module; pinned directly under Home, above the module groups) -->
                <Button DockPanel.Dock="Top"
                        Classes="sidebar-item"
                        Classes.active="{Binding IsSetLoaderActive}"
                        Command="{Binding OpenSetLoaderCommand}"
                        ToolTip.Tip="Browse and preview tweak presets">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:FluentIcon Width="22" Height="22"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Symbol="Layer" IsFilled="{Binding IsSetLoaderActive}" />
                        <TextBlock Text="Presets"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   IsVisible="{Binding !IsSidebarCollapsed}" />
                    </StackPanel>
                </Button>

                <!-- Settings alone at the bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,8">
                    <!-- Dev-facing Debug page (gallery, test controls, simulation); Debug builds only -->
                    <Button Classes="sidebar-item"
                            Classes.active="{Binding IsDebugActive}"
                            Command="{Binding OpenDebugCommand}"
                            IsVisible="{x:Static vm:MainWindowViewModel.IsDebugVisible}"
                            ToolTip.Tip="Developer tools: style gallery, test controls, state simulation (Debug builds)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:FluentIcon Width="22" Height="22"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      Symbol="Wrench" IsFilled="{Binding IsDebugActive}" />
                            <TextBlock Text="Debug"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="sidebar-item"
                            Classes.active="{Binding IsSettingsActive}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Application preferences">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- Application settings -->
                            <icons:FluentIcon Width="22" Height="22"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      Symbol="Settings" IsFilled="{Binding IsSettingsActive}" />
                            <TextBlock Text="Settings"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding !IsSidebarCollapsed}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Module groups -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SidebarGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarGroupViewModel">
                                <StackPanel>
                                    <!-- Group state belongs to the group, independent of sidebar width. -->
                                    <Button Classes="sidebar-item sidebar-group-toggle"
                                            Command="{Binding ToggleExpansionCommand}"
                                            ToolTip.Tip="{Binding ToggleDescription}"
                                            AutomationProperties.Name="{Binding ToggleDescription}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <icons:FluentIcon Symbol="ChevronDown" Width="12" Height="12"
                                                              IsVisible="{Binding IsExpanded}" />
                                            <icons:FluentIcon Symbol="ChevronDown" RenderTransform="rotate(-90deg)" Width="12" Height="12"
                                                              IsVisible="{Binding !IsExpanded}" />
                                            <TextBlock Text="{Binding GroupName}"
                                                       Classes="sidebar-group-header"
                                                       IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Module items -->
                                    <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                                <Button Classes="sidebar-item"
                                                        Classes.active="{Binding IsActive}"
                                                        Classes.unavailable="{Binding !IsAvailable}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToModuleCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsAvailable}"
                                                        ToolTip.Tip="{Binding TooltipText}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <icons:FluentIcon Width="22" Height="22"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                                  Symbol="{Binding IconSymbol}" IsFilled="{Binding IsActive}" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Sidebar grip: click to toggle or drag the edge to choose a state. It
             snaps to one of the two widths as the pointer crosses the midpoint;
             there is no in-between width. Straddles the edge by 4px each side. -->
        <Border x:Name="SidebarGrip"
                Grid.Column="0"
                HorizontalAlignment="Right"
                Width="16"
                Margin="0,0,-8,0"
                ZIndex="3"
                Background="Transparent"
                Cursor="SizeWestEast"
                Focusable="True"
                ToolTip.Tip="Click to collapse or expand. Drag to choose a side."
                PointerPressed="OnSidebarGripPressed"
                PointerMoved="OnSidebarGripMoved"
                PointerReleased="OnSidebarGripReleased"
                PointerCaptureLost="OnSidebarGripCaptureLost"
                KeyDown="OnSidebarGripKeyDown" />

        <!-- Page area: the inset panel with a 1px rim along the L. Rim plus
             margin add up to the 24 side edge every page's geometry is
             measured against; the top is 10 to a tight title row. -->
        <Border Grid.Column="1"
                Background="{DynamicResource BaseBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="16,0,0,0">
        <DockPanel Margin="23,9,23,16">
            <!-- Page header: the title, and at the right end of its row a
                 refresh button and a page-info button whose flyout carries the
                 one-line description that used to sit under the title. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Button x:Name="AppUpdateButton"
                            Content="{Binding UpdateActionText}"
                            IsVisible="{Binding IsUpdateBadgeVisible}"
                            Command="{Binding DownloadOrRestartUpdateCommand}"
                            ToolTip.Tip="{Binding UpdateBadgeText}"
                            Padding="12,6" />
                    <Button Classes="bar-icon"
                            Command="{Binding RefreshPageCommand}"
                            IsEnabled="{Binding !IsModuleLoading}"
                            ToolTip.Tip="Refresh this page (Ctrl+R)"
                            AutomationProperties.Name="Refresh this page">
                        <icons:FluentIcon Width="20" Height="20"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Symbol="ArrowClockwise" />
                    </Button>
                    <Button Classes="bar-icon"
                            ToolTip.Tip="About this page"
                            AutomationProperties.Name="About this page">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <TextBlock Text="{Binding ContentDescription}"
                                           MaxWidth="360" TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Flyout>
                        </Button.Flyout>
                        <icons:FluentIcon Width="20" Height="20"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Symbol="QuestionCircle" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding ContentTitle}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Restart notification bar -->
            <Border DockPanel.Dock="Bottom"
                    Margin="0,16,0,0"
                    Padding="16,10"
                    CornerRadius="8"
                    Background="{DynamicResource RaisedBrush}"
                    Classes.notification-restart="{Binding IsRestartActionAvailable}"
                    Classes.notification-refresh="{Binding !IsRestartActionAvailable}"
                    BorderThickness="1"
                    IsVisible="{Binding IsRestartNotificationVisible}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button Classes="apply-bar-apply"
                                Content="Restart Explorer Now"
                                Command="{Binding RestartExplorerCommand}"
                                IsEnabled="{Binding !IsRestartingExplorer}"
                                IsVisible="{Binding IsRestartActionAvailable}" />
                        <Button Classes="apply-bar-discard"
                                Content="Dismiss"
                                Command="{Binding DismissRestartNotificationCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding RestartNotificationMessage}"
                               VerticalAlignment="Center"
                               Classes.notification-restart="{Binding IsRestartActionAvailable}"
                               Classes.notification-refresh="{Binding !IsRestartActionAvailable}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Simulated mode bar (Debug page): loud, with the way out on it -->
            <Border DockPanel.Dock="Bottom"
                    Margin="0,16,0,0"
                    Padding="16,10"
                    CornerRadius="8"
                    Background="{DynamicResource DangerMutedBrush}"
                    BorderBrush="{DynamicResource DangerOutlineBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding IsSimulationActive}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Classes="apply-bar-discard"
                            Content="Reset"
                            Command="{Binding ResetSimulationCommand}" />
                    <TextBlock Text="{Binding SimulationBannerText}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>
            </Border>

            <!-- Apply bar with review panel popup -->
            <Panel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Border x:Name="ApplyBar"
                        Background="{DynamicResource RaisedBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        Padding="16,10"
                        CornerRadius="8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <!-- Right side: buttons -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Classes="apply-bar-discard"
                                    Content="Discard"
                                    Command="{Binding DiscardAllCommand}"
                                    IsEnabled="{Binding CanModifyPending}" />
                            <Button Classes="apply-bar-apply"
                                    Command="{Binding OpenReviewPanelCommand}"
                                    IsEnabled="{Binding CanModifyPending}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Apply" VerticalAlignment="Center" />
                                    <!-- A 20px pill centred on the label; the digit sits
                                         1px above true centre because its glyph has no
                                         descender and would read low otherwise -->
                                    <Border Background="{DynamicResource OverlayBrush}"
                                            BorderBrush="{DynamicResource AccentOutlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Height="20" MinWidth="20"
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasPendingChanges}">
                                        <TextBlock Text="{Binding TotalPendingCount}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,1"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Left side: history button + pending count text -->
                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Button Classes="apply-bar-discard"
                                    Command="{Binding OpenHistoryPanelCommand}"
                                    Padding="10,6"
                                    ToolTip.Tip="View all past changes applied through ThisIsMyPC; revert or redo any change">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- Change history -->
                                    <icons:FluentIcon Symbol="History"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="History"
                                               VerticalAlignment="Center"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button Classes="apply-bar-discard"
                                    Grid.Column="1" Margin="12,0,0,0"
                                    Command="{Binding CreateRestorePointCommand}"
                                    IsEnabled="{Binding CanCreateRestorePoint}"
                                    Padding="10,6"
                                    ToolTip.Tip="Create a Windows System Restore point now; a safety net to roll the whole system back to">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- Restore point -->
                                    <icons:FluentIcon Symbol="ArrowCounterclockwise"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="Restore point"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Margin="12,0,0,0" HorizontalContentAlignment="Stretch"
                                    Classes="apply-bar-count"
                                    Command="{Binding OpenReviewPanelCommand}">
                                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding PendingCountText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13" />
                            </Button>


                        </Grid>

                        <!-- Status message (fills remaining space, truncates with ellipsis) -->
                        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes.status-success="{Binding IsStatusSuccess}"
                                   Classes.status-warning="{Binding IsStatusWarning}"
                                   Classes.status-error="{Binding IsStatusError}" />
                    </Grid>
                </Border>

                <!-- Review panel popup -->
                <Popup IsOpen="{Binding IsReviewPanelOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding #ApplyBar}"
                       Placement="Top"
                       HorizontalOffset="-16"
                       VerticalOffset="-8"
                       IsLightDismissEnabled="True"
                       WindowManagerAddShadowHint="False">
                    <views:ReviewPanelView DataContext="{Binding ReviewPanel}" />
                </Popup>

                <!-- History panel popup -->
                <Popup IsOpen="{Binding IsHistoryPanelOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding #ApplyBar}"
                       Placement="Top"
                       HorizontalOffset="-16"
                       VerticalOffset="-8"
                       IsLightDismissEnabled="True"
                       WindowManagerAddShadowHint="False">
                    <views:ChangeHistoryView DataContext="{Binding ChangeHistory}" />
                </Popup>
            </Panel>

            <!-- Untabbed pages use host padding. Tabbed pages own the whole card edge
                 and restores content padding in EdgeTabControlTheme instead.
                 Both paths retain the 16px right margin beside the scrollbar. -->
            <Border x:Name="ModuleContentHost" Classes="module-content"
                    Classes.edge-tabs="{Binding UsesEdgeTabs}"
                    Background="{DynamicResource RaisedBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Panel>
                    <!-- Greyed out while a staged group is unresolved: its cards hold
                         values from before the failed apply, so nothing may stage
                         until Discard All reloads the page. -->
                    <ContentControl Content="{Binding CurrentContent}"
                                    IsEnabled="{Binding IsContentInteractive}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="{x:Type vm:ShellViewModel}">
                                <views:ShellView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ContextMenuViewModel}">
                                <views:ContextMenuView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:EnvironmentViewModel}">
                                <views:EnvironmentView />
                            </DataTemplate>
                            <!-- Annoyances, Privacy, and Windows Update share one card page -->
                            <DataTemplate DataType="{x:Type vm:SettingCardPageViewModel}">
                                <views:SettingCardPageView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <views:SettingsView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:DebugViewModel}">
                                <views:DebugView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
                                <views:DisplayView />
                            </DataTemplate>
                            <!-- System Control, Lighting, Cooling, and Monitoring share one page -->
                            <DataTemplate DataType="{x:Type vm:HardwareTabViewModel}">
                                <views:HardwareTabView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:StartupViewModel}">
                                <views:StartupView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SetLoaderViewModel}">
                                <views:SetLoaderView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                                <views:HomeView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:PowerViewModel}">
                                <views:PowerView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SoftwareViewModel}">
                                <views:SoftwareView />
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                    <!-- Scan-in-progress overlay -->
                    <StackPanel IsVisible="{Binding IsModuleLoading}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <ProgressBar IsIndeterminate="True" Width="180" />
                        <TextBlock Text="{Binding LoadingText}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <!-- Placeholder when a module has no view and nothing is scanning -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="CurrentContent" Converter="{x:Static ObjectConverters.IsNull}" />
                                <Binding Path="!IsModuleLoading" />
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <TextBlock Text="{Binding ContentTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Module content coming in future stories"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Panel>
            </Border>
        </DockPanel>
        </Border>
    </Grid>

    <!-- Keep notifications below the header actions. -->
    <controls:ToastHostControl DataContext="{Binding ToastStack}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,64,24,0" />

    <!-- Zoom pill: floats over the page for a moment after Ctrl+plus/minus/0,
         so the zoom level costs no layout space. Not hit-testable: clicks go
         through to whatever is under it. -->
    <Border x:Name="ZoomOverlay"
            IsVisible="{Binding IsZoomOverlayVisible}"
            IsHitTestVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,84,0,0"
            Padding="14,6"
            CornerRadius="14"
            Background="{DynamicResource RaisedBrush}"
            BorderBrush="{DynamicResource AccentOutlineBrush}"
            BorderThickness="1">
        <TextBlock Text="{Binding ZoomOverlayText}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
    </Border>
    </Panel>

    <!-- Search results: an in-window overlay (not a Popup) hanging from the
         bar's search box, same width and centre line. Opens on results,
         closes on a click outside, Escape, or a selection. -->
    <Border x:Name="SearchResultsPanel"
            Grid.Row="0" Grid.RowSpan="2"
            ZIndex="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,54,0,0"
            Width="440"
            MaxHeight="420"
            Background="{DynamicResource RaisedBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6"
            IsVisible="{Binding IsSearchOpen}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResultViewModel">
                        <Button Classes="sidebar-item"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSearchResultCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsAvailable}"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="{Binding Description}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ModuleLine}" FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>

    <!-- About: same in-window overlay pattern, hanging under the bar's info
         button. Version, publisher, license, and the project links. -->
    <Border x:Name="AboutPanel"
            Grid.Row="0" Grid.RowSpan="2"
            ZIndex="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,54,150,0"
            Width="340"
            Background="{DynamicResource RaisedBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            IsVisible="{Binding IsAboutOpen}">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="avares://ThisIsMyPC.App/Assets/ThisIsMyPC.ico" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ThisIsMyPC"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding VersionText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding PublisherText}"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Free and open source under the GNU GPL v3. Every change is captured before it is made and can be undone."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="apply-bar-discard" Content="GitHub" Padding="10,6"
                        Command="{Binding OpenRepositoryCommand}" />
                <Button Classes="apply-bar-discard" Content="Releases" Padding="10,6"
                        Command="{Binding OpenReleasesPageCommand}" />
                <Button Classes="apply-bar-discard" Content="Report a bug" Padding="10,6"
                        Command="{Binding OpenBugReportCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
    </Grid>
    </LayoutTransformControl>
</Window>
