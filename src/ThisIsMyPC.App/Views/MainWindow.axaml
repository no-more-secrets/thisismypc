<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThisIsMyPC.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ThisIsMyPC.App.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ThisIsMyPC.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ThisIsMyPC"
        MinWidth="900" MinHeight="600"
        Width="1200" Height="800"
        Background="{StaticResource BaseBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid ColumnDefinitions="Auto,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0"
                Width="{Binding IsSidebarCollapsed, Converter={x:Static vm:SidebarWidthConverter.Instance}}">

            <DockPanel>
                <!-- Sidebar toggle -->
                <Button DockPanel.Dock="Top"
                        Classes="sidebar-toggle"
                        Command="{Binding ToggleSidebarCommand}"
                        ToolTip.Tip="Toggle sidebar">
                    <PathIcon Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z"
                              Width="16" Height="16"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>

                <!-- Module groups -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SidebarGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarGroupViewModel">
                                <StackPanel>
                                    <!-- Group header -->
                                    <TextBlock Text="{Binding GroupName}"
                                               Classes="sidebar-group-header"
                                               IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}" />

                                    <!-- Module items -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                                <Button Classes="sidebar-item"
                                                        Classes.active="{Binding IsActive}"
                                                        Classes.unavailable="{Binding !IsAvailable}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToModuleCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsAvailable}"
                                                        ToolTip.Tip="{Binding TooltipText}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <PathIcon Width="18" Height="18"
                                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                                  Data="{Binding IconGeometry}" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarCollapsed}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <DockPanel Grid.Column="1" Margin="24,16">
            <!-- Module header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                <TextBlock Text="{Binding ContentTitle}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="28"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding ContentDescription}"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Apply bar with review panel popup -->
            <Panel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Border x:Name="ApplyBar"
                        Background="{StaticResource RaisedBrush}"
                        BorderBrush="{StaticResource SidebarBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,10"
                        CornerRadius="8">
                    <DockPanel>
                        <!-- Right side: buttons -->
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Classes="apply-bar-discard"
                                    Content="Discard"
                                    Command="{Binding DiscardAllCommand}"
                                    IsEnabled="{Binding CanModifyPending}" />
                            <Button Classes="apply-bar-apply"
                                    Command="{Binding OpenReviewPanelCommand}"
                                    IsEnabled="{Binding CanModifyPending}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Apply" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource OverlayBrush}"
                                            CornerRadius="10"
                                            Padding="7,2"
                                            IsVisible="{Binding HasPendingChanges}">
                                        <TextBlock Text="{Binding PendingCount}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Left side: pending count text (clickable to open review panel) -->
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Classes="apply-bar-count"
                                    Command="{Binding OpenReviewPanelCommand}">
                                <TextBlock Text="{Binding PendingCountText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" />
                            </Button>

                            <!-- Status message (success/error feedback) -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Review panel popup -->
                <Popup IsOpen="{Binding IsReviewPanelOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding #ApplyBar}"
                       Placement="Top"
                       HorizontalOffset="-16"
                       IsLightDismissEnabled="True"
                       WindowManagerAddShadowHint="False">
                    <views:ReviewPanelView DataContext="{Binding ReviewPanel}" />
                </Popup>
            </Panel>

            <!-- Module content area -->
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="24">
                <Panel>
                    <ContentControl Content="{Binding CurrentContent}" />
                    <!-- Placeholder shown when no module view is loaded -->
                    <StackPanel IsVisible="{Binding CurrentContent, Converter={x:Static ObjectConverters.IsNull}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="{Binding ContentTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Module content coming in future stories"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                </Panel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
