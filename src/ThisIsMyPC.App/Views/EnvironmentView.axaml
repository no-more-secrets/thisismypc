<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:views="using:ThisIsMyPC.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.EnvironmentView"
             x:DataType="vm:EnvironmentViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="EnvVarRowTemplate" x:DataType="vm:EnvironmentVariableItemViewModel">
            <Border Padding="12,8" Margin="0,2" CornerRadius="4"
                    Background="{StaticResource SurfaceBrush}">
                <Grid ColumnDefinitions="*,2*,Auto">
                    <!-- Display mode -->
                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsEditing}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0"
                               IsVisible="{Binding !IsEditing}" />

                    <!-- Edit mode -->
                    <TextBox Grid.Column="0" Text="{Binding EditName}"
                             Watermark="Variable name"
                             IsVisible="{Binding IsEditing}"
                             IsEnabled="{Binding IsNew}" />
                    <TextBox Grid.Column="1" Text="{Binding EditValue}"
                             Watermark="Value"
                             Margin="8,0"
                             IsVisible="{Binding IsEditing}" />

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button Content="Edit" Command="{Binding BeginEditCommand}"
                                IsVisible="{Binding !IsEditing}"
                                Padding="8,4" FontSize="12" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}"
                                IsVisible="{Binding !IsEditing}"
                                Foreground="{StaticResource DangerBrush}"
                                Padding="8,4" FontSize="12" />
                        <Button Content="Save" Command="{Binding ConfirmEditCommand}"
                                IsVisible="{Binding IsEditing}"
                                Padding="8,4" FontSize="12" />
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                                IsVisible="{Binding IsEditing}"
                                Padding="8,4" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl>

        <!-- PATH Tab -->
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="PATH" FontSize="13" />
            </TabItem.Header>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Margin="0,8,20,16">

                    <!-- User PATH -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="User PATH"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Per-user PATH entries, appended after system PATH"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Panel IsVisible="{Binding UserPathEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <views:PathEditorView DataContext="{Binding UserPathEditor}" />
                        </Panel>
                        <TextBlock Text="No user PATH variable found"
                                   FontSize="12" FontStyle="Italic"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   IsVisible="{Binding UserPathEditor, Converter={x:Static ObjectConverters.IsNull}}" />
                    </StackPanel>

                    <!-- System PATH -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="System PATH"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="System-wide PATH entries, inherited by all users"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Panel IsVisible="{Binding SystemPathEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <views:PathEditorView DataContext="{Binding SystemPathEditor}" />
                        </Panel>
                        <TextBlock Text="No system PATH variable found"
                                   FontSize="12" FontStyle="Italic"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   IsVisible="{Binding SystemPathEditor, Converter={x:Static ObjectConverters.IsNull}}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- User Tab -->
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="{Binding UserTabHeader}" FontSize="13" />
            </TabItem.Header>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Margin="0,8,20,16">
                    <DockPanel Margin="12,0">
                        <TextBlock Text="Per-user variables (excluding PATH)"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="Add Variable"
                                Command="{Binding AddUserVariableCommand}"
                                HorizontalAlignment="Right"
                                Padding="12,6"
                                FontSize="12" />
                    </DockPanel>
                    <TextBlock Text="{Binding UserScanError, StringFormat='Failed to read user variables: {0}'}"
                               IsVisible="{Binding UserScanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="12" />
                    <ItemsControl ItemsSource="{Binding UserVariables}"
                                  ItemTemplate="{StaticResource EnvVarRowTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- System Tab -->
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="{Binding SystemTabHeader}" FontSize="13" />
            </TabItem.Header>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Margin="0,8,20,16">
                    <DockPanel Margin="12,0">
                        <TextBlock Text="System-wide variables (excluding PATH)"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="Add Variable"
                                Command="{Binding AddSystemVariableCommand}"
                                HorizontalAlignment="Right"
                                Padding="12,6"
                                FontSize="12" />
                    </DockPanel>
                    <TextBlock Text="{Binding SystemScanError, StringFormat='Failed to read system variables: {0}'}"
                               IsVisible="{Binding SystemScanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="12" />
                    <ItemsControl ItemsSource="{Binding SystemVariables}"
                                  ItemTemplate="{StaticResource EnvVarRowTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</UserControl>
