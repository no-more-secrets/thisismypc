<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.ContextMenuView"
             x:DataType="vm:ContextMenuViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="0,12,16,24">

            <!-- Search + Registry Info toggle -->
            <DockPanel Margin="0,0,16,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            Margin="12,0,0,0">
                <TextBlock Text="Registry Info"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding IsRegistryViewMode}"
                              OffContent=""
                              OnContent=""
                              VerticalAlignment="Center" />
                </StackPanel>
                <TextBox Text="{Binding SearchText}"
                         Watermark="Search entries across every tab" />
            </DockPanel>

            <TabControl>
                <!-- Multi-scope Tab -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding MultiHandlerCount}" FontSize="14" />
                    </TabItem.Header>
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="Handlers that appear in multiple right-click contexts. One toggle controls all scopes."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding MultiHandlers}"
                                      ItemTemplate="{StaticResource MultiScopeRowTemplate}" />
                    </StackPanel>
                </TabItem>

                <!-- File Tab -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding FileHandlerCount}" FontSize="14" />
                    </TabItem.Header>
                    <ItemsControl ItemsSource="{Binding FileHandlers}"
                                  ItemTemplate="{StaticResource ToggleSettingRowTemplate}"
                                  Margin="0,8,0,0" />
                </TabItem>

                <!-- Folder Tab -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding FolderHandlerCount}" FontSize="14" />
                    </TabItem.Header>
                    <ItemsControl ItemsSource="{Binding FolderHandlers}"
                                  ItemTemplate="{StaticResource ToggleSettingRowTemplate}"
                                  Margin="0,8,0,0" />
                </TabItem>

                <!-- Folder Background Tab -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding FolderBackgroundHandlerCount}" FontSize="14" />
                    </TabItem.Header>
                    <ItemsControl ItemsSource="{Binding FolderBackgroundHandlers}"
                                  ItemTemplate="{StaticResource ToggleSettingRowTemplate}"
                                  Margin="0,8,0,0" />
                </TabItem>

                <!-- Desktop Tab -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding DesktopHandlerCount}" FontSize="14" />
                    </TabItem.Header>
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="System entries like Display settings and Personalize are built-in and not toggleable."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding DesktopHandlers}"
                                      ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
                    </StackPanel>
                </TabItem>

                <!-- Misc Tab -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding MiscHandlerCount}" FontSize="14" />
                    </TabItem.Header>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Margin="0,8,16,0">
                            <!-- Drive -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Drive" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding DriveMiscHandlers}"
                                              ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
                                <TextBlock Text="No third-party handlers detected"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           IsVisible="{Binding !DriveMiscHandlers.Count}" />
                            </StackPanel>

                            <!-- This PC -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="This PC" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding ThisPcMiscHandlers}"
                                              ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
                                <TextBlock Text="No third-party handlers detected"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           IsVisible="{Binding !ThisPcMiscHandlers.Count}" />
                            </StackPanel>

                            <!-- Network -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Network" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding NetworkMiscHandlers}"
                                              ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
                                <TextBlock Text="No third-party handlers detected"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           IsVisible="{Binding !NetworkMiscHandlers.Count}" />
                            </StackPanel>

                            <!-- Recycle Bin -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Recycle Bin" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding RecycleBinMiscHandlers}"
                                              ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
                                <TextBlock Text="No third-party handlers detected"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           IsVisible="{Binding !RecycleBinMiscHandlers.Count}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- Windows entries: curated named toggles (Sophia recipes) -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="Windows" FontSize="14" />
                    </TabItem.Header>
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="Built-in Windows entries. Add useful ones and hide the rest."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding WindowsEntries}"
                                      ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
                    </StackPanel>
                </TabItem>

                <!-- Per File Type Tab -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="Per File Type" FontSize="14" />
                    </TabItem.Header>
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="Select a file extension to see its specific context menu entries"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontStyle="Italic" />
                        <AutoCompleteBox ItemsSource="{Binding AvailableExtensions}"
                                         SelectedItem="{Binding SelectedExtension, Mode=TwoWay}"
                                         Watermark="Type an extension (e.g., .png)"
                                         FilterMode="Contains"
                                         MinimumPrefixLength="1"
                                         MaxDropDownHeight="300"
                                         Margin="0,0,0,8" />
                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsFileTypeScanning}"
                                     Height="2"
                                     Margin="0,0,0,4" />
                        <TextBlock Text="Select a file extension above to scan for registered context menu entries"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontStyle="Italic"
                                   IsVisible="{Binding !PerFileTypeHandlers.Count}" />
                        <ItemsControl ItemsSource="{Binding PerFileTypeHandlers}"
                                      ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
                    </StackPanel>
                </TabItem>

                <!-- Custom Entries Tab (2-6) -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="Custom" FontSize="14" />
                    </TabItem.Header>
                    <StackPanel DataContext="{Binding Custom}" Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="Your own right-click entries. Changes stage in the review panel; the list below shows what is applied on the system."
                                   FontSize="12" FontStyle="Italic"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Create New Entry" Command="{Binding OpenCreateFormCommand}" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                        </StackPanel>

                        <!-- Create/Edit form -->
                        <Border IsVisible="{Binding IsFormOpen}"
                                Classes="card"
                                CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding FormHeader}" FontWeight="SemiBold" FontSize="14" />
                                <TextBox Watermark="Label shown in the menu"
                                         Text="{Binding FormLabel, Mode=TwoWay}" Width="540" />
                                <TextBox Watermark='Command, e.g. notepad.exe "%1"'
                                         Text="{Binding FormCommandLine, Mode=TwoWay}" Width="540"
                                         FontFamily="{StaticResource MonoFont}" />
                                <TextBox Watermark="Icon path (optional), e.g. C:\Tools\app.exe,0"
                                         Text="{Binding FormIconPath, Mode=TwoWay}" Width="540"
                                         FontFamily="{StaticResource MonoFont}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Appears on:" VerticalAlignment="Center" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding ScopeChoices}"
                                              SelectedItem="{Binding SelectedScopeChoice, Mode=TwoWay}"
                                              IsEnabled="{Binding IsScopeEditable}"
                                              MinWidth="200" />
                                </StackPanel>
                                <TextBlock Text="{Binding FormError}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           FontSize="12"
                                           IsVisible="{Binding FormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Stage Change" Command="{Binding SubmitCommand}" />
                                    <Button Content="Cancel" Command="{Binding CancelFormCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Existing entries -->
                        <TextBlock Text="No custom entries applied yet"
                                   FontSize="12" FontStyle="Italic"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   IsVisible="{Binding !Entries.Count}" />
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomVerbEntryViewModel">
                                    <Border Classes="card"
                                            CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding ScopeDisplay}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Command}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Edit" Margin="8,0,0,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:CustomVerbSectionViewModel)DataContext).BeginEditCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Content="Delete" Margin="8,0,0,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:CustomVerbSectionViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

            </TabControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
