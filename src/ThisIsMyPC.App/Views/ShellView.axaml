<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:controls="using:ThisIsMyPC.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <UserControl.Resources>
        <!-- One run of ExplorerPatcher rows under a sub-heading named after
             the page it sits on in ExplorerPatcher's own window; the tab's
             main run has no heading. Toggles and choices keep the manifest's
             order, so the rows interleave in one list. -->
        <DataTemplate x:Key="PatcherGroupTemplate" x:DataType="vm:ExplorerPatcherGroupViewModel">
            <StackPanel Spacing="4" IsVisible="{Binding IsSearchVisible}">
                <TextBlock Text="{Binding Heading}"
                           IsVisible="{Binding ShowHeading}"
                           Margin="0,8,0,0"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:ResponsiveColumnsPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:ShellSettingViewModel">
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource ToggleSettingRowTemplate}" />
                        </DataTemplate>
                        <DataTemplate DataType="vm:ShellChoiceSettingViewModel">
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource ChoiceSettingRowTemplate}" />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- The installer card at the top of the General tab's block. -->
        <DataTemplate x:Key="ExplorerPatcherCardTemplate" x:DataType="vm:SoftwareAppViewModel">
            <Border Classes="card" CornerRadius="4" Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            MinWidth="84"
                            Padding="12,6" FontSize="12"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Content="{Binding ActionButtonText}"
                            Command="{Binding ToggleQueueCommand}" />
                    <StackPanel Margin="0,0,12,0" Spacing="2"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource SuccessBrush}"
                                     IsVisible="{Binding IsInstalled}"
                                     ToolTip.Tip="Installed" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding WingetId}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Search above, one tab per area below. The search filters the cards
         of every tab; a tab with no match reads as empty. -->
    <Grid RowDefinitions="Auto,*" Margin="0,4,0,0">
        <TextBox Grid.Row="0"
                 Text="{Binding SearchText}"
                 Watermark="Search settings"
                 Margin="0,0,16,0" />

        <TabControl Grid.Row="1" Margin="0,8,0,0">
            <TabItem Header="General">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Margin="0,8,16,24">
                        <ItemsControl ItemsSource="{Binding GeneralSettings}"
                                      ItemTemplate="{StaticResource ToggleSettingRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveColumnsPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- ExplorerPatcher owns the taskbar and Start menu it draws,
                             so these are its values, not Windows' own. Rows show
                             only while it is installed, grouped by the page they
                             sit on in its own window. -->
                        <StackPanel Spacing="4" Margin="0,10,0,0" IsVisible="{Binding ShowGeneralPatcher}">
                            <TextBlock Text="{Binding PatcherHeading}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <!-- Install or installed state, through the one-way actions
                                 queue; Apply runs it through winget. -->
                            <ContentControl Content="{Binding ExplorerPatcher}"
                                            IsVisible="{Binding ShowExplorerPatcher}"
                                            ContentTemplate="{StaticResource ExplorerPatcherCardTemplate}" />
                            <TextBlock Text="{Binding PatcherVersionNote}"
                                       IsVisible="{Binding ShowPatcherVersionNote}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <ItemsControl ItemsSource="{Binding GeneralPatcherGroups}"
                                          ItemTemplate="{StaticResource PatcherGroupTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="File Explorer">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Margin="0,8,16,24">
                        <ItemsControl ItemsSource="{Binding FileExplorerSettings}"
                                      ItemTemplate="{StaticResource ToggleSettingRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveColumnsPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- ExplorerPatcher owns the taskbar and Start menu it draws,
                             so these are its values, not Windows' own. Rows show
                             only while it is installed, grouped by the page they
                             sit on in its own window. -->
                        <StackPanel Spacing="4" Margin="0,10,0,0" IsVisible="{Binding ShowFileExplorerPatcher}">
                            <TextBlock Text="{Binding PatcherHeading}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding PatcherVersionNote}"
                                       IsVisible="{Binding ShowPatcherVersionNote}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <ItemsControl ItemsSource="{Binding FileExplorerPatcherGroups}"
                                          ItemTemplate="{StaticResource PatcherGroupTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Taskbar">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Margin="0,8,16,24">
                        <ItemsControl ItemsSource="{Binding TaskbarSettings}"
                                      ItemTemplate="{StaticResource ToggleSettingRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveColumnsPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding TaskbarChoiceSettings}"
                                      ItemTemplate="{StaticResource ChoiceSettingRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveColumnsPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- ExplorerPatcher owns the taskbar and Start menu it draws,
                             so these are its values, not Windows' own. Rows show
                             only while it is installed, grouped by the page they
                             sit on in its own window. -->
                        <StackPanel Spacing="4" Margin="0,10,0,0" IsVisible="{Binding ShowTaskbarPatcher}">
                            <TextBlock Text="{Binding PatcherHeading}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding PatcherVersionNote}"
                                       IsVisible="{Binding ShowPatcherVersionNote}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <ItemsControl ItemsSource="{Binding TaskbarPatcherGroups}"
                                          ItemTemplate="{StaticResource PatcherGroupTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Desktop">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Margin="0,8,16,24">
                        <ItemsControl ItemsSource="{Binding DesktopSettings}"
                                      ItemTemplate="{StaticResource ToggleSettingRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveColumnsPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- ExplorerPatcher owns the taskbar and Start menu it draws,
                             so these are its values, not Windows' own. Rows show
                             only while it is installed, grouped by the page they
                             sit on in its own window. -->
                        <StackPanel Spacing="4" Margin="0,10,0,0" IsVisible="{Binding ShowDesktopPatcher}">
                            <TextBlock Text="{Binding PatcherHeading}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding PatcherVersionNote}"
                                       IsVisible="{Binding ShowPatcherVersionNote}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <ItemsControl ItemsSource="{Binding DesktopPatcherGroups}"
                                          ItemTemplate="{StaticResource PatcherGroupTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Start Menu">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Margin="0,8,16,24">
                        <ItemsControl ItemsSource="{Binding StartMenuSettings}"
                                      ItemTemplate="{StaticResource ToggleSettingRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveColumnsPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- ExplorerPatcher owns the taskbar and Start menu it draws,
                             so these are its values, not Windows' own. Rows show
                             only while it is installed, grouped by the page they
                             sit on in its own window. -->
                        <StackPanel Spacing="4" Margin="0,10,0,0" IsVisible="{Binding ShowStartMenuPatcher}">
                            <TextBlock Text="{Binding PatcherHeading}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding PatcherVersionNote}"
                                       IsVisible="{Binding ShowPatcherVersionNote}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <ItemsControl ItemsSource="{Binding StartMenuPatcherGroups}"
                                          ItemTemplate="{StaticResource PatcherGroupTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
