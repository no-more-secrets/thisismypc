<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ThisIsMyPC.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:SettingToggleItemViewModel}">
            <Border Classes="card" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <DockPanel>
                <ToggleSwitch DockPanel.Dock="Right"
                              IsChecked="{Binding IsOn}"
                              VerticalAlignment="Top"
                              OnContent="" OffContent="" />
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,2,0,0"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingTextItemViewModel}">
            <Border Classes="card" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <DockPanel>
                <TextBox DockPanel.Dock="Right"
                         Text="{Binding Text}"
                         MinWidth="220"
                         VerticalAlignment="Top" />
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,2,0,0"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingChoiceItemViewModel}">
            <Border Classes="card" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <DockPanel>
                <ComboBox DockPanel.Dock="Right"
                          ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Selected}"
                          MinWidth="220"
                          VerticalAlignment="Top">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingChoiceOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,2,0,0"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <TabControl Margin="0,4,0,0">
      <TabItem Header="General">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,16,24">
            <ItemsControl ItemsSource="{Binding GeneralSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{Binding Header}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,10"
                                       IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Border Height="8" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Items}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Owner Mode service lifecycle -->
            <Border Classes="card" CornerRadius="8" Padding="14" Margin="0,0,0,8"
                    IsVisible="{Binding HasOwnerModeSection}">
              <StackPanel DataContext="{Binding OwnerMode}">
                <TextBlock Text="Owner Mode Service"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,10" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource SuccessBrush}"
                             IsVisible="{Binding IsRunning}" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource WarningBrush}"
                             IsVisible="{Binding !IsRunning}" />
                    <TextBlock Text="{Binding StateText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Enable Service" Command="{Binding EnableCommand}" Padding="12,6" />
                    <Button Content="Disable Service" Command="{Binding DisableCommand}" Padding="12,6" />
                    <ProgressBar IsIndeterminate="True" Width="80" Height="2"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsBusy}" />
                </StackPanel>
                <TextBlock Text="{Binding ErrorText}"
                           FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <!-- Read-only capability summary, always reachable -->
            <Border Classes="card" CornerRadius="8" Padding="14" Margin="0,0,0,8"
                    IsVisible="{Binding HasCapabilityRows}">
              <StackPanel>
                <TextBlock Text="System Capabilities"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="What this system supports."
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,2,0,10" />
                <ItemsControl ItemsSource="{Binding SystemCapabilityRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FirstLaunchRowViewModel">
                            <StackPanel Margin="0,2,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessBrush}"
                                             IsVisible="{Binding IsAvailable}" />
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{DynamicResource WarningBrush}"
                                             IsVisible="{Binding !IsAvailable}" />
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="14,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Backup & Transfer -->
            <Border Classes="card" CornerRadius="8" Padding="14">
              <StackPanel>
                <TextBlock Text="Backup &amp; Transfer"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Export these preferences to a JSON file, or import a file exported on another machine."
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,10" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Export Settings..." Click="OnExportClick" Padding="12,6" />
                    <Button Content="Import Settings..." Click="OnImportClick" Padding="12,6" />
                </StackPanel>

                <StackPanel IsVisible="{Binding HasImportPreview}" Margin="0,12,0,0">
                    <TextBlock Text="{Binding ImportPreviewSummary}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding ImportPreviewRows}" Margin="0,8,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsImportRowWrapper">
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Display}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply Import" Command="{Binding ApplyImportCommand}" Padding="12,6" />
                        <Button Content="Cancel" Command="{Binding CancelImportCommand}" Padding="12,6" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding TransferStatus}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           IsVisible="{Binding TransferStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
      </TabItem>
      <TabItem Header="Background">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding BackgroundSections}" Margin="0,12,16,24">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                <StackPanel>
                  <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="16"
                             Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                  <ItemsControl ItemsSource="{Binding Items}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Modules" IsVisible="{Binding HasModuleSections}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ModuleSections}" Margin="0,12,16,24">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                <StackPanel Margin="0,0,0,16">
                  <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="16"
                             Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                  <ItemsControl ItemsSource="{Binding Items}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
</UserControl>
