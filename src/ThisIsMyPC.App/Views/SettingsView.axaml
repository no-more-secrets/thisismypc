<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ThisIsMyPC.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:SettingToggleItemViewModel}">
            <DockPanel Margin="0,0,0,14">
                <ToggleSwitch DockPanel.Dock="Right"
                              IsChecked="{Binding IsOn}"
                              VerticalAlignment="Top"
                              OnContent="" OffContent="" />
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingTextItemViewModel}">
            <DockPanel Margin="0,0,0,14">
                <TextBox DockPanel.Dock="Right"
                         Text="{Binding Text}"
                         MinWidth="220"
                         VerticalAlignment="Top" />
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingChoiceItemViewModel}">
            <DockPanel Margin="0,0,0,14">
                <ComboBox DockPanel.Dock="Right"
                          ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Selected}"
                          MinWidth="220"
                          VerticalAlignment="Top">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingChoiceOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="24,16,24,24">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{Binding Header}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,10"
                                       IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Border Height="8" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Items}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Module Preferences placeholder until a module contributes settings -->
            <StackPanel IsVisible="{Binding !HasModuleSections}" Margin="0,0,0,24">
                <TextBlock Text="Module Preferences"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding ModulePreferencesPlaceholder}"
                           FontSize="12"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- 5-2 AC3: read-only capability summary, always reachable -->
            <StackPanel IsVisible="{Binding HasCapabilityRows}" Margin="0,0,0,24">
                <TextBlock Text="System Capabilities"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="What this system supports - the same summary shown on first launch."
                           FontSize="12"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Margin="0,2,0,10" />
                <ItemsControl ItemsSource="{Binding SystemCapabilityRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FirstLaunchRowViewModel">
                            <StackPanel Margin="0,2,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{StaticResource SuccessBrush}"
                                             IsVisible="{Binding IsAvailable}" />
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{StaticResource WarningBrush}"
                                             IsVisible="{Binding !IsAvailable}" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="14,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 7-4: Backup & Transfer -->
            <StackPanel>
                <TextBlock Text="Backup &amp; Transfer"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Export these preferences to a JSON file, or import a file exported on another machine."
                           FontSize="12"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,10" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Export Settings..." Click="OnExportClick" Padding="12,6" />
                    <Button Content="Import Settings..." Click="OnImportClick" Padding="12,6" />
                </StackPanel>

                <StackPanel IsVisible="{Binding HasImportPreview}" Margin="0,12,0,0">
                    <TextBlock Text="{Binding ImportPreviewSummary}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding ImportPreviewRows}" Margin="0,8,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsImportRowWrapper">
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Display}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply Import" Command="{Binding ApplyImportCommand}" Padding="12,6" />
                        <Button Content="Cancel" Command="{Binding CancelImportCommand}" Padding="12,6" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding TransferStatus}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           IsVisible="{Binding TransferStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
