<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:controls="using:ThisIsMyPC.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ThisIsMyPC.App.Views.SettingCardPageView"
             x:DataType="vm:SettingCardPageViewModel">

    <!-- The card-rendered module page (Annoyances, Privacy, Windows Update):
         one card-edge tab per provider section, the search box and display
         toggles below the strip. Typing replaces the tabs with one grouped
         list across every section; clearing brings the tabs back on the tab
         that was open. Cards flow into responsive columns. -->
    <UserControl.Resources>
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:SettingCardViewModel">
            <controls:SettingCardControl IsVisible="{Binding IsSearchVisible}" />
        </DataTemplate>
    </UserControl.Resources>

    <controls:ModuleTabControl Theme="{StaticResource ModuleTabControlTheme}"
                               SelectedIndex="{Binding SelectedTabIndex}"
                               ItemsSource="{Binding CardGroups}"
                               ShowTabs="{Binding !IsSearching}">
        <controls:ModuleTabControl.Toolbar>
            <!-- Two stacked boxes beside the search box, as on Startup &
                 Services. The stack sets the row height and the box fills it,
                 so the two edges line up with no height mismatch. -->
            <DockPanel Margin="0,0,16,8">
                <StackPanel x:Name="DisplayToggles"
                            DockPanel.Dock="Right"
                            Spacing="4"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <CheckBox Content="Technical details" IsChecked="{Binding ShowRegistryData}" />
                    <CheckBox Content="Compact" IsChecked="{Binding IsCompact}" />
                </StackPanel>
                <TextBox Text="{Binding SearchText}"
                         Watermark="Search settings"
                         MinHeight="40"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Center" />
            </DockPanel>
        </controls:ModuleTabControl.Toolbar>
        <controls:ModuleTabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingCardGroupViewModel">
                <TextBlock Text="{Binding Header}" />
            </DataTemplate>
        </controls:ModuleTabControl.ItemTemplate>
        <controls:ModuleTabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:SettingCardGroupViewModel">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,16,24">
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ItemsControl ItemsSource="{Binding Cards}"
                                      ItemTemplate="{StaticResource CardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveColumnsPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>
        </controls:ModuleTabControl.ContentTemplate>
        <controls:ModuleTabControl.AlternateContent>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,4,16,24">
                    <TextBlock Text="{Binding SearchSummary}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8"
                               IsVisible="{Binding HasSearchResults}" />
                    <TextBlock Text="No settings match"
                               FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               IsVisible="{Binding !HasSearchResults}" />
                    <ItemsControl ItemsSource="{Binding CardGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingCardGroupViewModel">
                                <StackPanel Margin="0,0,0,16"
                                            IsVisible="{Binding IsSearchVisible}">
                                    <TextBlock Text="{Binding Header}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Cards}"
                                                  ItemTemplate="{StaticResource CardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ResponsiveColumnsPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </controls:ModuleTabControl.AlternateContent>
    </controls:ModuleTabControl>
</UserControl>
