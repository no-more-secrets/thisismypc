<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.AnnoyancesView"
             x:DataType="vm:AnnoyancesViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="0,0,0,16">

            <!-- SCOOBE & Welcome Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Nag Screens &amp; Suggestions"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Suppress setup nags, welcome pages, tips, suggestions, and lock screen ads"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding ScoobeAndWelcomeSettings}"
                              ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
            </StackPanel>

            <!-- Bing Search & Edge Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Bing Search &amp; Edge"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Keep Start Menu search local and stop Edge shortcuts from reappearing"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding BingAndEdgeSettings}"
                              ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
            </StackPanel>

            <!-- Advertising & Tracking Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Advertising &amp; Tracking"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Quick toggles for the Advertising ID, activity history, and suggested content"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding AdvertisingAndTrackingSettings}"
                              ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
            </StackPanel>

            <!-- Gaming & Accessibility Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Gaming &amp; Accessibility"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Game DVR, GPU scheduling, and accidental accessibility shortcut prompts"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding GamingAndAccessibilitySettings}"
                              ItemTemplate="{StaticResource ToggleSettingRowTemplate}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
