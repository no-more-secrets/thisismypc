<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ThisIsMyPC.App.Views.SoftwareView"
             x:DataType="vm:SoftwareViewModel">

    <TabControl>
        <!-- App Catalog tab -->
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="App Catalog" FontSize="13" />
            </TabItem.Header>
            <DockPanel>
                <!-- Toolbar: search + category filter + installed-state note -->
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,8,20,8">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right"
                                  MinWidth="180"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}" />
                        <TextBox Text="{Binding SearchText}"
                                 Watermark="Search apps"
                                 Margin="0,0,8,0" />
                    </DockPanel>
                    <TextBlock Text="Installed state could not be read from winget. Apps still install normally."
                               FontSize="12"
                               Foreground="{StaticResource WarningBrush}"
                               IsVisible="{Binding !InstalledStateKnown}" />
                </StackPanel>

                <!-- App list -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredApps}" Margin="0,0,20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SoftwareAppViewModel">
                                <Border Padding="12,10" Margin="0,2" CornerRadius="4"
                                        Background="{StaticResource SurfaceBrush}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                MinWidth="90"
                                                Padding="8,4" FontSize="12"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                Content="{Binding ActionButtonText}"
                                                Command="{Binding ToggleQueueCommand}" />
                                        <StackPanel Spacing="2" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="Installed"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           IsVisible="{Binding IsInstalled}" />
                                                <TextBlock Text="Open source"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           IsVisible="{Binding IsOpenSource}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding WingetId}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- Updates tab: winget upgrade management -->
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="Updates" FontSize="13" />
            </TabItem.Header>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,8,20,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Padding="8,4" FontSize="12"
                                Content="Update all"
                                Command="{Binding QueueAllUpdatesCommand}"
                                IsVisible="{Binding HasUpdates}" />
                        <TextBlock Text="{Binding UpdatesSummary}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </DockPanel>
                    <TextBlock Text="Updates could not be read from winget. Rescan to try again."
                               FontSize="12"
                               Foreground="{StaticResource WarningBrush}"
                               IsVisible="{Binding !UpgradableStateKnown}" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Updates}" Margin="0,0,20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SoftwareUpdateViewModel">
                                <Border Padding="12,10" Margin="0,2" CornerRadius="4"
                                        Background="{StaticResource SurfaceBrush}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                MinWidth="90"
                                                Padding="8,4" FontSize="12"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                Content="{Binding ActionButtonText}"
                                                Command="{Binding ToggleQueueCommand}"
                                                IsEnabled="{Binding CanAct}" />
                                        <StackPanel Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding VersionText}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding PackageId}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- Windows Apps tab: built-in app removal -->
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="Windows Apps" FontSize="13" />
            </TabItem.Header>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,8,20,8">
                    <TextBlock Text="Removal deletes the app for all users and stops it from auto-installing for new accounts. Apps with a Store listing can be reinstalled here."
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Installed state could not be read from the deployment stack."
                               FontSize="12"
                               Foreground="{StaticResource WarningBrush}"
                               IsVisible="{Binding !AppxStateKnown}" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding WindowsApps}" Margin="0,0,20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WindowsAppViewModel">
                                <Border Padding="12,10" Margin="0,2" CornerRadius="4"
                                        Background="{StaticResource SurfaceBrush}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                MinWidth="90"
                                                Padding="8,4" FontSize="12"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                Content="{Binding ActionButtonText}"
                                                Command="{Binding ToggleQueueCommand}"
                                                IsEnabled="{Binding CanAct}" />
                                        <StackPanel Spacing="2" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="Installed"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           IsVisible="{Binding IsPresent}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding PackageId}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
