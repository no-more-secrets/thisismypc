<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- NativeAOT copies the IL module name into the native version resource. -->
    <UseAppHost Condition="'$(AotPublish)' == 'true'">false</UseAppHost>
    <TargetExt Condition="'$(AotPublish)' == 'true'">.exe</TargetExt>
    <AssemblyTitle>ThisIsMyPC</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ThisIsMyPC.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- CA1515: Avalonia XAML requires public types for views/viewmodels -->
    <!-- CA1724: App class name conflicts with ThisIsMyPC.App namespace (unavoidable convention) -->
    <NoWarn>CA1515;CA1724</NoWarn>
    <!-- NativeAOT probe/publish: opt in with -p:AotPublish=true so normal
         builds and the netstandard2.0 analyzer project stay untouched.
         ControlFlowGuard: the AOT toolchain does not enable CFG by default
         (the CoreCLR apphost does); without it the native image ships with
         zero guarded call targets. -->
    <PublishAot Condition="'$(AotPublish)' == 'true'">true</PublishAot>
    <ControlFlowGuard Condition="'$(AotPublish)' == 'true'">Guard</ControlFlowGuard>
    <DefineConstants Condition="'$(DynamicCodeGuard)' == 'true'">$(DefineConstants);ACG_ENABLED</DefineConstants>
    <DefineConstants Condition="'$(CodeIntegrityGuard)' == 'true'">$(DefineConstants);CIG_ENABLED</DefineConstants>
    <AngleNativeSha256>9B203E40323B49DAD29546A52B8B67D200BBA8FF4CAB9709A79CEDE23BA847D4</AngleNativeSha256>
    <HarfBuzzNativeSha256>874FA400D53CEDAD95390743A02510C1CBED2EC659378805CC5FA4192CD87059</HarfBuzzNativeSha256>
    <SkiaNativeSha256>38ED0F8307E1CCC84A52FFB2216C59A5660721173C81F524249756CF76DBBF54</SkiaNativeSha256>
    <SqliteNativeSha256>4B615E0717F7E12EDC1CF9100AF77130562421423C25E34F24E80FD982F3DE72</SqliteNativeSha256>
  </PropertyGroup>

  <ItemGroup>
    <TrustedNativeDependency Include="av_libglesv2.dll" Sha256="$(AngleNativeSha256)" />
    <TrustedNativeDependency Include="e_sqlite3.dll" Sha256="$(SqliteNativeSha256)" />
    <TrustedNativeDependency Include="libHarfBuzzSharp.dll" Sha256="$(HarfBuzzNativeSha256)" />
    <TrustedNativeDependency Include="libSkiaSharp.dll" Sha256="$(SkiaNativeSha256)" />
  </ItemGroup>

  <Target Name="ValidateTrustedNativeDependencyHashes"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolvePackageAssets"
          Condition="'$(CodeIntegrityGuard)' == 'true'">
    <ItemGroup>
      <_ResolvedTrustedNativeDependency Include="@(NativeCopyLocalItems)"
          Condition="'%(DestinationSubPath)' == 'av_libglesv2.dll' or
                     '%(DestinationSubPath)' == 'e_sqlite3.dll' or
                     '%(DestinationSubPath)' == 'libHarfBuzzSharp.dll' or
                     '%(DestinationSubPath)' == 'libSkiaSharp.dll'" />
    </ItemGroup>
    <Error Condition="@(_ResolvedTrustedNativeDependency-&gt;Count()) != 4"
           Text="Expected four trusted native dependencies, found @(_ResolvedTrustedNativeDependency-&gt;Count())." />
    <GetFileHash Files="@(_ResolvedTrustedNativeDependency)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HashedTrustedNativeDependency" />
    </GetFileHash>
    <Error Condition="'%(_HashedTrustedNativeDependency.DestinationSubPath)' == 'av_libglesv2.dll' and '%(_HashedTrustedNativeDependency.FileHash)' != '$(AngleNativeSha256)'"
           Text="av_libglesv2.dll does not match its baked SHA-256." />
    <Error Condition="'%(_HashedTrustedNativeDependency.DestinationSubPath)' == 'e_sqlite3.dll' and '%(_HashedTrustedNativeDependency.FileHash)' != '$(SqliteNativeSha256)'"
           Text="e_sqlite3.dll does not match its baked SHA-256." />
    <Error Condition="'%(_HashedTrustedNativeDependency.DestinationSubPath)' == 'libHarfBuzzSharp.dll' and '%(_HashedTrustedNativeDependency.FileHash)' != '$(HarfBuzzNativeSha256)'"
           Text="libHarfBuzzSharp.dll does not match its baked SHA-256." />
    <Error Condition="'%(_HashedTrustedNativeDependency.DestinationSubPath)' == 'libSkiaSharp.dll' and '%(_HashedTrustedNativeDependency.FileHash)' != '$(SkiaNativeSha256)'"
           Text="libSkiaSharp.dll does not match its baked SHA-256." />
  </Target>

  <Target Name="ValidateDynamicCodeGuardBuild" BeforeTargets="PrepareForBuild"
          Condition="'$(DynamicCodeGuard)' == 'true' and '$(AotPublish)' != 'true'">
    <Error Text="DynamicCodeGuard requires AotPublish=true." />
  </Target>
  <Target Name="ValidateCodeIntegrityGuardBuild" BeforeTargets="PrepareForBuild"
          Condition="'$(CodeIntegrityGuard)' == 'true' and '$(AotPublish)' != 'true'">
    <Error Text="CodeIntegrityGuard requires AotPublish=true." />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="..\..\docs\release\thisismypc-release-public-keys.asc"
                      LogicalName="ThisIsMyPC.ReleasePublicKeys.asc" />
    <None Include="..\..\assets\fluent-system-icons\LICENSE"
          Link="licenses\FluentSystemIcons.LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\fluent-system-icons\NOTICE"
          Link="licenses\FluentSystemIcons.NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in tweak sets: SetProvider reads AppContext.BaseDirectory\sets at startup -->
    <None Update="sets\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Avalonia adds optional build telemetry transitively. Keep the package
         assetless so its task and collector are never imported or executed. -->
    <PackageReference Include="Avalonia.BuildServices" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- DevTools (F12) is only wired up under #if DEBUG. The reference is not
         conditioned on Configuration: restore writes one assets file per
         project, so a Release restore would strip the package from the next
         Debug build in Visual Studio (missing AttachDevTools). NativeAOT
         trims the unreferenced assembly out of the release. -->
    <PackageReference Include="Avalonia.Diagnostics" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="NLog" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThisIsMyPC.Core\ThisIsMyPC.Core.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Broker\ThisIsMyPC.Broker.csproj"
                      ReferenceOutputAssembly="false" Condition="'$(AotPublish)' != 'true'" />
    <ProjectReference Include="..\ThisIsMyPC.Interop.Win32\ThisIsMyPC.Interop.Win32.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Ipc.Contracts\ThisIsMyPC.Ipc.Contracts.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Modules.Annoyances\ThisIsMyPC.Modules.Annoyances.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Modules.Display\ThisIsMyPC.Modules.Display.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Modules.Privacy\ThisIsMyPC.Modules.Privacy.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Modules.Software\ThisIsMyPC.Modules.Software.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ThisIsMyPC.App.UiTests" />
    <InternalsVisibleTo Include="ThisIsMyPC.Security.Tests" />
    <ProjectReference Include="..\ThisIsMyPC.Modules.Shell\ThisIsMyPC.Modules.Shell.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Modules.Startup\ThisIsMyPC.Modules.Startup.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Modules.Power\ThisIsMyPC.Modules.Power.csproj" />
    <ProjectReference Include="..\ThisIsMyPC.Modules.WindowsUpdate\ThisIsMyPC.Modules.WindowsUpdate.csproj" />
  </ItemGroup>

  <Target Name="CopyPrivilegeBroker" AfterTargets="Build"
          Condition="'$(AotPublish)' != 'true'">
    <ItemGroup>
      <PrivilegeBrokerFiles Include="..\ThisIsMyPC.Broker\bin\$(Configuration)\$(TargetFramework)\ThisIsMyPC.Broker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PrivilegeBrokerFiles)" DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
