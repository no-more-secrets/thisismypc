<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThisIsMyPC.App.Controls.TitleBarControl"
             x:Name="Root"
             Height="64">

    <!-- Custom window frame. The Window extends its client area over the
         system title bar (ExtendClientAreaToDecorationsHint) and hides the
         stock caption buttons (NoChrome), so this control is the whole frame:
         64px tall (two stock title bars). The logo owns the top-left corner:
         48px app icon, name and subtitle, with the icon on the same x as the
         sidebar icons below it. The caption buttons at the right run the full
         bar height like Spotify's and Windows Terminal's, at the stock 46
         width so the hand still lands where Windows trained it. Everything
         else is a drag region; a double-click toggles maximize. CenterContent
         uses the space between the identity and trailing controls. The search
         shrinks before TrailingContent or the caption buttons move off-screen. -->
    <UserControl.Styles>
        <Style Selector="Button.caption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
        </Style>
        <Style Selector="Button.caption PathIcon">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <!-- Close turns Windows red on hover, white glyph, like every stock window -->
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="Button.caption.close:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#B12A1B" />
        </Style>
        <Style Selector="Button.caption.close:pointerover PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*,Auto"
          Background="Transparent"
          PointerPressed="OnDragRegionPressed">

        <!-- Identity: icon, name, subtitle -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <Image Source="avares://ThisIsMyPC.App/Assets/ThisIsMyPC.ico"
                   Width="48" Height="48"
                   VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ThisIsMyPC"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding #Root.Subtitle}"
                           IsVisible="{Binding #Root.Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="11"
                           Margin="0,1,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Centre slot: the star column yields to the fixed identity and trailing controls. -->
        <ContentPresenter x:Name="CenterPresenter"
                          Grid.Column="1"
                          Content="{Binding #Root.CenterContent}"
                          MinWidth="0"
                          Margin="16,0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          VerticalAlignment="Center"
                          ClipToBounds="True"
                          SizeChanged="OnCenterPresenterSizeChanged" />

        <!-- Trailing slot, then the caption buttons, full height, right -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <ContentPresenter Content="{Binding #Root.TrailingContent}"
                              IsVisible="{Binding #Root.TrailingContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
            <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="Minimize"
                    AutomationProperties.Name="Minimize">
                <PathIcon Data="M0,5H10V6H0Z" />
            </Button>
            <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximizeClick"
                    ToolTip.Tip="Maximize"
                    AutomationProperties.Name="Maximize">
                <Panel>
                    <!-- Single square: maximize -->
                    <PathIcon x:Name="MaximizeGlyph" Data="M0,0H10V10H0Z M1,1V9H9V1Z" />
                    <!-- Two offset squares: restore -->
                    <PathIcon x:Name="RestoreGlyph" IsVisible="False"
                              Data="M2,0H10V8H8V2H2Z M0,2H8V10H0Z M1,3V9H7V3Z" />
                </Panel>
            </Button>
            <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="Close"
                    AutomationProperties.Name="Close">
                <PathIcon Data="M0,0.7L0.7,0L5,4.3L9.3,0L10,0.7L5.7,5L10,9.3L9.3,10L5,5.7L0.7,10L0,9.3L4.3,5Z" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
