<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             x:Class="ThisIsMyPC.App.Controls.SettingCardControl"
             x:DataType="vm:SettingCardViewModel">

    <!-- Card renderer (Epic 10). One control, visual states; never four templates.
         Display modes (10-2) drive IsDescriptionVisible / IsRegistryDataVisible;
         enforcement badges and Owner Mode degradation arrive in 10-3. -->
    <Border Padding="16,12"
            Margin="0,2"
            CornerRadius="6"
            Classes="card"
            Classes.pending-enable="{Binding IsPendingEnable}"
            Classes.pending-disable="{Binding IsPendingDisable}">
        <DockPanel>
            <!-- Control docked right; Toggle is the only interactive type for now.
                 Owner Mode degradation disables ONLY the control (10-3). -->
            <ToggleSwitch DockPanel.Dock="Right"
                          IsChecked="{Binding IsEnabled}"
                          IsVisible="{Binding IsToggle}"
                          IsEnabled="{Binding IsControlEnabled}"
                          VerticalAlignment="Top"
                          Margin="16,0,0,0" />

            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Classes="info-icon" ToolTip.Tip="{Binding Description}">
                        <TextBlock Classes="info-icon-glyph" />
                    </Border>
                </StackPanel>

                <!-- Badges & callouts (10-3); visible in EVERY display mode;
                     safety-critical information is never hidden by display preference -->
                <StackPanel Spacing="2">
                    <Border Background="{DynamicResource WarningMutedBrush}"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding HasEnforcementBadge}">
                        <TextBlock Text="{Binding EnforcementSummary}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                    <TextBlock Text="{Binding ReversionRisksText}"
                               FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasReversionRisks}" />
                    <TextBlock Text="{Binding SkuNotice}"
                               FontSize="11"
                               Foreground="{DynamicResource InfoBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasSkuNotice}" />
                    <TextBlock Text="{Binding OwnerModeCallout}"
                               FontSize="11"
                               Foreground="{DynamicResource InfoBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsOwnerModeDegraded}" />
                    <Border Background="{DynamicResource InfoMutedBrush}"
                            CornerRadius="3"
                            Padding="6,1"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding ShowOwnerModeBadge}">
                        <TextBlock Text="Owner Mode"
                                   FontSize="11"
                                   Foreground="{DynamicResource InfoBrush}" />
                    </Border>
                </StackPanel>

                <!-- Affected system component; visible in every display mode -->
                <TextBlock Text="{Binding SystemPath}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding SystemPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Registry data (10-2 Registry Data mode; hidden by default) -->
                <StackPanel Spacing="1"
                            Margin="0,4,0,0"
                            IsVisible="{Binding IsRegistryDataVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Model.RegistryValueType}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding Model.CurrentDisplayValue}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
