<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:controls="using:ThisIsMyPC.App.Controls"
             x:Class="ThisIsMyPC.App.Controls.SettingCardControl"
             x:DataType="vm:SettingCardViewModel">

    <!-- Card renderer: a ToggleCard whose content carries the description,
         the badges and callouts, and the technical details. What the setting
         does and the switch are always on the card; the registry path, value
         type, and last reading sit behind the card's own link, which the
         page's Technical details toggle opens on every card at once. Badges
         show in every mode: safety information is never hidden by a display
         preference. Owner Mode degradation disables only the switch. -->
    <controls:ToggleCard Title="{Binding DisplayName}"
                         Description="{Binding TooltipDescription}"
                         IsOn="{Binding IsEnabled}"
                         IsSwitchVisible="{Binding IsToggle}"
                         IsSwitchEnabled="{Binding IsControlEnabled}"
                         Classes.pending-enable="{Binding IsPendingEnable}"
                         Classes.pending-disable="{Binding IsPendingDisable}">
        <StackPanel Spacing="2">
            <TextBlock Text="{Binding Description}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       IsVisible="{Binding IsDescriptionVisible}" />
            <Border Background="{DynamicResource WarningMutedBrush}"
                    CornerRadius="3"
                    Padding="6,1"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding HasEnforcementBadge}">
                <TextBlock Text="{Binding EnforcementSummary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}" />
            </Border>
            <TextBlock Text="{Binding ReversionRisksText}"
                       FontSize="11"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasReversionRisks}" />
            <TextBlock Text="{Binding SkuNotice}"
                       FontSize="11"
                       Foreground="{DynamicResource InfoBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasSkuNotice}" />
            <StackPanel Spacing="4" IsVisible="{Binding IsOwnerModeDegraded}">
                <TextBlock Text="{Binding OwnerModeCallout}"
                           FontSize="11"
                           Foreground="{DynamicResource InfoBrush}"
                           TextWrapping="Wrap" />
                <Button Content="Turn on Owner Mode"
                        FontSize="11"
                        Padding="8,3"
                        HorizontalAlignment="Left"
                        Command="{Binding TurnOnOwnerModeCommand}"
                        IsVisible="{Binding CanTurnOnOwnerMode}" />
                <TextBlock Text="{Binding OwnerModeError}"
                           FontSize="11"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding OwnerModeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Border Background="{DynamicResource InfoMutedBrush}"
                    CornerRadius="3"
                    Padding="6,1"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding ShowOwnerModeBadge}">
                <TextBlock Text="Owner Mode"
                           FontSize="11"
                           Foreground="{DynamicResource InfoBrush}" />
            </Border>
            <!-- Technical details: closed by default -->
            <StackPanel Spacing="1"
                        Margin="0,2,0,0"
                        IsVisible="{Binding IsRegistryDataVisible}">
                <TextBlock Text="{Binding WrappableSystemPath}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding TechnicalStateText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
            <Button Classes="card-link"
                    Content="{Binding DetailsLinkText}"
                    Command="{Binding ToggleTechnicalDetailsCommand}"
                    IsVisible="{Binding HasTechnicalDetails}" />
        </StackPanel>
    </controls:ToggleCard>
</UserControl>
