<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThisIsMyPC.App.ViewModels"
             xmlns:controls="using:ThisIsMyPC.App.Controls"
             x:Class="ThisIsMyPC.App.Controls.SettingCardControl"
             x:DataType="vm:SettingCardViewModel">

    <!-- Card renderer: a ToggleCard whose (i) carries the description, like
         every other module's card, with the badges, callouts, and technical
         details in the content slot. The safety callouts (SKU, Owner Mode
         degradation) show in every mode. Compact folds the informational
         lines (how it is applied, what may revert it) into the tooltip;
         Technical details is a page-wide box, with no per-card link. Owner
         Mode degradation disables only the switch. -->
    <controls:ToggleCard Title="{Binding DisplayName}"
                         Description="{Binding TooltipText}"
                         IsOn="{Binding IsEnabled}"
                         IsSwitchVisible="{Binding IsToggle}"
                         IsSwitchEnabled="{Binding IsControlEnabled}"
                         Classes.pending-enable="{Binding IsPendingEnable}"
                         Classes.pending-disable="{Binding IsPendingDisable}">
        <StackPanel Spacing="2" IsVisible="{Binding HasVisibleContent}">
            <Border Background="{DynamicResource WarningMutedBrush}"
                    CornerRadius="3"
                    Padding="6,1"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding ShowEnforcementBadge}">
                <TextBlock Text="{Binding EnforcementSummary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}" />
            </Border>
            <TextBlock Text="{Binding ReversionRisksText}"
                       FontSize="11"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ShowReversionRisks}" />
            <TextBlock Text="{Binding SkuNotice}"
                       FontSize="11"
                       Foreground="{DynamicResource InfoBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasSkuNotice}" />
            <StackPanel Spacing="4" IsVisible="{Binding IsOwnerModeDegraded}">
                <TextBlock Text="{Binding OwnerModeCallout}"
                           FontSize="11"
                           Foreground="{DynamicResource InfoBrush}"
                           TextWrapping="Wrap" />
                <Button Content="Turn on Owner Mode"
                        FontSize="11"
                        Padding="8,3"
                        HorizontalAlignment="Left"
                        Command="{Binding TurnOnOwnerModeCommand}"
                        IsVisible="{Binding CanTurnOnOwnerMode}" />
                <TextBlock Text="{Binding OwnerModeError}"
                           FontSize="11"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding OwnerModeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Border Background="{DynamicResource InfoMutedBrush}"
                    CornerRadius="3"
                    Padding="6,1"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding ShowOwnerModeBadge}">
                <TextBlock Text="Owner Mode"
                           FontSize="11"
                           Foreground="{DynamicResource InfoBrush}" />
            </Border>
            <!-- Technical details: closed by default -->
            <StackPanel Spacing="1"
                        Margin="0,2,0,0"
                        IsVisible="{Binding IsRegistryDataVisible}">
                <TextBlock Text="{Binding WrappableSystemPath}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding TechnicalStateText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </StackPanel>
    </controls:ToggleCard>
</UserControl>
