<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ThisIsMyPC.App.Controls">

    <!-- ToggleCard: the shared card-with-a-switch. Surface fill, outline,
         14px semibold title with an (i) tooltip, content slot, monospace
         detail line, switch docked right. Pending and inactive classes set
         on the card reach the border here. The content slot takes part in
         the 2px stack spacing, so a consumer hides its panel when every
         line in it is hidden. -->
    <ControlTheme x:Key="{x:Type controls:ToggleCard}" TargetType="controls:ToggleCard">
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Card"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <ToggleSwitch Name="PART_Switch"
                                      DockPanel.Dock="Right"
                                      IsChecked="{TemplateBinding IsOn, Mode=TwoWay}"
                                      IsEnabled="{TemplateBinding IsSwitchEnabled}"
                                      IsVisible="{TemplateBinding IsSwitchVisible}"
                                      Command="{TemplateBinding Command}"
                                      OnContent="{x:Null}" OffContent="{x:Null}"
                                      MinHeight="0" MinWidth="0"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0" />
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <!-- Star column so a long title trims instead of
                                 running under the switch; left-aligned so the
                                 (i) sits right after a short title. -->
                            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border Grid.Column="1"
                                        Classes="info-icon"
                                        Margin="6,0,0,0"
                                        ToolTip.Tip="{TemplateBinding Description}"
                                        IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Classes="info-icon-glyph" />
                                </Border>
                            </Grid>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{TemplateBinding Detail}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{TemplateBinding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.pending-enable /template/ Border#PART_Card">
            <Setter Property="Background" Value="{DynamicResource SuccessMutedBrush}" />
        </Style>
        <Style Selector="^.pending-disable /template/ Border#PART_Card">
            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
        </Style>
        <Style Selector="^.pending-modify /template/ Border#PART_Card">
            <Setter Property="Background" Value="{DynamicResource WarningMutedBrush}" />
        </Style>
        <Style Selector="^.inactive">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
