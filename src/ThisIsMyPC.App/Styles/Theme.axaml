<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Palette for both theme variants. Every key exists in both dictionaries;
      consumers reference them with DynamicResource so the running app restyles
      when Application.RequestedThemeVariant changes.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Accent -->
            <Color x:Key="AccentColor">#5b8dd9</Color>
            <Color x:Key="AccentColorLight">#4a78c0</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

            <!-- Background tiers -->
            <Color x:Key="BaseColor">#1a1a2e</Color>
            <Color x:Key="RaisedColor">#242438</Color>
            <Color x:Key="SurfaceColor">#2d2d42</Color>
            <Color x:Key="OverlayColor">#383850</Color>
            <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}" />
            <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

            <!-- Sidebar -->
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource RaisedColor}" />
            <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#3a3a55" />
            <SolidColorBrush x:Key="SidebarItemActiveBrush" Color="#3d5a80" />
            <SolidColorBrush x:Key="SidebarGroupHeaderBrush" Color="#8888aa" />
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="#2a2a3e" />

            <!-- Semantic -->
            <Color x:Key="SuccessColor">#4caf50</Color>
            <Color x:Key="SuccessMutedColor">#2d4a2e</Color>
            <Color x:Key="WarningColor">#ffb74d</Color>
            <Color x:Key="WarningMutedColor">#4a3a1e</Color>
            <Color x:Key="DangerColor">#ef5350</Color>
            <Color x:Key="DangerMutedColor">#4a2020</Color>
            <Color x:Key="InfoColor">#29b6f6</Color>
            <Color x:Key="InfoMutedColor">#1e3a4a</Color>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="SuccessMutedBrush" Color="{StaticResource SuccessMutedColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="WarningMutedBrush" Color="{StaticResource WarningMutedColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="DangerMutedBrush" Color="{StaticResource DangerMutedColor}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
            <SolidColorBrush x:Key="InfoMutedBrush" Color="{StaticResource InfoMutedColor}" />

            <!-- Scope badges (Multi tab); badge text uses TextPrimaryBrush -->
            <SolidColorBrush x:Key="ScopeBadgeFileBrush" Color="#2e5984" />
            <SolidColorBrush x:Key="ScopeBadgeFolderBrush" Color="#2e7854" />
            <SolidColorBrush x:Key="ScopeBadgeBackgroundBrush" Color="#6e5a2e" />
            <SolidColorBrush x:Key="ScopeBadgeDesktopBrush" Color="#5a2e6e" />
            <SolidColorBrush x:Key="ScopeBadgeMiscBrush" Color="#4a4a5e" />

            <!-- Text (alpha channel adapts across background tiers) -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#66FFFFFF" />

            <!-- Subtle full-width row hover -->
            <SolidColorBrush x:Key="RowHoverBrush" Color="#08FFFFFF" />

            <!-- Interaction system: one hover/press/outline family for every
                 clickable. Rest = Overlay, hover = ControlHover, press =
                 ControlPressed; accent-filled controls darken through
                 AccentHover/AccentPressed. -->
            <SolidColorBrush x:Key="OutlineBrush" Color="#3f3f5a" />
            <SolidColorBrush x:Key="OutlineStrongBrush" Color="#56567c" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#42425e" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#4c4c6a" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#3f68a8" />

            <!-- Fluent resource-key overrides: stock Button/ToggleButton/
                 ComboBox/TextBox/ToggleSwitch read these, so their states come
                 from the same tokens as the custom classes. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource OverlayColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#42425e" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4c4c6a" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource OverlayColor}" Opacity="0.5" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3f3f5a" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#56567c" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#56567c" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#3f3f5a" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="{StaticResource OverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#42425e" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#4c4c6a" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#3f68a8" />
            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#3f3f5a" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#56567c" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3f3f5a" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#56567c" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource OverlayColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#42425e" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#4c4c6a" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3f3f5a" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#56567c" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#56567c" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#3f68a8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#3f68a8" />

            <!-- Selected tab: accent pipe + full-strength label -->
            <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#FFFFFF" />

            <!-- Slider thumb stays accent through hover and press (stock
                 Fluent fades it to a low-contrast gray when grabbed) -->
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#3f68a8" />

            <!-- Slider body styled like a button: solid fill at rest, full
                 hover wash, solid grey when disabled (no ghost outlines) -->
            <SolidColorBrush x:Key="SliderContainerBackground" Color="{StaticResource OverlayColor}" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="#42425e" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="#4c4c6a" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#56567c" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#56567c" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#56567c" />
            <!-- Value fill in the app accent; stock Fluent uses the Windows
                 system accent, which clashes with the theme -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3f68a8" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Accent (darker than the dark variant's for contrast on white) -->
            <Color x:Key="AccentColor">#3a6bbf</Color>
            <Color x:Key="AccentColorLight">#2f5aa8</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

            <!-- Background tiers -->
            <Color x:Key="BaseColor">#f2f3f8</Color>
            <Color x:Key="RaisedColor">#e8eaf1</Color>
            <Color x:Key="SurfaceColor">#ffffff</Color>
            <Color x:Key="OverlayColor">#dfe2ec</Color>
            <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}" />
            <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

            <!-- Sidebar -->
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource RaisedColor}" />
            <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#dde0ea" />
            <SolidColorBrush x:Key="SidebarItemActiveBrush" Color="#c9d9f0" />
            <SolidColorBrush x:Key="SidebarGroupHeaderBrush" Color="#6a6f88" />
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="#d5d8e2" />

            <!-- Semantic (text-weight colors darkened for white surfaces) -->
            <Color x:Key="SuccessColor">#2e7d32</Color>
            <Color x:Key="SuccessMutedColor">#d8ecd9</Color>
            <Color x:Key="WarningColor">#9a6700</Color>
            <Color x:Key="WarningMutedColor">#f3e8cd</Color>
            <Color x:Key="DangerColor">#c62828</Color>
            <Color x:Key="DangerMutedColor">#f3d9d9</Color>
            <Color x:Key="InfoColor">#0277bd</Color>
            <Color x:Key="InfoMutedColor">#d7e9f5</Color>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="SuccessMutedBrush" Color="{StaticResource SuccessMutedColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="WarningMutedBrush" Color="{StaticResource WarningMutedColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="DangerMutedBrush" Color="{StaticResource DangerMutedColor}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
            <SolidColorBrush x:Key="InfoMutedBrush" Color="{StaticResource InfoMutedColor}" />

            <!-- Scope badges: pastel tints so near-black badge text stays readable -->
            <SolidColorBrush x:Key="ScopeBadgeFileBrush" Color="#c9dcf3" />
            <SolidColorBrush x:Key="ScopeBadgeFolderBrush" Color="#c9e8d8" />
            <SolidColorBrush x:Key="ScopeBadgeBackgroundBrush" Color="#ecdfb9" />
            <SolidColorBrush x:Key="ScopeBadgeDesktopBrush" Color="#e3cdef" />
            <SolidColorBrush x:Key="ScopeBadgeMiscBrush" Color="#d9d9e3" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E014142A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A614142A" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7A14142A" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#5214142A" />

            <!-- Subtle full-width row hover -->
            <SolidColorBrush x:Key="RowHoverBrush" Color="#0A000000" />

            <!-- Interaction system (see the Dark dictionary's comment) -->
            <SolidColorBrush x:Key="OutlineBrush" Color="#d0d4e0" />
            <SolidColorBrush x:Key="OutlineStrongBrush" Color="#b0b6c8" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#d6dae6" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#c9cedd" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#274b8f" />

            <!-- Fluent resource-key overrides -->
            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource OverlayColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#d6dae6" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#c9cedd" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource OverlayColor}" Opacity="0.5" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#E014142A" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E014142A" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E014142A" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5214142A" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#d0d4e0" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#b0b6c8" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#b0b6c8" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#d0d4e0" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="{StaticResource OverlayColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#d6dae6" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#c9cedd" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#274b8f" />
            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#E014142A" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#d0d4e0" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#b0b6c8" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#d0d4e0" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#b0b6c8" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource OverlayColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#d6dae6" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#c9cedd" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#d0d4e0" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#b0b6c8" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#b0b6c8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#274b8f" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#274b8f" />

            <!-- Selected tab: accent pipe + full-strength label -->
            <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#E014142A" />

            <!-- Slider thumb stays accent through hover and press (stock
                 Fluent fades it to a low-contrast gray when grabbed) -->
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#274b8f" />

            <!-- Slider body styled like a button: solid fill at rest, full
                 hover wash, solid grey when disabled (no ghost outlines) -->
            <SolidColorBrush x:Key="SliderContainerBackground" Color="{StaticResource OverlayColor}" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="#d6dae6" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="#c9cedd" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#b0b6c8" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#b0b6c8" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#b0b6c8" />
            <!-- Value fill in the app accent; stock Fluent uses the Windows
                 system accent, which clashes with the theme -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#274b8f" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared: uniform rounding for every stock control -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
</ResourceDictionary>
