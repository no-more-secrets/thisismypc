<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Interaction baseline: every clickable gets a hand cursor. Colors and
         hover/press states come from the Fluent resource-key overrides in
         Theme.axaml, so stock controls and custom classes share one system. -->
    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- One press motion for every pressable: the whole control shrinks
         about its center by the same percentage (stock Fluent scales Buttons
         but not ToggleButtons, so chips and buttons moved differently). -->
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="ToggleButton:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="ComboBox:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="ToggleSwitch:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Tabs share the page edge geometry: stock Fluent pads the tab content
         area 12px per side, which pushed tab pages' scrollbars out of the
         shared lane and indented their content relative to every other page.
         Headers lose their built-in side padding for the same reason (the
         first header sits flush with page content); the margin keeps the
         24px rhythm between headers. -->
    <!-- Tab strips and headers: TabStripTheme.axaml (one definition, so a
         view writes Header="Name" and nothing else). -->

    <!-- Sliders: hand cursor and a thumb that grows toward the pointer.
         Wheel-to-adjust is wired per view (DisplayView) because it must win
         over the page's ScrollViewer. The body carries a button-style
         outline and hover wash (fills come from the SliderContainer*
         resources in Theme.axaml). -->
    <Style Selector="Slider">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Slider:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}" />
    </Style>
    <Style Selector="Slider:disabled">
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    </Style>
    <!-- The container grid has square corners; without clipping they poke
         past the rounded border as light slivers at the edges. -->
    <Style Selector="Slider /template/ Border">
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Slider:pointerover /template/ Thumb">
        <Setter Property="RenderTransform" Value="scale(1.15)" />
    </Style>

    <!-- Info icon: a small circled i whose tooltip carries the full
         description, so rows and cards can stay one line tall. -->
    <Style Selector="Border.info-icon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="ToolTip.ShowDelay" Value="150" />
    </Style>
    <Style Selector="Border.info-icon:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.info-icon-glyph">
        <Setter Property="Text" Value="i" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Border.info-icon:pointerover TextBlock.info-icon-glyph">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Loading indicators fill with the app accent, not Fluent gray -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Standard content card: surface fill plus the universal outline -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Sidebar module item button -->
    <Style Selector="Button.sidebar-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.sidebar-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
    </Style>

    <Style Selector="Button.sidebar-item:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>

    <Style Selector="Button.sidebar-item.active">
        <Setter Property="Background" Value="{DynamicResource SidebarItemActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.sidebar-item.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarItemActiveBrush}" />
    </Style>

    <Style Selector="Button.sidebar-item.unavailable">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Sidebar group header -->
    <Style Selector="TextBlock.sidebar-group-header">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarGroupHeaderBrush}" />
        <Setter Property="Margin" Value="15,16,0,4" />
        <Setter Property="LetterSpacing" Value="1.5" />
    </Style>

    <!-- Sidebar toggle button -->
    <Style Selector="Button.sidebar-toggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.sidebar-toggle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
    </Style>

    <Style Selector="Button.sidebar-toggle:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>

    <!-- Apply bar: Pending count button (transparent, clickable) -->
    <Style Selector="Button.apply-bar-count">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.apply-bar-count /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.apply-bar-count:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>

    <Style Selector="Button.apply-bar-count:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>

    <!-- Accent-filled buttons (Apply, Create, Migrate): the accent fill with
         the AccentOutline rim every other accent-filled control wears.
         "accent" and "apply-bar-apply" are the same look. -->
    <Style Selector="Button.apply-bar-apply, Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.apply-bar-apply:disabled, Button.accent:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Button.apply-bar-apply:pointerover /template/ ContentPresenter, Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.apply-bar-apply:pressed /template/ ContentPresenter, Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Apply bar: Discard button -->
    <Style Selector="Button.apply-bar-discard">
        <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.apply-bar-discard:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Button.apply-bar-discard:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}" />
    </Style>

    <Style Selector="Button.apply-bar-discard:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>

    <!-- Every apply-bar button is one height, badge or not, and pads only
         sideways: the content gets the full 36px, so no font size clips a
         descender. Declared after both button styles so it wins. -->
    <Style Selector="Button.apply-bar-apply, Button.apply-bar-discard">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Rows of a dropdown flyout: full width, text at the left, hover wash only. -->
    <Style Selector="Button.flyout-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.flyout-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Button.flyout-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>
    <!-- Dividers inside dropdowns share the outline colour -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource OutlineBrush}" />
    </Style>

    <!-- A button whose one-way action is staged (Delete -> Queued): red, so
         the staged state reads at a glance; clicking again unstages. -->
    <Style Selector="Button.queued">
        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.queued:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Dense list row (Startup & Services): one line, a hairline under it,
         no card chrome. Autoruns' colors tint the row: yellow for a missing
         file, red for no verified signer. Declared before the pending tints
         so a queued flip wins the background. -->
    <Style Selector="Border.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- The 3px bar at the row's left edge: its own element, so the row's
         hairline keeps the outline colour when the bar lights up. -->
    <Style Selector="Border.row-bar">
        <Setter Property="Width" Value="3" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.missing">
        <Setter Property="Background" Value="{DynamicResource WarningMutedBrush}" />
    </Style>
    <Style Selector="Border.row.unverified">
        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
    </Style>

    <!-- Pending state tinting: enable/create (green-ish) -->
    <Style Selector="Border.pending-enable">
        <Setter Property="Background" Value="{DynamicResource SuccessMutedBrush}" />
    </Style>

    <!-- Pending state tinting: disable/delete (red-ish, slightly more prominent) -->
    <Style Selector="Border.pending-disable">
        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
    </Style>

    <!-- Pending state tinting: modify (neutral warning) -->
    <Style Selector="Border.pending-modify">
        <Setter Property="Background" Value="{DynamicResource WarningMutedBrush}" />
    </Style>

    <!-- A queued flip on a row also lights the bar at the left, so it reads
         on a row that is already red (unverified) or yellow (missing). -->
    <Style Selector="Border.row.pending-enable Border.row-bar">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.row.pending-disable Border.row-bar">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Inactive handler: dimmed appearance -->
    <Style Selector="Border.inactive">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- Notification bar: restart (amber warning) -->
    <Style Selector="Border.notification-restart">
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.notification-restart">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <!-- Notification bar: refresh (green success; softer than restart) -->
    <Style Selector="Border.notification-refresh">
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.notification-refresh">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <!-- Status bar text; class picked by MainWindowViewModel.StatusSeverity -->
    <Style Selector="TextBlock.status-success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.status-warning">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.status-error">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Toolbar toggles (Registry Data / Compact / Registry view): app chrome
         instead of stock Fluent, so both themes get deliberate contrast and an
         unmistakable checked state. -->
    <Style Selector="ToggleButton.toolbar-toggle">
        <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ToggleButton.toolbar-toggle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolbar-toggle:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolbar-toggle:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.toolbar-toggle:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.toolbar-toggle:checked:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Multi tab scope badges; kind class picks the tint -->
    <Style Selector="Border.scope-badge">
        <Setter Property="Background" Value="{DynamicResource ScopeBadgeMiscBrush}" />
    </Style>
    <Style Selector="Border.scope-badge.file">
        <Setter Property="Background" Value="{DynamicResource ScopeBadgeFileBrush}" />
    </Style>
    <Style Selector="Border.scope-badge.folder">
        <Setter Property="Background" Value="{DynamicResource ScopeBadgeFolderBrush}" />
    </Style>
    <Style Selector="Border.scope-badge.background">
        <Setter Property="Background" Value="{DynamicResource ScopeBadgeBackgroundBrush}" />
    </Style>
    <Style Selector="Border.scope-badge.desktop">
        <Setter Property="Background" Value="{DynamicResource ScopeBadgeDesktopBrush}" />
    </Style>
</Styles>
