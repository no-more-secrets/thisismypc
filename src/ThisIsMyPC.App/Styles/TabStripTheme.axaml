<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ThisIsMyPC.App.Controls">

    <!-- The tab strip: a sunken well (darker than the page, near the window
         navy) holding the header chips in justified rows, so every row runs
         the well's full width. The well ends 16px short of the page edge,
         the same edge a search box or toolbar above it uses; the selected
         content below keeps the full width (its scrollbar lane needs it).
         The well's top edge is the strip's first pixel, so a tab page's
         TabControl still carries Margin="0,4,0,0" and nothing else.

         Browser-style tabs: the well has a bottom rim, covered only by the selected tab.
         An unselected chip floats 6px clear of the well's floor (its own
         bottom margin); the selected chip reaches 1px past the floor and
         paints the page's own fill over the well's floor, so it
         reads as part of the content below. Selecting a tab moves nothing:
         every chip keeps its size, place, border, and presenter. The
         selected chrome extends below that unchanged layout, and rows
         are never reordered, so only the selection look changes.
         RowGap is zero because each floating tab already supplies 6px below it.
         The bottom rim occupies one pixel. Height stays 42:
         1 + 6 + 34 + 1 (the row is a 28 chip plus its 6 float). -->
    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <controls:JustifiedWrapPanel Gap="6"
                                               RowGap="0"
                                               PlaceSelectedRowLast="False" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border Name="PART_Strip"
                            DockPanel.Dock="Top"
                            Background="{DynamicResource SunkenBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6,6,6,0"
                            Margin="0,0,16,0">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <ContentPresenter Name="PART_SelectedContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Opt-in for a page hosted without outer padding. The strip owns the
         whole top edge; selected content restores the normal content margins. -->
    <ControlTheme x:Key="EdgeTabControlTheme" TargetType="TabControl"
                  BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Padding" Value="24,16,6,24" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border Name="PART_Strip" DockPanel.Dock="Top"
                            Background="{DynamicResource SunkenBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0"
                            Padding="6,7,6,0">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <ContentPresenter Name="PART_SelectedContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Opt-in for a page hosted without outer padding. The strip owns the
         whole top edge; selected content restores the normal content margins. -->
    <ControlTheme x:Key="ModuleTabControlTheme" TargetType="controls:ModuleTabControl"
                  BasedOn="{StaticResource EdgeTabControlTheme}">
        <Setter Property="Padding" Value="24,16,6,24" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border Name="PART_Strip" DockPanel.Dock="Top" IsVisible="{TemplateBinding ShowTabs}"
                            Background="{DynamicResource SunkenBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0"
                            Padding="6,7,6,0">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <DockPanel Margin="{TemplateBinding Padding}">
                        <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding Toolbar}" />
                        <Panel>
                            <ContentPresenter Name="PART_SelectedContentHost"
                                              IsVisible="{TemplateBinding ShowTabs}"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <ContentPresenter Content="{TemplateBinding AlternateContent}"
                                              IsVisible="{ReflectionBinding !ShowTabs, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Panel>
                    </DockPanel>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Tab header as a browser tab. Unselected: a dim chip floating in the
         well (no fill, the shared outline, 13px secondary text, 6px above
         the floor); hover lifts it to the control hover wash and primary
         text. Selected: the page's Raised fill with curved bottom joins,
         no bottom border, and a 1px overhang that covers the well's bottom
         edge, so the outline runs from the chip's sides straight into the
         content. The chrome extends 7px below the unchanged header layout.
         No accent anywhere: the connection is the cue.
         The panel spaces the chips; a chip's only margin is its float. -->
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ClipToBounds="False">
                    <controls:SelectedTabChrome Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Margin="0,0,0,-7"
                                                IsVisible="{TemplateBinding IsSelected}"
                                                IsHitTestVisible="False" />
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        </Style>
        <!-- One border and presenter geometry in both states. Changing templates
             made fractional-DPI border rounding move every label in the row. -->
        <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
