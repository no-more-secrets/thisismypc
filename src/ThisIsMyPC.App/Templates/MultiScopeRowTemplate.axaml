<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:ThisIsMyPC.App.ViewModels"
                    xmlns:controls="using:ThisIsMyPC.App.Controls">

    <!-- Row template for the Multi tab: a ToggleCard whose content shows the
         scope badges (which surfaces the handler touches) and the handler's
         notes. Typed for compiled bindings; reflection bindings are the one
         thing NativeAOT trimming can silently break. -->
    <DataTemplate x:Key="MultiScopeRowTemplate" x:DataType="vm:ContextMenuHandlerViewModel">
        <controls:ToggleCard Title="{Binding Label}"
                             Detail="{Binding SystemPath}"
                             IsOn="{Binding IsEnabled}"
                             IsSwitchEnabled="{Binding IsToggleEnabled}"
                             IsVisible="{Binding IsSearchVisible, FallbackValue=True}"
                             Classes.inactive="{Binding IsInactive, FallbackValue=False}"
                             Classes.pending-enable="{Binding IsPendingEnable}"
                             Classes.pending-disable="{Binding IsPendingDisable}">
            <StackPanel Spacing="4" Margin="0,2,0,0">
                <ItemsControl ItemsSource="{Binding ScopeBadges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScopeBadge">
                            <Border Padding="8,3"
                                    Margin="0,0,6,0"
                                    CornerRadius="4"
                                    Classes="scope-badge"
                                    Classes.file="{Binding IsFile}"
                                    Classes.folder="{Binding IsFolder}"
                                    Classes.background="{Binding IsBackground}"
                                    Classes.desktop="{Binding IsDesktop}"
                                    Classes.misc="{Binding IsMisc}">
                                <TextBlock Text="{Binding Label}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding InactiveReason, FallbackValue=''}"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           IsVisible="{Binding InactiveReason, FallbackValue='', Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding WarningText}"
                           FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding WarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </controls:ToggleCard>
    </DataTemplate>

</ResourceDictionary>
