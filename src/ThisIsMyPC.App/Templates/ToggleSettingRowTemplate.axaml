<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:ThisIsMyPC.App.ViewModels"
                    xmlns:controls="using:ThisIsMyPC.App.Controls">

    <!-- Reusable toggle setting row for module controls: a ToggleCard whose
         content slot carries the optional inactive reason, warning, disable
         method, and migrate button. Typed against IToggleSettingRow so
         bindings compile (NativeAOT trimming can silently break reflection
         bindings); rows that do not use the optional members return
         constants that hide those parts. -->
    <DataTemplate x:Key="ToggleSettingRowTemplate" x:DataType="vm:IToggleSettingRow">
        <controls:ToggleCard Title="{Binding Label}"
                             Description="{Binding Description}"
                             IsOn="{Binding IsEnabled}"
                             IsSwitchEnabled="{Binding IsToggleEnabled}"
                             IsVisible="{Binding IsSearchVisible}"
                             Classes.inactive="{Binding IsInactive}"
                             Classes.pending-enable="{Binding IsPendingEnable}"
                             Classes.pending-disable="{Binding IsPendingDisable}">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding InactiveReason}"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           IsVisible="{Binding InactiveReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding WarningText}"
                           FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding WarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding DisableMethodText}"
                           FontSize="11"
                           Foreground="{DynamicResource WarningBrush}"
                           IsVisible="{Binding DisableMethodText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Content="Migrate to Blocked List"
                        Command="{Binding MigrateCommand}"
                        IsVisible="{Binding CanMigrate}"
                        FontSize="11"
                        Padding="6,2"
                        Margin="0,2,0,0"
                        Classes="accent" />
            </StackPanel>
        </controls:ToggleCard>
    </DataTemplate>

</ResourceDictionary>
