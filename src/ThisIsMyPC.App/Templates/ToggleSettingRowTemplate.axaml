<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:CompileBindings="False">

    <!-- Reusable toggle setting row template for module controls.
         Expected DataContext properties (required):
           - string Label: Setting name
           - string Description: What the setting does
           - bool IsEnabled: Current toggle state
         Optional properties (used by context menu handlers, hidden when absent):
           - bool IsPendingEnable / IsPendingDisable: Pending state visual indicators
           - string WarningText: Warning for critical/system handlers
           - string DisableMethodText: Disable method indicator
           - bool CanMigrate: Shows "Migrate to Blocked List" button
           - ICommand MigrateCommand: Migration action
           - bool IsInactive / string InactiveReason: Dimmed with explanation
         Note: Compiled bindings are disabled here because this template is generic.
         FallbackValue is set on optional bindings to suppress binding errors. -->

    <DataTemplate x:Key="ToggleSettingRowTemplate">
        <Border Padding="16,8"
                Margin="0,2"
                CornerRadius="6"
                Classes="card"
                IsVisible="{Binding IsSearchVisible, FallbackValue=True}"
                Classes.inactive="{Binding IsInactive, FallbackValue=False}"
                Classes.pending-enable="{Binding IsPendingEnable}"
                Classes.pending-disable="{Binding IsPendingDisable}">
            <DockPanel>
                <!-- Toggle switch on the right -->
                <ToggleSwitch DockPanel.Dock="Right"
                              IsChecked="{Binding IsEnabled}"
                              IsEnabled="{Binding IsToggleEnabled, FallbackValue=True}"
                              VerticalAlignment="Top"
                              Margin="16,0,0,0" />

                <!-- Setting info on the left -->
                <StackPanel Spacing="2">
                    <!-- Label + info icon carrying the full description -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Label}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Classes="info-icon"
                                ToolTip.Tip="{Binding Description}"
                                IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="info-icon-glyph" />
                        </Border>
                    </StackPanel>

                    <!-- One-line description; the info icon holds the rest -->
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Inactive reason (shown instead of warning for inactive entries) -->
                    <TextBlock Text="{Binding InactiveReason, FallbackValue=''}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               IsVisible="{Binding InactiveReason, FallbackValue={x:False}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Warning text (Critical/System handlers; hidden when inactive) -->
                    <TextBlock Text="{Binding WarningText}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding WarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Disable method info + migrate action (context menu handlers only) -->
                    <TextBlock Text="{Binding DisableMethodText, FallbackValue=''}"
                               FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               IsVisible="{Binding DisableMethodText, FallbackValue={x:False}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Content="Migrate to Blocked List"
                            Command="{Binding MigrateCommand, FallbackValue={x:Null}}"
                            IsVisible="{Binding CanMigrate, FallbackValue=False}"
                            FontSize="11"
                            Padding="6,2"
                            Margin="0,2,0,0"
                            Classes="accent" />
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
