<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:ThisIsMyPC.App.ViewModels">

    <!-- Multi-choice setting row: label and (i) on top, combo full-width below.
         DataContext: ShellChoiceSettingViewModel. A pending selection tints the
         card with the Modify color (a value change has no enable/disable
         direction). The label sits above the combo rather than beside it, so a
         long label and a long selected value both show in full at the default
         window size; a horizontal split cannot fit both in one column and one
         or the other was truncating (Sam, 2026-09-04). The label wraps instead
         of trimming. -->
    <DataTemplate x:Key="ChoiceSettingRowTemplate" DataType="vm:ShellChoiceSettingViewModel">
        <Border Padding="14,10"
                Margin="0,2"
                CornerRadius="6"
                Classes="card"
                IsVisible="{Binding IsSearchVisible}"
                Classes.pending-modify="{Binding HasPendingChange}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Grid.Column="1"
                            Classes="info-icon"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Description}"
                            IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="info-icon-glyph" />
                    </Border>
                </Grid>

                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:ShellChoiceOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
