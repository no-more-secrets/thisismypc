#!/bin/sh
# Keeps AGENTS.md and GEMINI.md in parity with CLAUDE.md on every commit that
# touches any of the three. Enable once per clone:
#   git config core.hooksPath tools/git-hooks
# (tools/install-git-hooks.ps1 does the same.)

staged=$(git diff --cached --name-only --diff-filter=ACMR)
case "$staged" in
  *CLAUDE.md*|*AGENTS.md*|*GEMINI.md*) ;;
  *) exit 0 ;;
esac

if command -v pwsh >/dev/null 2>&1; then
  ps=pwsh
else
  ps=powershell.exe
fi

"$ps" -NoProfile -ExecutionPolicy Bypass -File tools/sync-agent-guides.ps1 || exit 1
git add AGENTS.md GEMINI.md
